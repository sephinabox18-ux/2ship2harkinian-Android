+    // Pages turn with Z (left) / R (right); press the shorter way round until we arrive.
+    private int currentPage = -1;
+
+    private void goToPage(int target) {
+        if (currentPage < 0 || target == currentPage) return;
+        pageTarget = target;
+        pageSwitchUntil = System.currentTimeMillis() + 4000;
+        stepPage();
+    }
+
+    private void stepPage() {
+        if (pageTarget < 0 || currentPage < 0) return;
+        if (pageTarget == currentPage || System.currentTimeMillis() > pageSwitchUntil) {
+            pageTarget = -1;
+            return;
+        }
+        int right = (pageTarget - currentPage + 4) % 4;
+        tapN64(right <= 2 ? N64_R : N64_Z);
+        handler.postDelayed(this::stepPage, 450);
+    }
