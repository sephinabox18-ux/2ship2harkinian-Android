+    // ------------------------------------------------------------------ layout
+    private void layoutAll() {
+        int w = root.getWidth(), h = root.getHeight();
+        if (w == 0 || h == 0) return;
+
+        FrameLayout.LayoutParams sz = (FrameLayout.LayoutParams) stickZone.getLayoutParams();
+        sz.width = (int) (w * 0.45f);
+        stickZone.setLayoutParams(sz);
+
+        for (Ctl c : ctls) {
+            if (c.kind == KIND_PANEL) {
+                int pw = dp(c.size);
+                FrameLayout.LayoutParams lp = new FrameLayout.LayoutParams(pw, ViewGroup.LayoutParams.WRAP_CONTENT);
+                lp.leftMargin = (int) (c.x * w - pw / 2f);
+                lp.topMargin = (int) (c.y * h);
+                c.view.setLayoutParams(lp);
+                float k = c.size / 360f;
+                questWhere.setTextSize(TypedValue.COMPLEX_UNIT_SP, 12 * k);
+                questTitle.setTextSize(TypedValue.COMPLEX_UNIT_SP, 17 * k);
+                questText.setTextSize(TypedValue.COMPLEX_UNIT_SP, 13 * k);
+                if (editing) c.view.setAlpha(c.hidden ? 0.35f : 1f);
+                continue;
+            }
+            int px = dp(c.size);
+            int pw = c.kind == KIND_SKIP ? (int) (px * 2.2f) : px;
+            FrameLayout.LayoutParams lp = new FrameLayout.LayoutParams(pw, px);
+            lp.leftMargin = (int) (c.x * w - pw / 2f);
+            lp.topMargin = (int) (c.y * h - px / 2f);
+            c.view.setLayoutParams(lp);
+            float ratio = c.kind == KIND_SKIP ? 0.30f
+                    : (c.sub.isEmpty() ? (c.label.length() > 3 ? 0.22f : (c.style == STYLE_C ? 0.36f : 0.42f)) : 0.24f);
+            c.text.setTextSize(TypedValue.COMPLEX_UNIT_PX, px * ratio);
+            if (c.kind != KIND_SKIP) {
+                boolean show = !c.hidden || editing;
+                c.view.setVisibility(show ? View.VISIBLE : View.GONE);
+            }
+            if (editing) c.view.setAlpha(c.hidden ? 0.25f : 1f);
+        }
+    }
+
+    private void loadCtl(Ctl c) {
+        String s = prefs.getString("ctl_" + c.id, null);
+        c.x = c.defX; c.y = c.defY; c.size = c.defSize; c.hidden = c.defHidden;
+        if (s == null) return;
+        try {
+            String[] p = s.split(",");
+            c.x = Float.parseFloat(p[0]);
+            c.y = Float.parseFloat(p[1]);
+            c.size = Float.parseFloat(p[2]);
+            c.hidden = p[3].equals("1");
+        } catch (Exception ignored) {
+        }
+    }
+
+    private void saveAll() {
+        SharedPreferences.Editor e = prefs.edit();
+        for (Ctl c : ctls) {
+            e.putString("ctl_" + c.id, c.x + "," + c.y + "," + c.size + "," + (c.hidden ? "1" : "0"));
+        }
+        e.putFloat("opacity", opacity);
+        e.apply();
+    }
+
+    private void resetLayout() {
+        for (Ctl c : ctls) {
+            c.x = c.defX; c.y = c.defY; c.size = c.defSize; c.hidden = c.defHidden;
+        }
+        layoutAll();
+    }
+
+    private void setOpacity(float o) {
+        opacity = Math.max(0.2f, Math.min(1f, o));
+        updateOpacityLabel();
+    }
+
+    private void updateOpacityLabel() {
+        if (opacityLabel != null) opacityLabel.setText(Math.round(opacity * 100) + "%");
+    }
+
+    private void setEditing(boolean on) {
+        editing = on;
+        editBar.setVisibility(on ? View.VISIBLE : View.GONE);
+        tray.setVisibility(View.GONE);
+        if (on) {
+            controlsHidden = false;
+            releaseAll();
+            for (Ctl c : ctls) c.view.setVisibility(View.VISIBLE);
+        } else {
+            saveAll();
+            for (Ctl c : ctls) c.view.setAlpha(1f);
+        }
+        layoutAll();
+        touched();
+    }
+
+    // ------------------------------------------------------------------ input
+    private void tapN64(int mask) {
+        act.nativeMmSetN64Button(mask, true);
+        handler.postDelayed(() -> act.nativeMmSetN64Button(mask, false), 120);
+    }
+
+    private void releaseAll() {
+        for (Ctl c : ctls) {
+            if (c.kind == KIND_N64) act.nativeMmSetN64Button(c.value, false);
+        }
+        act.setAxis(ControllerButtons.AXIS_LX, (short) 0);
+        act.setAxis(ControllerButtons.AXIS_LY, (short) 0);
+        act.setAxis(ControllerButtons.AXIS_RX, (short) 0);
+        act.setAxis(ControllerButtons.AXIS_RY, (short) 0);
+    }
+
+    private void setPressed(Ctl c, boolean pressed) {
+        c.view.animate().scaleX(pressed ? 0.92f : 1f).scaleY(pressed ? 0.92f : 1f).setDuration(60).start();
+    }
+
+    private boolean sprintUiOn = false;
+
+    private void setSprintUi(boolean on) {
+        if (on == sprintUiOn || sprintCtl.view == null) return;
+        sprintUiOn = on;
+        sprintCtl.view.setBackground(styleFor(STYLE_PLAIN, on));
+    }
+
+    private boolean onCtlTouch(Ctl c, MotionEvent e) {
+        touched();
+        if (editing) return onCtlEdit(c, e);
+        if (controlsHidden && c.kind != KIND_TRAY) return false;
+
+        switch (e.getActionMasked()) {
+            case MotionEvent.ACTION_DOWN:
+                setPressed(c, true);
+                c.view.performHapticFeedback(HapticFeedbackConstants.KEYBOARD_TAP);
+                switch (c.kind) {
+                    case KIND_N64: act.nativeMmSetN64Button(c.value, true); break;
+                    case KIND_ACTION:
+                    case KIND_SKIP: act.nativeMmAction(c.value); break;
+                    case KIND_TRAY: tray.setVisibility(tray.getVisibility() == View.VISIBLE ? View.GONE : View.VISIBLE); break;
+                }
+                return true;
+            case MotionEvent.ACTION_UP:
+            case MotionEvent.ACTION_CANCEL:
+                setPressed(c, false);
+                if (c.kind == KIND_N64) act.nativeMmSetN64Button(c.value, false);
+                return true;
+        }
+        return true;
+    }
+
+    private long lastEditTap = 0;
+
+    private boolean onCtlEdit(Ctl c, MotionEvent e) {
+        int w = root.getWidth(), h = root.getHeight();
+        float anchorY = c.kind == KIND_PANEL ? c.y * h : c.y * h;
+        switch (e.getActionMasked()) {
+            case MotionEvent.ACTION_DOWN: {
+                long now = System.currentTimeMillis();
+                if (now - lastEditTap < 300) {
+                    c.hidden = !c.hidden;
+                    layoutAll();
+                }
+                lastEditTap = now;
+                c.dragDx = e.getRawX() - c.x * w;
+                c.dragDy = e.getRawY() - anchorY;
+                return true;
+            }
+            case MotionEvent.ACTION_POINTER_DOWN:
+                if (e.getPointerCount() == 2) {
+                    c.pinchStartDist = spacing(e);
+                    c.pinchStartSize = c.size;
+                }
+                return true;
+            case MotionEvent.ACTION_MOVE:
+                if (e.getPointerCount() >= 2 && c.pinchStartDist > 0) {
+                    float scale = spacing(e) / c.pinchStartDist;
+                    float min = c.kind == KIND_PANEL ? 220f : 36f, max = c.kind == KIND_PANEL ? 640f : 160f;
+                    c.size = Math.max(min, Math.min(max, c.pinchStartSize * scale));
+                } else if (e.getPointerCount() == 1) {
+                    c.x = clamp((e.getRawX() - c.dragDx) / w);
+                    c.y = clamp((e.getRawY() - c.dragDy) / h);
+                }
+                layoutAll();
+                return true;
+            case MotionEvent.ACTION_POINTER_UP:
+                c.pinchStartDist = 0;
+                return true;
+        }
+        return true;
+    }
+
+    private static float spacing(MotionEvent e) {
+        float dx = e.getX(0) - e.getX(1), dy = e.getY(0) - e.getY(1);
+        return (float) Math.sqrt(dx * dx + dy * dy);
+    }
+
+    private static float clamp(float v) {
+        return Math.max(0.0f, Math.min(0.98f, v));
+    }
+
+    // Floating movement stick. Double-tap toggles sprint.
+    //  - the stick centre is kept away from the screen edges, so you can always push fully down/left
+    //  - if your thumb slides past the edge of the stick, the stick follows it (no need to come back)
+    //  - a small dead zone stops tiny thumb wobbles from moving Link
+    private static final float STICK_RADIUS_DP = 46f;
+    private static final float STICK_DEADZONE = 0.10f;
+
+    private void clampStickOrigin() {
+        float r = dp(STICK_RADIUS_DP) + dp(14);
+        stickX0 = Math.max(r, Math.min(root.getWidth() - r, stickX0));
+        stickY0 = Math.max(r, Math.min(root.getHeight() - r, stickY0));
+    }
+
+    private boolean onStickTouch(View v, MotionEvent e) {
+        touched();
+        if (editing || controlsHidden) return false;
+        int idx = e.getActionIndex();
+        switch (e.getActionMasked()) {
+            case MotionEvent.ACTION_DOWN:
+            case MotionEvent.ACTION_POINTER_DOWN:
+                if (stickPointer == -1) {
+                    stickPointer = e.getPointerId(idx);
+                    stickX0 = e.getX(idx);
+                    stickY0 = e.getY(idx);
+                    clampStickOrigin();
+                    long now = System.currentTimeMillis();
+                    if (now - lastStickDown < 300) act.nativeMmAction(ACT_SPRINT);
+                    lastStickDown = now;
+                    updateStick(e.getX(idx), e.getY(idx));
+                    if (tray.getVisibility() == View.VISIBLE) tray.setVisibility(View.GONE);
+                }
+                return true;
+            case MotionEvent.ACTION_MOVE: {
+                int p = e.findPointerIndex(stickPointer);
+                if (p >= 0) updateStick(e.getX(p), e.getY(p));
+                return true;
+            }
+            case MotionEvent.ACTION_UP:
+            case MotionEvent.ACTION_POINTER_UP:
+            case MotionEvent.ACTION_CANCEL:
+                if (e.getActionMasked() == MotionEvent.ACTION_CANCEL || e.getPointerId(idx) == stickPointer) {
+                    stickPointer = -1;
+                    act.setAxis(ControllerButtons.AXIS_LX, (short) 0);
+                    act.setAxis(ControllerButtons.AXIS_LY, (short) 0);
+                    stickBase.setVisibility(View.GONE);
+                    stickKnob.setVisibility(View.GONE);
+                }
+                return true;
+        }
+        return true;
+    }
+
+    private void updateStick(float tx, float ty) {
+        float max = dp(STICK_RADIUS_DP);
+        float dx = tx - stickX0, dy = ty - stickY0;
+        float d = (float) Math.sqrt(dx * dx + dy * dy);
+        if (d > max) {
+            // drag the stick along with the thumb
+            stickX0 = tx - dx / d * max;
+            stickY0 = ty - dy / d * max;
+            clampStickOrigin();
+            dx = tx - stickX0;
+            dy = ty - stickY0;
+            d = (float) Math.sqrt(dx * dx + dy * dy);
+            if (d > max) { dx = dx / d * max; dy = dy / d * max; d = max; }
+        }
+        float mag = d / max;
+        float out = mag < STICK_DEADZONE ? 0f : (mag - STICK_DEADZONE) / (1f - STICK_DEADZONE);
+        float nx = d > 0 ? dx / d * out : 0, ny = d > 0 ? dy / d * out : 0;
+        act.setAxis(ControllerButtons.AXIS_LX, (short) (nx * Short.MAX_VALUE));
+        act.setAxis(ControllerButtons.AXIS_LY, (short) (ny * Short.MAX_VALUE));
+        placeStick(stickX0, stickY0, stickX0 + dx, stickY0 + dy);
+    }
+
+    private void placeStick(float bx, float by, float kx, float ky) {
+        stickBase.setVisibility(View.VISIBLE);
+        stickKnob.setVisibility(View.VISIBLE);
+        stickBase.setAlpha(opacity * 0.8f);
+        stickKnob.setAlpha(opacity);
+        stickBase.setX(bx - dp(STICK_RADIUS_DP + 10));
+        stickBase.setY(by - dp(STICK_RADIUS_DP + 10));
+        stickKnob.setX(kx - dp(28));
+        stickKnob.setY(ky - dp(28));
+    }
+
+    // Camera: drag on the right side.
+    //  Swipe mode (default): the camera follows how fast your finger moves, like modern touch games,
+    //  and stops as soon as your finger stops. Stick mode: holding away from where you touched keeps turning.
+    private final Runnable camDecay = new Runnable() {
+        @Override
+        public void run() {
+            if (camPointer == -1 || !swipeCamera) return;
+            if (System.currentTimeMillis() - lastCamMoveWall > 35) {
+                camVx *= 0.5f;
+                camVy *= 0.5f;
+                if (Math.abs(camVx) < 0.02f) camVx = 0;
+                if (Math.abs(camVy) < 0.02f) camVy = 0;
+                sendCam(camVx, camVy);
+            }
+            handler.postDelayed(this, 16);
+        }
+    };
+
+    // After each real swipe, nudge the "typical swipe speed" toward what you just did.
+    private void learnSwipe() {
+        if (gesturePeak < 150f) return; // taps and tiny nudges don't count
+        float peak = Math.max(300f, Math.min(2500f, gesturePeak));
+        typicalSwipe = typicalSwipe * 0.85f + peak * 0.15f;
+        prefs.edit().putFloat("typicalSwipe", typicalSwipe).apply();
+    }
+
+    private void sendCam(float nx, float ny) {
+        nx = Math.max(-1f, Math.min(1f, nx));
+        ny = Math.max(-1f, Math.min(1f, ny));
+        act.setAxis(ControllerButtons.AXIS_RX, (short) (nx * Short.MAX_VALUE));
+        act.setAxis(ControllerButtons.AXIS_RY, (short) (ny * Short.MAX_VALUE));
+    }
+
+    private boolean onCamTouch(View v, MotionEvent e) {
+        touched();
+        if (editing || controlsHidden) return false;
+        int idx = e.getActionIndex();
+        switch (e.getActionMasked()) {
+            case MotionEvent.ACTION_DOWN:
+            case MotionEvent.ACTION_POINTER_DOWN:
+                if (camPointer == -1 && e.getX(idx) > root.getWidth() * 0.45f) {
+                    camPointer = e.getPointerId(idx);
+                    camX0 = camLastX = e.getX(idx);
+                    camY0 = camLastY = e.getY(idx);
+                    camLastT = e.getEventTime();
+                    lastCamMoveWall = System.currentTimeMillis();
+                    camVx = camVy = 0;
+                    gesturePeak = 0;
+                    if (tray.getVisibility() == View.VISIBLE) tray.setVisibility(View.GONE);
+                    if (swipeCamera) handler.post(camDecay);
+                }
+                return true;
+            case MotionEvent.ACTION_MOVE: {
+                int p = e.findPointerIndex(camPointer);
+                if (p < 0) return true;
+                if (swipeCamera) {
+                    // Use every touch sample the phone reported since the last event (high sampling rate
+                    // phones batch several per frame), so speed is measured accurately.
+                    float sumDx = 0, sumDy = 0;
+                    long t0 = camLastT;
+                    float px = camLastX, py = camLastY;
+                    for (int hIdx = 0; hIdx < e.getHistorySize(); hIdx++) {
+                        float hx = e.getHistoricalX(p, hIdx), hy = e.getHistoricalY(p, hIdx);
+                        sumDx += hx - px;
+                        sumDy += hy - py;
+                        px = hx;
+                        py = hy;
+                    }
+                    sumDx += e.getX(p) - px;
+                    sumDy += e.getY(p) - py;
+                    long now = e.getEventTime();
+                    float dt = Math.max(4, now - t0) / 1000f;
+                    float density = dp(100) / 100f;
+                    float vx = sumDx / dt / density, vy = sumDy / dt / density; // dp per second
+
+                    float speed = (float) Math.sqrt(vx * vx + vy * vy);
+                    if (speed > gesturePeak) gesturePeak = speed;
+
+                    // Ignore tiny wobbles, then a gentle curve: slow swipes = fine aim, fast swipes = big turns.
+                    float tx = 0, ty = 0;
+                    if (speed > 25f) {
+                        float norm = Math.min(1.6f, speed / (typicalSwipe * 1.1f));
+                        float curved = (float) Math.pow(norm, 1.35);
+                        tx = vx / speed * curved;
+                        ty = vy / speed * curved * 0.85f;
+                    }
+                    camVx = camVx * 0.55f + tx * 0.45f;
+                    camVy = camVy * 0.55f + ty * 0.45f;
+                    camLastX = e.getX(p);
+                    camLastY = e.getY(p);
+                    camLastT = now;
+                    lastCamMoveWall = System.currentTimeMillis();
+                    sendCam(camVx, camVy);
+                } else {
+                    float dx = e.getX(p) - camX0, dy = e.getY(p) - camY0;
+                    float max = dp(51), d = (float) Math.sqrt(dx * dx + dy * dy);
+                    if (d > max) { dx = dx / d * max; dy = dy / d * max; }
+                    sendCam(dx / max, dy / max);
+                }
+                return true;
+            }
+            case MotionEvent.ACTION_UP:
+            case MotionEvent.ACTION_POINTER_UP:
+            case MotionEvent.ACTION_CANCEL:
+                if (e.getActionMasked() == MotionEvent.ACTION_CANCEL || e.getPointerId(idx) == camPointer) {
+                    camPointer = -1;
+                    handler.removeCallbacks(camDecay);
+                    learnSwipe();
+                    camVx = camVy = 0;
+                    sendCam(0, 0);
+                }
+                return true;
+        }
+        return true;
+    }
+
+    private int dp(float v) {
+        return Math.round(TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, v, act.getResources().getDisplayMetrics()));
+    }
+}
