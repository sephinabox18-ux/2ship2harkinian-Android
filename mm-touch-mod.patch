+static void SyncVisited() {
+    s32 file = gSaveContext.fileNum;
+    if (file < 0 || file > 8) return;
+    u8* visited = MMQuest_VisitedArray();
+    if (file != sVisitedFile) {
+        sVisitedFile = file;
+        memset(visited, 0, 0x71);
+        std::ifstream f(VisitedPath(file), std::ios::binary);
+        if (f) f.read((char*)visited, 0x71);
+        MMQuest_TakeVisitedDirty();
