+const char* MMQuest_Chapter(s32 step);
+void MMQuest_Progress(s32 step, s32* index, s32* count);
+void MMQuest_Update(PlayState* play, s32 trailOn);
+u8* MMQuest_VisitedArray(void);
+s32 MMQuest_GetTarget(Vec3f* out);
+#include "z64skin_matrix.h"
+s32 MMQuest_TakeVisitedDirty(void);
+}
+
+#ifdef __ANDROID__
+#include <jni.h>
+#endif
+
+#define PAUSE_ITEM_NONE 999 // from z_kaleido_scope.h
+#define CVAR_SPEED_MODE "gCheats.SpeedModifier.Mode"
+#define CVAR_SPEED_VALUE "gCheats.SpeedModifier.Value"
+#define CVAR_JUMP_HEIGHT "gMMTouch.JumpHeight"
+#define CVAR_LONG_DIVES "gMMTouch.LongDives"
+#define CVAR_PRESET_VERSION "gMMTouch.PresetVersion"
+
+enum {
+    ACT_JUMP = 1, ACT_SPRINT = 2, ACT_QUICKSAVE = 3, ACT_QUICKLOAD = 4, ACT_MAP = 5, ACT_SKIP = 6, ACT_TRAIL = 7,
+    ACT_SPRINT_ON = 8, ACT_SPRINT_OFF = 9, // auto-run
+};
+
+// State bits reported to the overlay
+enum {
+    ST_CAN_SKIP = 1 << 0, ST_OCARINA = 1 << 1, ST_SHOW_QUEST = 1 << 2, ST_SPRINT = 1 << 3, ST_TRAIL = 1 << 4,
+    ST_SKIPPING = 1 << 5, ST_PAUSED = 1 << 6, ST_PAUSE_GRID = 1 << 7, // item or mask page ready for touch
+    ST_GAMEPLAY = 1 << 8, // normal play (not paused, not in a cutscene): show the HUD bar
+    ST_AIMING = 1 << 9,   // first-person aiming (bow, hookshot...): the overlay switches to fine aim
+    ST_TEXT = 1 << 10,    // a conversation is on screen (skip button says "Skip text")
+};
+
+// ---------------------------------------------------------------- item icons + C buttons + touch pause grid
+static std::mutex sIconMutex;
+static std::map<int, std::vector<int>> sIconCache; // item id -> { w, h, argb... }
+static std::set<int> sIconRequests;
+static std::atomic<int> sCItems[9] = { 0xFF, 0xFF, 0xFF, -1, -1, -1, 0, 0, 0 }; // items, ammo (-1 none), full
+static std::atomic<int> sPausePage{ -1 };
+static std::atomic<int> sPauseCursor{ -1 };
+static std::atomic<int> sPauseSelect{ -1 };
+static int sPauseItems[24];
+static std::mutex sPauseMutex;
+extern "C" volatile s32 gMmTouchOverlayActive;
+static std::atomic<int> sTouchOnlyPause{ 1 }; // hide the original pause graphics on the Items/Masks pages
+static std::atomic<int> sModernHud{ -1 };     // requested HUD style (1 modern bar, 0 original), applied on game thread
+static std::atomic<int> sHud[9];
+static std::atomic<int> sMinimapReq{ 0 };   // set when the overlay sends a new minimap placement
+static std::atomic<int> sMinimapVals[4];    // visible, x, y (game units from the left/top), scale x100              // health, max, magic, maxMagic, rupees, maxRupees, day, time, flags
+
+// Called from KaleidoScope_Draw: true = skip drawing the original pause pages (the touch panel replaces them)
+extern "C" s32 MMMod_HidePauseGraphics(PlayState* play) {
+    PauseContext* pauseCtx = &play->pauseCtx;
+    if (!sTouchOnlyPause.load() || !gMmTouchOverlayActive) return false;
+    if (IS_PAUSE_STATE_GAMEOVER(pauseCtx) || (pauseCtx->debugEditor != DEBUG_EDITOR_NONE)) return false;
+    // Opening + main menu only: save prompts and anything else keep their original screens.
+    return (pauseCtx->state >= PAUSE_STATE_OPENING_0) && (pauseCtx->state <= PAUSE_STATE_MAIN) &&
+           (pauseCtx->mainState != PAUSE_MAIN_STATE_SONG_PLAYBACK) && !pauseCtx->itemDescriptionOn;
+}
+
+static void LoadIcon(int item) {
+    std::vector<int> out;
+    if ((item >= 0) && (item < (int)(sizeof(gItemIcons) / sizeof(gItemIcons[0]))) && (gItemIcons[item] != nullptr)) {
+        // Check the resource really is a texture before using it as one.
+        auto res = ResourceLoad((const char*)gItemIcons[item]);
+        std::shared_ptr<Fast::Texture> tex = nullptr;
+        if ((res != nullptr) && (res->GetInitData() != nullptr) &&
+            (res->GetInitData()->Type == (uint32_t)Fast::ResourceType::Texture)) {
+            tex = std::static_pointer_cast<Fast::Texture>(res);
+        }
+        if (tex != nullptr && tex->ImageData != nullptr && tex->Width > 0 && tex->Height > 0 &&
+            tex->Width <= 128 && tex->Height <= 128 && tex->Type == Fast::TextureType::RGBA32bpp &&
+            !(tex->Flags & TEX_FLAG_LOAD_AS_IMG) && (tex->ImageDataSize >= (uint32_t)tex->Width * tex->Height * 4)) {
+            out.reserve(2 + tex->Width * tex->Height);
+            out.push_back(tex->Width);
+            out.push_back(tex->Height);
+            for (int i = 0; i < tex->Width * tex->Height; i++) {
+                uint8_t* px = &tex->ImageData[i * 4];
+                out.push_back((int)(((uint32_t)px[3] << 24) | ((uint32_t)px[0] << 16) | ((uint32_t)px[1] << 8) | px[2]));
+            }
+        }
+    }
+    std::lock_guard<std::mutex> lock(sIconMutex);
+    sIconCache[item] = out; // empty = no icon available
+}
+
+static void ServiceIcons() {
+    std::set<int> todo;
+    {
+        std::lock_guard<std::mutex> lock(sIconMutex);
+        todo.swap(sIconRequests);
+    }
+    for (int item : todo) LoadIcon(item);
+}
+
+// Ammo shown on a C button (like the game's own little numbers); -1 = item has no count
+static void AmmoFor(u8 item, s32* ammo, s32* full) {
+    *ammo = -1;
+    *full = 0;
+    s32 cap = 0;
+    switch (item) {
+        case ITEM_BOW: case ITEM_BOW_FIRE: case ITEM_BOW_ICE: case ITEM_BOW_LIGHT:
+            *ammo = AMMO(ITEM_BOW); cap = CUR_CAPACITY(UPG_QUIVER); break;
+        case ITEM_BOMB: *ammo = AMMO(ITEM_BOMB); cap = CUR_CAPACITY(UPG_BOMB_BAG); break;
+        case ITEM_BOMBCHU: *ammo = AMMO(ITEM_BOMBCHU); cap = CUR_CAPACITY(UPG_BOMB_BAG); break;
+        case ITEM_DEKU_STICK: *ammo = AMMO(ITEM_DEKU_STICK); cap = CUR_CAPACITY(UPG_DEKU_STICKS); break;
+        case ITEM_DEKU_NUT: *ammo = AMMO(ITEM_DEKU_NUT); cap = CUR_CAPACITY(UPG_DEKU_NUTS); break;
+        case ITEM_MAGIC_BEANS: *ammo = AMMO(ITEM_MAGIC_BEANS); cap = 20; break;
+        case ITEM_POWDER_KEG: *ammo = AMMO(ITEM_POWDER_KEG); cap = 1; break;
+        default: return;
+    }
+    *full = (cap > 0) && (*ammo >= cap);
+}
+
+// Quest page + map page data for the touch pause menu
+static std::atomic<int> sPauseAnyPage{ -1 };
+static std::atomic<int> sPauseInfo[24];
+
+static void UpdatePauseInfo(PlayState* play) {
+    u32 quest = gSaveContext.save.saveInfo.inventory.questItems;
+    sPauseInfo[0] = (int)(quest & 0x0FFFFFFF);                 // quest item bits (remains, songs, notebook...)
+    sPauseInfo[1] = (int)GET_QUEST_HEART_PIECE_COUNT;           // heart pieces 0-3
+    sPauseInfo[2] = GET_CUR_EQUIP_VALUE(EQUIP_TYPE_SWORD);      // 0 none, 1 kokiri, 2 razor, 3 gilded
+    sPauseInfo[3] = GET_CUR_EQUIP_VALUE(EQUIP_TYPE_SHIELD);     // 0 none, 1 hero, 2 mirror
+    sPauseInfo[4] = CUR_UPG_VALUE(UPG_QUIVER);
+    sPauseInfo[5] = CUR_UPG_VALUE(UPG_BOMB_BAG);
+    sPauseInfo[6] = CUR_UPG_VALUE(UPG_WALLET);
+    sPauseInfo[7] = gSaveContext.save.saveInfo.playerData.owlActivationFlags;
+    bool inDungeon = Map_CurRoomHasMapI(play) && (gSaveContext.dungeonSceneSharedIndex < 4);
+    s32 d = inDungeon ? gSaveContext.dungeonSceneSharedIndex : -1;
+    sPauseInfo[8] = d;
+    if (d >= 0) {
+        sPauseInfo[9] = CHECK_DUNGEON_ITEM(DUNGEON_MAP, d) ? 1 : 0;
+        sPauseInfo[10] = CHECK_DUNGEON_ITEM(DUNGEON_COMPASS, d) ? 1 : 0;
+        sPauseInfo[11] = CHECK_DUNGEON_ITEM(DUNGEON_BOSS_KEY, d) ? 1 : 0;
+        sPauseInfo[12] = DUNGEON_KEY_COUNT(d) > 0 ? DUNGEON_KEY_COUNT(d) : 0;
+        sPauseInfo[13] = gSaveContext.save.saveInfo.inventory.strayFairies[d];
+    }
+    sPauseInfo[14] = gSaveContext.save.saveInfo.playerData.isDoubleMagicAcquired;
+}
+
+static void UpdateItemsAndPause(PlayState* play) {
+    static const s32 slots[3] = { EQUIP_SLOT_C_LEFT, EQUIP_SLOT_C_DOWN, EQUIP_SLOT_C_RIGHT };
+    for (s32 i = 0; i < 3; i++) {
+        u8 item = GET_CUR_FORM_BTN_ITEM(slots[i]);
+        s32 ammo, full;
+        AmmoFor(item, &ammo, &full);
+        sCItems[i] = item;
+        sCItems[3 + i] = ammo;
+        sCItems[6 + i] = full;
+    }
+
+    PauseContext* pauseCtx = &play->pauseCtx;
+    sPauseAnyPage = (IS_PAUSED(pauseCtx) && (pauseCtx->state == PAUSE_STATE_MAIN)) ? pauseCtx->pageIndex : -1;
+    UpdatePauseInfo(play);
+    bool gridReady = IS_PAUSED(pauseCtx) && (pauseCtx->state == PAUSE_STATE_MAIN) &&
+                     (pauseCtx->mainState == PAUSE_MAIN_STATE_IDLE) && !pauseCtx->itemDescriptionOn &&
+                     ((pauseCtx->pageIndex == PAUSE_ITEM) || (pauseCtx->pageIndex == PAUSE_MASK));
+    if (!gridReady) {
+        sPausePage = -1;
+        sPauseSelect = -1;
+        return;
+    }
+    int page = pauseCtx->pageIndex;
+    int base = (page == PAUSE_MASK) ? ITEM_NUM_SLOTS : 0;
+
+    // Touch selection: move the game's own cursor to the tapped slot, so its equip logic does the rest.
+    int sel = sPauseSelect.exchange(-1);
+    if ((sel >= 0) && (sel < ITEM_NUM_SLOTS)) {
+        u8 item = gSaveContext.save.saveInfo.inventory.items[base + sel];
+        pauseCtx->cursorSpecialPos = 0;
+        pauseCtx->cursorPoint[page] = sel;
+        pauseCtx->cursorXIndex[page] = sel % ITEM_GRID_COLS;
+        pauseCtx->cursorYIndex[page] = sel / ITEM_GRID_COLS;
+        pauseCtx->cursorItem[page] = (item == ITEM_NONE) ? PAUSE_ITEM_NONE : item;
+        pauseCtx->cursorSlot[page] = sel + base;
+        Audio_PlaySfx(NA_SE_SY_CURSOR);
+    }
+
+    {
+        std::lock_guard<std::mutex> lock(sPauseMutex);
+        for (int i = 0; i < ITEM_NUM_SLOTS; i++) {
+            sPauseItems[i] = gSaveContext.save.saveInfo.inventory.items[base + i];
+        }
+    }
+    sPauseCursor = (pauseCtx->cursorSpecialPos == 0) ? pauseCtx->cursorPoint[page] : -1;
+    sPausePage = page;
+}
+
+// ---------------------------------------------------------------- shared state
+extern "C" {
