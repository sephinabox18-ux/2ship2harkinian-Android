+    // Send the dungeon map/compass position to the game (2 Ship's HUD editor values, in game units).
+    private void pushMinimap() {
+        int w = root.getWidth(), h = root.getHeight();
+        if (w == 0 || h == 0) return;
+        float px = dp(minimapCtl.size);
+        float right = minimapCtl.x * w + px / 2f, bottom = minimapCtl.y * h + px / 2f;
+        int gx = Math.round(right / h * 240f);
+        int gy = Math.round(bottom / h * 240f);
+        act.nativeMmSetMinimap(minimapCtl.hidden ? 0 : 1, gx, gy, Math.round(minimapCtl.size / 80f * 100f));
+    }
