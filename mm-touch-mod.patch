+
+    private void setEditing(boolean on) {
+        editing = on;
+        selectedCtl = null;
+        editBar.setVisibility(on ? View.VISIBLE : View.GONE);
+        tray.setVisibility(View.GONE);
+        if (on) {
+            controlsHidden = false;
+            releaseAll();
+            for (Ctl c : ctls) {
+                if (c.kind != KIND_STICK && c.kind != KIND_HUD && (c.kind != KIND_MAPVIEW || ourMap)) c.view.setVisibility(View.VISIBLE);
+            }
+        } else {
+            saveAll();
+            for (Ctl c : ctls) c.view.setAlpha(1f);
+            pushMinimap();
