+    private void confirmReset() {
+        new android.app.AlertDialog.Builder(act)
+                .setTitle("Reset layout?")
+                .setMessage("ARE YOU SURE? Every button, panel and colour goes back to its default.")
+                .setPositiveButton("Reset", (d, w) -> resetLayout())
+                .setNegativeButton("Cancel", null)
+                .show();
+    }
+
+    private void resetLayout() {
+        for (Ctl c : ctls) {
+            c.x = c.defX; c.y = c.defY; c.size = c.defSize; c.hidden = c.defHidden;
+            if (c.theme != Ornate.THEME_DEFAULT && colourable(c)) {
+                c.theme = Ornate.THEME_DEFAULT;
+                c.view.setBackground(styleFor(c, false));
+            }
+        }
+        layoutAll();
+    }
+
+    private void setOpacity(float o) {
+        opacity = Math.max(0.2f, Math.min(1f, o));
+        updateOpacityLabel();
+    }
