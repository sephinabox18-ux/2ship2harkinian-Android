+// ---------------------------------------------------------------- quick save / quick load
+// Quick save stores everything about the game plus Link's exact spot, in memory and in a file on the phone,
+// so quick load works after restarting the app too (even from the title screen / file select).
+#define QS_MAGIC 0x4D4D5153 // "MMQS"
+#define QS_VERSION 2
+
+typedef struct {
+    u32 magic;
+    u32 version;
+    u32 size;
+    s16 fileNum;
+    Save save;
+    u8 eventInf[8];
+    CycleSceneFlags cycleSceneFlags[120];
+    ShipSaveContext shipSaveContext;
+    RespawnData respawn; // exact position (entrance, room, pos, facing)
+} QuickSnapshot;
+
+static QuickSnapshot* sSnap = nullptr;
+static bool sHaveSnap = false;
+static bool sPendingLoad = false;
+
+static std::string QuickSavePath() {
+    return Ship::Context::GetPathRelativeToAppDirectory("mm_quicksave.bin");
+}
+
+static void WriteSnapshotFile() {
+    std::ofstream f(QuickSavePath(), std::ios::binary | std::ios::trunc);
+    if (f) f.write((const char*)sSnap, sizeof(QuickSnapshot));
+}
+
+static void ReadSnapshotFile() {
+    std::ifstream f(QuickSavePath(), std::ios::binary);
+    if (!f) return;
+    QuickSnapshot* tmp = new QuickSnapshot();
+    f.read((char*)tmp, sizeof(QuickSnapshot));
+    if (f.gcount() == (std::streamsize)sizeof(QuickSnapshot) && tmp->magic == QS_MAGIC && tmp->version == QS_VERSION &&
+        tmp->size == sizeof(QuickSnapshot)) {
+        delete sSnap;
+        sSnap = tmp;
+        sHaveSnap = true;
+    } else {
+        delete tmp;
+    }
+}
+
+static bool CanQuickSave(PlayState* play) {
+    if (gSaveContext.gameMode != GAMEMODE_NORMAL) return false;
+    if (gSaveContext.fileNum == 0xFF) return false;
+    if (IS_PAUSED(&play->pauseCtx) || (play->msgCtx.msgMode != MSGMODE_NONE)) return false;
+    if ((play->transitionTrigger != TRANS_TRIGGER_OFF) || (play->transitionMode != TRANS_MODE_OFF)) return false;
+    if (Play_InCsMode(play) || (gSaveContext.save.cutsceneIndex >= 0xFFF0)) return false;
+    if (gSaveContext.minigameStatus != MINIGAME_STATUS_END) return false;
+    if ((gSaveContext.timerStates[TIMER_ID_MINIGAME_1] != TIMER_STATE_OFF) ||
+        (gSaveContext.timerStates[TIMER_ID_MINIGAME_2] != TIMER_STATE_OFF)) {
+        return false;
+    }
+    if (play->gameOverCtx.state != GAMEOVER_INACTIVE) return false;
+    Player* player = GET_PLAYER(play);
+    if ((player == nullptr) || !(player->actor.bgCheckFlags & BGCHECKFLAG_GROUND)) return false; // not mid-air
+    return true;
+}
+
+static void SaveToDisk(PlayState* play) {
+    if (!SavingEnhancements_CanSave()) return;
+    // Same steps 2 Ship's autosave uses: an owl-style save of the current area.
+    bool currentOwlSaveState = gSaveContext.save.isOwlSave;
+    gSaveContext.save.isOwlSave = true;
+    SavingEnhancements_PersistSaveEntranceInfo();
+    SavingEnhancements_AdvancePlaytime();
+    Play_SaveCycleSceneFlags(play);
+    gSaveContext.save.saveInfo.playerData.savedSceneId = play->sceneId;
+    func_8014546C(&play->sramCtx);
+    Sram_SetFlashPagesOwlSave(&play->sramCtx, gFlashOwlSaveStartPages[gSaveContext.fileNum * FLASH_SAVE_MAIN_MULTIPLIER],
+                              gFlashOwlSaveNumPages[gSaveContext.fileNum * FLASH_SAVE_MAIN_MULTIPLIER]);
+    Sram_StartWriteToFlashOwlSave(&play->sramCtx);
+    gSaveContext.save.isOwlSave = currentOwlSaveState;
+    SavingEnhancements_ClearSaveEntranceInfo();
+}
+
+static void QuickSave(PlayState* play) {
+    if (!CanQuickSave(play)) {
+        Audio_PlaySfx(NA_SE_SY_ERROR);
+        PostMessage("Can't quick save right now");
+        return;
+    }
+    Player* player = GET_PLAYER(play);
+    if (sSnap == nullptr) sSnap = new QuickSnapshot();
+    Play_SaveCycleSceneFlags(play);
+    sSnap->magic = QS_MAGIC;
+    sSnap->version = QS_VERSION;
+    sSnap->size = sizeof(QuickSnapshot);
+    sSnap->fileNum = gSaveContext.fileNum;
+    memcpy(&sSnap->save, &gSaveContext.save, sizeof(Save));
+    memcpy(sSnap->eventInf, gSaveContext.eventInf, sizeof(sSnap->eventInf));
+    memcpy(sSnap->cycleSceneFlags, gSaveContext.cycleSceneFlags, sizeof(sSnap->cycleSceneFlags));
+    memcpy(&sSnap->shipSaveContext, &gSaveContext.shipSaveContext, sizeof(ShipSaveContext));
+
+    // Link's exact spot (same data the game uses to put you back after falling off a ledge)
+    memset(&sSnap->respawn, 0, sizeof(RespawnData));
+    sSnap->respawn.entrance = gSaveContext.save.entrance;
+    sSnap->respawn.roomIndex = play->roomCtx.curRoom.num;
+    sSnap->respawn.pos = player->actor.world.pos;
+    sSnap->respawn.yaw = player->actor.shape.rot.y;
+    sSnap->respawn.playerParams = PLAYER_PARAMS(0xFF, PLAYER_START_MODE_D);
+    sSnap->respawn.tempSwitchFlags = play->actorCtx.sceneFlags.switches[2];
+    sSnap->respawn.unk_18 = play->actorCtx.sceneFlags.collectible[1];
+    sSnap->respawn.tempCollectFlags = play->actorCtx.sceneFlags.collectible[2];
+
+    sHaveSnap = true;
+    WriteSnapshotFile();
+    SaveToDisk(play);
+    Audio_PlaySfx(NA_SE_SY_DECIDE);
+    PostMessage("Quick saved");
+}
+
+static void ApplySnapshotRespawn() {
+    gSaveContext.respawn[RESPAWN_MODE_DOWN] = sSnap->respawn;
+    gSaveContext.nextTransitionType = TRANS_TYPE_FADE_BLACK_FAST;
+    gSaveContext.respawnFlag = -8; // spawn at the stored position (as 2 Ship's warp points do)
+}
+
+static void QuickLoad(PlayState* play) {
+    if (!sHaveSnap) {
+        Audio_PlaySfx(NA_SE_SY_ERROR);
+        PostMessage("No quick save yet");
+        return;
+    }
+    if ((gSaveContext.gameMode != GAMEMODE_NORMAL) || IS_PAUSED(&play->pauseCtx) ||
+        (play->transitionTrigger != TRANS_TRIGGER_OFF) || (play->transitionMode != TRANS_MODE_OFF) ||
+        (play->gameOverCtx.state != GAMEOVER_INACTIVE)) {
+        Audio_PlaySfx(NA_SE_SY_ERROR);
+        PostMessage("Can't quick load right now");
+        return;
+    }
+    sPendingLoad = true;
+    gSaveContext.nextCutsceneIndex = 0;
+    ApplySnapshotRespawn();
+    play->nextEntrance = sSnap->respawn.entrance;
+    play->transitionTrigger = TRANS_TRIGGER_START;
+    play->transitionType = TRANS_TYPE_FADE_BLACK_FAST;
+    PostMessage("Quick loading...");
+}
+
+// From the title screen / file select: load the quick save straight into the game.
+static void BootQuickLoad() {
+    if (!sHaveSnap || (gGameState == nullptr)) return;
+    gSaveContext.gameMode = GAMEMODE_NORMAL;
+    gSaveContext.fileNum = sSnap->fileNum;
+    memcpy(&gSaveContext.save, &sSnap->save, sizeof(Save));
+    memcpy(gSaveContext.eventInf, sSnap->eventInf, sizeof(sSnap->eventInf));
+    memcpy(gSaveContext.cycleSceneFlags, sSnap->cycleSceneFlags, sizeof(sSnap->cycleSceneFlags));
+    memcpy(&gSaveContext.shipSaveContext, &sSnap->shipSaveContext, sizeof(ShipSaveContext));
+    // Like a normal file load: make the game rebuild the magic meter (capacity is not part of the save),
+    // otherwise magic shows as empty and magic jars don't refill it.
+    gSaveContext.save.saveInfo.playerData.magicLevel = 0;
+    gSaveContext.magicState = MAGIC_STATE_IDLE;
+    GameInteractor_ExecuteOnSaveLoad(gSaveContext.fileNum);
+
+    // Runtime state a normal file load sets up (mirrors MapSelect_LoadGame)
+    for (s32 i = EQUIP_SLOT_B; i <= EQUIP_SLOT_A; i++) gSaveContext.buttonStatus[i] = BTN_ENABLED;
+    for (s32 i = 0; i < 4; i++) gSaveContext.shipSaveContext.dpad.status[i] = BTN_ENABLED;
+    gSaveContext.hudVisibilityForceButtonAlphasByStatus = false;
+    gSaveContext.nextHudVisibility = HUD_VISIBILITY_IDLE;
+    gSaveContext.hudVisibility = HUD_VISIBILITY_IDLE;
+    gSaveContext.hudVisibilityTimer = 0;
+    gSaveContext.save.cutsceneIndex = 0;
+    gSaveContext.nextCutsceneIndex = 0xFFEF;
+    gSaveContext.save.entrance = sSnap->respawn.entrance;
+    gSaveContext.seqId = NA_BGM_DISABLED;
+    gSaveContext.ambienceId = AMBIENCE_ID_DISABLED;
+    gSaveContext.showTitleCard = true;
+    gSaveContext.respawn[RESPAWN_MODE_GORON].entrance = 0xFF;
+    gSaveContext.respawn[RESPAWN_MODE_ZORA].entrance = 0xFF;
+    gSaveContext.respawn[RESPAWN_MODE_DEKU].entrance = 0xFF;
+    gSaveContext.respawn[RESPAWN_MODE_HUMAN].entrance = 0xFF;
+    gWeatherMode = WEATHER_MODE_CLEAR;
+    ApplySnapshotRespawn();
+
+    STOP_GAMESTATE(gGameState);
+    SET_NEXT_GAMESTATE(gGameState, Play_Init, sizeof(PlayState));
+}
+
+// Called at the start of Play_Init (z_play.c): apply a pending quick load before the area is built.
+extern "C" void MMMod_OnPlayInit(void) {
+    if (!sPendingLoad || !sHaveSnap) return;
+    sPendingLoad = false;
+    gSaveContext.fileNum = sSnap->fileNum; // the quick save may belong to a different file slot
+    memcpy(&gSaveContext.save, &sSnap->save, sizeof(Save));
+    memcpy(gSaveContext.eventInf, sSnap->eventInf, sizeof(sSnap->eventInf));
+    memcpy(gSaveContext.cycleSceneFlags, sSnap->cycleSceneFlags, sizeof(sSnap->cycleSceneFlags));
+    memcpy(&gSaveContext.shipSaveContext, &sSnap->shipSaveContext, sizeof(ShipSaveContext));
+    // Like a normal file load: make the game rebuild the magic meter (capacity is not part of the save),
+    // otherwise magic shows as empty and magic jars don't refill it.
+    gSaveContext.save.saveInfo.playerData.magicLevel = 0;
+    gSaveContext.magicState = MAGIC_STATE_IDLE;
+    gSaveContext.save.entrance = sSnap->respawn.entrance;
+    ApplySnapshotRespawn();
+}
+
+// Runs every frame in every game state (logo, title, file select, gameplay)
+static void OnGameStateUpdate() {
+    bool inGameplay = (gPlayState != nullptr) && (gSaveContext.gameMode == GAMEMODE_NORMAL);
+    if (!inGameplay && TakeRequest(ACT_QUICKLOAD)) {
+        if (sHaveSnap) {
+            BootQuickLoad();
+        } else {
+            PostMessage("No quick save yet");
+        }
+    }
+    static u32 sCrumbTimer = 0;
+    if ((++sCrumbTimer % 60) == 0) {
+        std::string st;
+        if (gPlayState != nullptr) {
+            PlayState* play = gPlayState;
+            st = "in play: scene=" + std::to_string(play->sceneId) + " room=" + std::to_string(play->roomCtx.curRoom.num) +
+                 " entrance=" + std::to_string(gSaveContext.save.entrance) +
+                 " gameMode=" + std::to_string(gSaveContext.gameMode) + " day=" + std::to_string(gSaveContext.save.day) +
+                 " time=" + std::to_string(gSaveContext.save.time) +
+                 " paused=" + std::to_string(IS_PAUSED(&play->pauseCtx)) + " page=" + std::to_string(play->pauseCtx.pageIndex) +
+                 " msgMode=" + std::to_string(play->msgCtx.msgMode) + " cs=" + std::to_string(play->csCtx.state) +
+                 " trail=" + std::to_string(sTrailOn) + " sprint=" + std::to_string(sSprintOn) +
+                 " skipping=" + std::to_string(sSkipping) + " health=" +
+                 std::to_string(gSaveContext.save.saveInfo.playerData.health) +
+                 " icons=" + std::to_string(sIconCache.size());
+        } else {
+            st = "not in gameplay (logo / title / file select)";
+        }
+        WriteCrumbs(st);
+    }
+    if (gPlayState == nullptr) sStateBits = 0; // logo / file select: no gameplay panels
+    sFrameCounter++; // keeps the overlay's "game is running" check alive outside gameplay too
+}
