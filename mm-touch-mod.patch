+            ring.setAlpha(alpha);
+            c.drawCircle(cx, cy, rr, ring);
+
+        }
+
+        @Override
+        public void setAlpha(int a) {
+            alpha = a;
+            invalidateSelf();
+        }
+
+        @Override
+        public void setColorFilter(ColorFilter cf) {
+        }
+
+        @Override
+        public int getOpacity() {
+            return PixelFormat.TRANSLUCENT;
+        }
+    }
+
+    /** Movement stick ring: dark glass, gold rim and direction arrows. */
+    static final class StickBaseDrawable extends Drawable {
