+            c.drawCircle(s * 0.5f, s * 0.52f, s * 0.3f, stroke);
+            c.drawCircle(s * 0.4f, s * 0.42f, s * 0.07f, fill);
+            c.drawCircle(s * 0.75f, s * 0.22f, s * 0.06f, fill);
+        }
+
+        // Fierce Deity beam: sword with rays
+        private void beam(Canvas c, float s) {
+            sword(c, s);
+            stroke.setStrokeWidth(s * 0.045f);
+            p.reset();
+            p.moveTo(s * 0.8f, s * 0.12f);
+            p.lineTo(s * 0.92f, s * 0.04f);
+            p.moveTo(s * 0.86f, s * 0.24f);
+            p.lineTo(s * 0.98f, s * 0.22f);
+            p.moveTo(s * 0.7f, s * 0.08f);
+            p.lineTo(s * 0.74f, s * -0.02f);
+            c.drawPath(p, stroke);
+        }
+
+        // Goron pound: a heavy downward arrow hitting the ground, with impact lines
+        private void pound(Canvas c, float s) {
+            p.reset();
+            p.moveTo(s * 0.5f, s * 0.66f);
+            p.lineTo(s * 0.72f, s * 0.42f);
+            p.lineTo(s * 0.59f, s * 0.42f);
+            p.lineTo(s * 0.59f, s * 0.14f);
+            p.lineTo(s * 0.41f, s * 0.14f);
+            p.lineTo(s * 0.41f, s * 0.42f);
+            p.lineTo(s * 0.28f, s * 0.42f);
+            p.close();
+            c.drawPath(p, fill);
+            stroke.setStrokeWidth(s * 0.06f);
+            p.reset();
+            p.moveTo(s * 0.18f, s * 0.8f);
+            p.lineTo(s * 0.82f, s * 0.8f);
+            p.moveTo(s * 0.2f, s * 0.68f);
+            p.lineTo(s * 0.12f, s * 0.6f);
+            p.moveTo(s * 0.8f, s * 0.68f);
+            p.lineTo(s * 0.88f, s * 0.6f);
+            c.drawPath(p, stroke);
+        }
+
+        // An open hand: "interact"
+        private void hand(Canvas c, float s) {
+            stroke.setStrokeWidth(s * 0.1f);
+            p.reset();
+            p.moveTo(s * 0.37f, s * 0.5f);
+            p.lineTo(s * 0.37f, s * 0.22f);
+            p.moveTo(s * 0.48f, s * 0.48f);
+            p.lineTo(s * 0.48f, s * 0.15f);
+            p.moveTo(s * 0.59f, s * 0.48f);
+            p.lineTo(s * 0.59f, s * 0.17f);
+            p.moveTo(s * 0.7f, s * 0.52f);
+            p.lineTo(s * 0.7f, s * 0.27f);
+            p.moveTo(s * 0.32f, s * 0.64f);           // thumb
+            p.lineTo(s * 0.2f, s * 0.48f);
+            c.drawPath(p, stroke);
+            RectF palm = new RectF(s * 0.31f, s * 0.42f, s * 0.76f, s * 0.84f);
+            c.drawRoundRect(palm, s * 0.14f, s * 0.14f, fill);
+        }
+
+        private void target(Canvas c, float s) {
+            stroke.setStrokeWidth(s * 0.06f);
+            c.drawCircle(s * 0.5f, s * 0.5f, s * 0.26f, stroke);
+            p.reset();
+            p.moveTo(s * 0.5f, s * 0.12f);
+            p.lineTo(s * 0.5f, s * 0.3f);
+            p.moveTo(s * 0.5f, s * 0.7f);
+            p.lineTo(s * 0.5f, s * 0.88f);
+            p.moveTo(s * 0.12f, s * 0.5f);
+            p.lineTo(s * 0.3f, s * 0.5f);
+            p.moveTo(s * 0.7f, s * 0.5f);
+            p.lineTo(s * 0.88f, s * 0.5f);
+            c.drawPath(p, stroke);
+            c.drawCircle(s * 0.5f, s * 0.5f, s * 0.05f, fill);
+        }
+
+        private void map(Canvas c, float s) {
+            p.reset();
+            p.moveTo(s * 0.16f, s * 0.28f);
+            p.lineTo(s * 0.38f, s * 0.2f);
+            p.lineTo(s * 0.62f, s * 0.28f);
+            p.lineTo(s * 0.84f, s * 0.2f);
+            p.lineTo(s * 0.84f, s * 0.74f);
+            p.lineTo(s * 0.62f, s * 0.82f);
+            p.lineTo(s * 0.38f, s * 0.74f);
+            p.lineTo(s * 0.16f, s * 0.82f);
+            p.close();
+            c.drawPath(p, fill);
+            accent.setStrokeWidth(s * 0.03f);
+            p.reset();
+            p.moveTo(s * 0.38f, s * 0.2f);
+            p.lineTo(s * 0.38f, s * 0.74f);
+            p.moveTo(s * 0.62f, s * 0.28f);
+            p.lineTo(s * 0.62f, s * 0.82f);
+            c.drawPath(p, accent);
+        }
+
+        private void dots(Canvas c, float s) {
+            for (int i = -1; i <= 1; i++) c.drawCircle(s * (0.5f + i * 0.2f), s * 0.5f, s * 0.07f, fill);
+        }
+
+        private void fairy(Canvas c, float s) {
+            Paint wing = new Paint(Paint.ANTI_ALIAS_FLAG);
+            wing.setColor(Color.argb(170, 210, 225, 255));
+            c.drawOval(new RectF(s * 0.18f, s * 0.22f, s * 0.48f, s * 0.48f), wing);
+            c.drawOval(new RectF(s * 0.52f, s * 0.22f, s * 0.82f, s * 0.48f), wing);
+            Paint glow = new Paint(Paint.ANTI_ALIAS_FLAG);
+            glow.setShader(new RadialGradient(s * 0.5f, s * 0.55f, s * 0.3f, Color.WHITE, Color.argb(0, 255, 250, 200),
+                    Shader.TileMode.CLAMP));
+            c.drawCircle(s * 0.5f, s * 0.55f, s * 0.3f, glow);
+        }
+    }
+}
diff --git a/Android/app/src/main/java/com/twoshipfork/mm/WheelView.java b/Android/app/src/main/java/com/twoshipfork/mm/WheelView.java
new file mode 100644
index 0000000..9628329
--- /dev/null
+++ b/Android/app/src/main/java/com/twoshipfork/mm/WheelView.java
@@ -0,0 +1,239 @@
+package com.twoshipfork.mm;
+
+import android.content.Context;
+import android.graphics.Bitmap;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.Paint;
+import android.graphics.RadialGradient;
+import android.graphics.RectF;
+import android.graphics.Shader;
+import android.graphics.Typeface;
+import android.util.TypedValue;
+import android.view.MotionEvent;
+import android.view.View;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Radial item / mask wheel. Items you own sit around a ring; tap one (or slide onto it), then tap one of
+ * the three C buttons in the middle to put it there. Tap outside the ring, or the X, to close.
+ */
+public class WheelView extends View {
+    interface Host {
+        Bitmap icon(int item);
+        String name(int item);
+        int[] inventory();       // 48 slots: 0-23 items, 24-47 masks (255 = empty)
+        int[] cItems();          // current C button items
+        void equip(int cSlot, int invSlot);
+        void close();
+    }
+
+    private final Host host;
+    private final Paint dim = new Paint();
+    private final Paint disc = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint ring = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint slot = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint slotSel = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint text = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint small = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint bmpPaint = new Paint(Paint.FILTER_BITMAP_FLAG);
+    private final RectF rf = new RectF();
+
+    private boolean masks = false;
+    private final List<Integer> slots = new ArrayList<>(); // inventory slot indices shown on the ring
+    private int selected = -1;                             // index into slots
+    private int[] inv = new int[48];
+    private int[] cItems = { 255, 255, 255 };
+
+    // geometry (computed in onDraw, reused for touch)
+    private float cx, cy, ringR, slotR, innerR;
+    private final float[] cBtnX = new float[3];
+    private float cBtnY, cBtnR, tabY, closeX, closeY;
+
+    public WheelView(Context c, Host host) {
+        super(c);
+        this.host = host;
+        dim.setColor(Color.argb(150, 0, 0, 0));
+        ring.setStyle(Paint.Style.STROKE);
+        slot.setColor(Color.argb(170, 24, 40, 34));
+        slotSel.setStyle(Paint.Style.STROKE);
+        slotSel.setColor(Ornate.GOLD_LIGHT);
+        text.setColor(Ornate.CREAM);
+        text.setTextAlign(Paint.Align.CENTER);
+        text.setTypeface(Typeface.create(Typeface.SERIF, Typeface.BOLD));
+        small.setColor(Ornate.CREAM);
+        small.setTextAlign(Paint.Align.CENTER);
+        small.setTypeface(Typeface.DEFAULT_BOLD);
+    }
+
+    private float dp(float v) {
+        return TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, v, getResources().getDisplayMetrics());
+    }
+
+    /** Call when opening, and whenever the inventory may have changed. */
+    public void refresh() {
+        int[] i = host.inventory();
+        if (i != null && i.length >= 48) inv = i;
+        int[] c = host.cItems();
+        if (c != null && c.length >= 3) cItems = c;
+        slots.clear();
+        int base = masks ? 24 : 0;
+        for (int s = 0; s < 24; s++) {
+            if (inv[base + s] != 255) slots.add(base + s);
+        }
+        if (selected >= slots.size()) selected = -1;
+        invalidate();
+    }
+
+    @Override
+    protected void onDraw(Canvas c) {
+        float w = getWidth(), h = getHeight();
+        c.drawRect(0, 0, w, h, dim);
+        cx = w / 2f;
+        cy = h / 2f;
+        // Whole wheel (ring + item slots + rim) must fit inside the screen height
+        float outer = Math.min(h * 0.47f, w * 0.36f);
+        slotR = Math.max(dp(18), Math.min(dp(28), outer * 0.16f));
+        ringR = outer - slotR - dp(8);
+        slotR = Math.min(slotR, (float) (Math.PI * ringR / Math.max(8, slots.size())) * 0.82f);
+        cy = h / 2f;
+        innerR = ringR - slotR - dp(8);
+
+        disc.setShader(new RadialGradient(cx, cy, ringR + slotR, Color.argb(225, 22, 44, 36), Color.argb(235, 8, 16, 14),
+                Shader.TileMode.CLAMP));
+        c.drawCircle(cx, cy, ringR + slotR + dp(8), disc);
+        ring.setStrokeWidth(dp(3));
+        ring.setColor(Ornate.GOLD_MID);
+        c.drawCircle(cx, cy, ringR + slotR + dp(8), ring);
+        ring.setStrokeWidth(dp(1));
+        ring.setColor(Color.argb(120, 246, 222, 150));
+        c.drawCircle(cx, cy, innerR, ring);
+
+        // Items around the ring
+        int n = slots.size();
+        for (int i = 0; i < n; i++) {
+            double a = -Math.PI / 2 + i * 2 * Math.PI / n;
+            float sx = cx + (float) Math.cos(a) * ringR, sy = cy + (float) Math.sin(a) * ringR;
+            c.drawCircle(sx, sy, slotR, slot);
+            int item = inv[slots.get(i)];
+            Bitmap b = host.icon(item);
+            if (b != null) {
+                float r = slotR * 0.78f;
+                rf.set(sx - r, sy - r, sx + r, sy + r);
+                c.drawBitmap(b, null, rf, bmpPaint);
+            }
+            boolean onC = item == cItems[0] || item == cItems[1] || item == cItems[2];
+            if (i == selected) {
+                slotSel.setStrokeWidth(dp(3));
+                c.drawCircle(sx, sy, slotR + dp(2), slotSel);
+            } else if (onC) {
+                slotSel.setStrokeWidth(dp(1.2f));
+                c.drawCircle(sx, sy, slotR, slotSel);
+            }
+        }
+        if (n == 0) {
+            text.setTextSize(dp(15));
+            c.drawText(masks ? "No masks yet" : "No items yet", cx, cy - ringR * 0.5f, text);
+        }
+
+        // Tabs + close
+        tabY = cy - innerR * 0.62f;
+        text.setTextSize(dp(15));
+        text.setColor(masks ? Color.argb(140, 240, 232, 210) : Ornate.GOLD_LIGHT);
+        c.drawText("Items", cx - innerR * 0.38f, tabY, text);
+        text.setColor(masks ? Ornate.GOLD_LIGHT : Color.argb(140, 240, 232, 210));
+        c.drawText("Masks", cx + innerR * 0.38f, tabY, text);
+        text.setColor(Ornate.CREAM);
+        closeX = Math.min(w - dp(24), cx + ringR + slotR + dp(30));
+        closeY = Math.max(dp(24), cy - ringR - slotR + dp(4));
+        text.setTextSize(dp(20));
+        c.drawText("\u2715", closeX, closeY + dp(7), text);
+
+        // Selected item's name
+        text.setTextSize(dp(14));
+        String label = selected >= 0 && selected < n ? host.name(inv[slots.get(selected)]) : "Tap an item";
+        c.drawText(label, cx, cy - innerR * 0.15f, text);
+
+        // The three C buttons to put it on
+        cBtnR = Math.min(dp(24), innerR * 0.26f);
+        cBtnY = cy + innerR * 0.38f;
+        String[] arrows = { "\u25C0", "\u25BC", "\u25B6" };
+        for (int i = 0; i < 3; i++) {
+            cBtnX[i] = cx + (i - 1) * cBtnR * 2.5f;
+            Ornate.ButtonDrawable d = new Ornate.ButtonDrawable(ModTouchOverlay.STYLE_C, false, Ornate.THEME_YELLOW);
+            d.setBounds((int) (cBtnX[i] - cBtnR), (int) (cBtnY - cBtnR), (int) (cBtnX[i] + cBtnR), (int) (cBtnY + cBtnR));
+            d.draw(c);
+            Bitmap b = host.icon(cItems[i]);
+            if (b != null) {
+                float r = cBtnR * 0.6f;
+                rf.set(cBtnX[i] - r, cBtnY - r, cBtnX[i] + r, cBtnY + r);
+                c.drawBitmap(b, null, rf, bmpPaint);
+            } else {
+                small.setTextSize(cBtnR * 0.8f);
+                c.drawText(arrows[i], cBtnX[i], cBtnY + cBtnR * 0.28f, small);
+            }
+        }
+        small.setTextSize(dp(11));
+        c.drawText(selected >= 0 ? "Tap a C button to equip" : "", cx, cBtnY + cBtnR + dp(14), small);
+    }
+
+    @Override
+    public boolean onTouchEvent(MotionEvent e) {
+        float x = e.getX(), y = e.getY();
+        int action = e.getActionMasked();
+        if (action == MotionEvent.ACTION_DOWN || action == MotionEvent.ACTION_MOVE) {
+            int hit = hitSlot(x, y);
+            if (hit >= 0 && hit != selected) {
+                selected = hit;
+                performHapticFeedback(android.view.HapticFeedbackConstants.KEYBOARD_TAP);
+                invalidate();
+            }
+            return true;
+        }
+        if (action != MotionEvent.ACTION_UP) return true;
+
+        if (dist(x, y, closeX, closeY) < dp(24)) {
+            host.close();
+            return true;
+        }
+        for (int i = 0; i < 3; i++) {
+            if (dist(x, y, cBtnX[i], cBtnY) < cBtnR * 1.15f) {
+                if (selected >= 0 && selected < slots.size()) {
+                    host.equip(i, slots.get(selected));
+                    host.close();
+                }
+                return true;
+            }
+        }
+        if (Math.abs(y - tabY) < dp(18) && Math.abs(x - cx) < innerR) {
+            boolean wantMasks = x > cx;
+            if (wantMasks != masks) {
+                masks = wantMasks;
+                selected = -1;
+                refresh();
+            }
+            return true;
+        }
+        if (dist(x, y, cx, cy) > ringR + slotR + dp(12)) {
+            host.close(); // tapped outside the wheel
+        }
+        return true;
+    }
+
+    private int hitSlot(float x, float y) {
+        int n = slots.size();
+        for (int i = 0; i < n; i++) {
+            double a = -Math.PI / 2 + i * 2 * Math.PI / n;
+            float sx = cx + (float) Math.cos(a) * ringR, sy = cy + (float) Math.sin(a) * ringR;
+            if (dist(x, y, sx, sy) < slotR * 1.1f) return i;
+        }
+        return -1;
+    }
+
+    private static float dist(float ax, float ay, float bx, float by) {
+        float dx = ax - bx, dy = ay - by;
+        return (float) Math.sqrt(dx * dx + dy * dy);
+    }
+}
