+// ---------------------------------------------------------------- objective marker, A action, form
+static std::atomic<int> sMarker[5];  // valid, x*1000, y*1000 (screen -1..1, y up), distance, behind camera
+static std::atomic<int> sAAction{ -1 };
+static std::atomic<int> sForm{ 0 };
+
+static void UpdateMarker(PlayState* play) {
+    Vec3f target, proj;
+    f32 w;
+    Player* player = GET_PLAYER(play);
+    if ((player == nullptr) || !MMQuest_GetTarget(&target) || !sTrailOn) {
+        sMarker[0] = 0;
+        return;
+    }
+    SkinMatrix_Vec3fMtxFMultXYZW(&play->viewProjectionMtxF, &target, &proj, &w);
+    bool behind = w <= 1.0f;
+    f32 inv = (fabsf(w) < 1.0f) ? 1.0f : (1.0f / fabsf(w));
+    f32 x = proj.x * inv, y = proj.y * inv;
+    if (behind) {
+        // Behind the camera: push the arrow to the bottom edge, on the side the target is on
+        x = -x;
+        y = -1.5f;
+    }
+    sMarker[1] = (int)(fmaxf(-50.0f, fminf(50.0f, x)) * 1000.0f);
+    sMarker[2] = (int)(fmaxf(-50.0f, fminf(50.0f, y)) * 1000.0f);
+    sMarker[3] = (int)Math_Vec3f_DistXYZ(&player->actor.world.pos, &target);
+    sMarker[4] = behind ? 1 : 0;
+    sMarker[0] = 1;
+}
