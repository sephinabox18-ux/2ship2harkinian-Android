diff --git a/Android/app/src/main/java/com/twoshipfork/mm/MarkerView.java b/Android/app/src/main/java/com/twoshipfork/mm/MarkerView.java
new file mode 100644
index 0000000..6c3817a
--- /dev/null
+++ b/Android/app/src/main/java/com/twoshipfork/mm/MarkerView.java
@@ -0,0 +1,108 @@
+package com.twoshipfork.mm;
+
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.graphics.Typeface;
+import android.util.TypedValue;
+import android.view.View;
+
+/**
+ * Objective marker: a small gold diamond over the objective when it's on screen, or a gold arrow at the
+ * screen edge pointing towards it when it isn't. Shows the distance underneath. Never takes touches.
+ */
+public class MarkerView extends View {
+    private final Paint fill = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint edge = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint text = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Path p = new Path();
+    private boolean valid;
+    private float nx, ny;   // -1..1 screen space, y up
+    private int distance;   // game units
+    private boolean behind;
+
+    public MarkerView(Context c) {
+        super(c);
+        fill.setColor(Ornate.GOLD_LIGHT);
+        edge.setStyle(Paint.Style.STROKE);
+        edge.setColor(Color.argb(220, 60, 40, 10));
+        text.setColor(Ornate.CREAM);
+        text.setTextAlign(Paint.Align.CENTER);
+        text.setTypeface(Typeface.create(Typeface.SERIF, Typeface.BOLD));
+    }
+
+    private float dp(float v) {
+        return TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, v, getResources().getDisplayMetrics());
+    }
+
+    /** data = { valid, x*1000, y*1000, distance, behind } */
+    public void setMarker(int[] data) {
+        if (data == null || data.length < 5) return;
+        boolean v = data[0] != 0;
+        float x = data[1] / 1000f, y = data[2] / 1000f;
+        if (v != valid || Math.abs(x - nx) > 0.003f || Math.abs(y - ny) > 0.003f || data[3] / 40 != distance / 40) {
+            valid = v;
+            nx = x;
+            ny = y;
+            distance = data[3];
+            behind = data[4] != 0;
+            invalidate();
+        }
+    }
+
+    @Override
+    protected void onDraw(Canvas c) {
+        if (!valid) return;
+        float w = getWidth(), h = getHeight();
+        float px = (nx + 1f) / 2f * w, py = (1f - (ny + 1f) / 2f) * h;
+        float margin = dp(34);
+        boolean onScreen = !behind && px > margin && px < w - margin && py > margin && py < h - margin;
+        edge.setStrokeWidth(dp(1.5f));
+        edge.setShadowLayer(dp(3), 0, dp(1), Color.BLACK);
+        fill.setShadowLayer(dp(3), 0, dp(1), Color.argb(170, 0, 0, 0));
+        text.setTextSize(dp(12));
+        text.setShadowLayer(dp(2.5f), 0, dp(1), Color.BLACK);
+        String dist = (distance / 40) + " m";
+
+        if (onScreen) {
+            float s = dp(9);
+            float y = py - dp(14);
+            p.reset();
+            p.moveTo(px, y - s);
+            p.lineTo(px + s * 0.7f, y);
+            p.lineTo(px, y + s);
+            p.lineTo(px - s * 0.7f, y);
+            p.close();
+            c.drawPath(p, fill);
+            c.drawPath(p, edge);
+            c.drawText(dist, px, y + s + dp(14), text);
+            return;
+        }
+        // Off screen: arrow on the edge, pointing at it
+        float cx = w / 2f, cy = h / 2f;
+        float dx = px - cx, dy = py - cy;
+        if (Math.abs(dx) < 1 && Math.abs(dy) < 1) dy = 1;
+        float sx = (w / 2f - margin) / Math.max(1e-3f, Math.abs(dx));
+        float sy = (h / 2f - margin) / Math.max(1e-3f, Math.abs(dy));
+        float k = Math.min(sx, sy);
+        float ax = cx + dx * k, ay = cy + dy * k;
+        float ang = (float) Math.toDegrees(Math.atan2(dy, dx));
+        float s = dp(13);
+        c.save();
+        c.rotate(ang, ax, ay);
+        p.reset();
+        p.moveTo(ax + s, ay);
+        p.lineTo(ax - s * 0.7f, ay - s * 0.75f);
+        p.lineTo(ax - s * 0.35f, ay);
+        p.lineTo(ax - s * 0.7f, ay + s * 0.75f);
+        p.close();
+        c.drawPath(p, fill);
+        c.drawPath(p, edge);
+        c.restore();
+        float tx = ax - (float) Math.cos(Math.toRadians(ang)) * dp(26);
+        float ty = ay - (float) Math.sin(Math.toRadians(ang)) * dp(26) + dp(4);
+        c.drawText(dist, tx, ty, text);
+    }
+}
diff --git a/Android/app/src/main/java/com/twoshipfork/mm/MiniMapView.java b/Android/app/src/main/java/com/twoshipfork/mm/MiniMapView.java
new file mode 100644
index 0000000..08a5f20
--- /dev/null
+++ b/Android/app/src/main/java/com/twoshipfork/mm/MiniMapView.java
@@ -0,0 +1,181 @@
+package com.twoshipfork.mm;
+
+import android.content.Context;
+import android.graphics.Bitmap;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.LinearGradient;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.graphics.Rect;
+import android.graphics.RectF;
+import android.graphics.Shader;
+import android.graphics.Typeface;
+import android.util.TypedValue;
+import android.view.View;
+
+/**
+ * Clean, readable mini-map: walkable floors in soft teal with bright edges, centred on Link (gold arrow),
+ * with chests (gold = unopened, grey = opened), stray fairies (pink) and the current objective (diamond).
+ */
+public class MiniMapView extends View {
+    private final Paint bg = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint rim = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mapPaint = new Paint(); // no filtering: crisp cells
+    private final Paint mark = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint markEdge = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint text = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Path p = new Path();
+    private final RectF rf = new RectF();
+    private final Rect src = new Rect();
+
+    private Bitmap map;
+    private int version = -1;
+    private int[] info = new int[0];
+    private float viewUnits = 1700f; // world units shown across the map
+
+    public MiniMapView(Context c) {
+        super(c);
+        rim.setStyle(Paint.Style.STROKE);
+        markEdge.setStyle(Paint.Style.STROKE);
+        markEdge.setColor(Color.argb(220, 20, 16, 8));
+        text.setColor(Ornate.CREAM);
+        text.setTextAlign(Paint.Align.CENTER);
+        text.setTypeface(Typeface.create(Typeface.SERIF, Typeface.BOLD));
+    }
+
+    private float dp(float v) {
+        return TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, v, getResources().getDisplayMetrics());
+    }
+
+    /** info from nativeMmGetMapInfo; grid fetched only when the version changes. */
+    public void update(int[] newInfo, GridSource gridSource) {
+        if (newInfo == null || newInfo.length < 12) return;
+        if (newInfo[0] != version) {
+            byte[] grid = gridSource.grid();
+            int w = newInfo[4], h = newInfo[5];
+            if (grid != null && w > 0 && h > 0 && grid.length >= w * h) {
+                map = buildBitmap(grid, w, h);
+                version = newInfo[0];
+            }
+        }
+        info = newInfo;
+        invalidate();
+    }
+
+    interface GridSource {
+        byte[] grid();
+    }
+
+    private static Bitmap buildBitmap(byte[] g, int w, int h) {
+        int[] px = new int[w * h];
+        int fill = Color.argb(150, 70, 150, 130);
+        int edge = Color.argb(235, 200, 240, 225);
+        for (int z = 0; z < h; z++) {
+            for (int x = 0; x < w; x++) {
+                if (g[z * w + x] == 0) continue;
+                boolean border = x == 0 || z == 0 || x == w - 1 || z == h - 1 || g[z * w + x - 1] == 0
+                        || g[z * w + x + 1] == 0 || g[(z - 1) * w + x] == 0 || g[(z + 1) * w + x] == 0;
+                px[z * w + x] = border ? edge : fill;
+            }
+        }
+        return Bitmap.createBitmap(px, 0, w, w, h, Bitmap.Config.ARGB_8888);
+    }
+
+    @Override
+    protected void onDraw(Canvas c) {
+        float w = getWidth(), h = getHeight();
+        float r = dp(14);
+        rf.set(dp(2), dp(2), w - dp(2), h - dp(2));
+        bg.setShader(new LinearGradient(0, 0, 0, h, Color.argb(205, 22, 44, 36), Color.argb(215, 8, 16, 14), Shader.TileMode.CLAMP));
+        c.drawRoundRect(rf, r, r, bg);
+
+        if (info.length >= 12 && map != null) {
+            boolean hasMap = info[6] != 0;
+            int minX = info[1], minZ = info[2], cell = Math.max(1, info[3]);
+            int lx = info[8], lz = info[9];
+            float scale = (w - dp(8)) / viewUnits;            // view px per world unit
+            float cx = w / 2f, cy = h / 2f;
+
+            c.save();
+            p.reset();
+            p.addRoundRect(rf, r, r, Path.Direction.CW);
+            c.clipPath(p);
+            if (hasMap) {
+                // the part of the grid around Link
+                float half = viewUnits / 2f / cell * Math.max(1f, h / w);
+                float gcx = (lx - minX) / (float) cell, gcz = (lz - minZ) / (float) cell;
+                float halfW = viewUnits / 2f / cell, halfH = halfW * h / w;
+                src.set((int) Math.floor(gcx - halfW), (int) Math.floor(gcz - halfH), (int) Math.ceil(gcx + halfW),
+                        (int) Math.ceil(gcz + halfH));
+                rf.set(cx + (src.left - gcx) * cell * scale, cy + (src.top - gcz) * cell * scale,
+                        cx + (src.right - gcx) * cell * scale, cy + (src.bottom - gcz) * cell * scale);
+                c.drawBitmap(map, src, rf, mapPaint);
+            } else {
+                text.setTextSize(dp(11));
+                c.drawText("Find the map", cx, cy - dp(16), text);
+            }
+
+            // markers
+            int n = info[11];
+            for (int i = 0; i < n && 12 + i * 3 + 2 < info.length; i++) {
+                int type = info[12 + i * 3];
+                float mx = cx + (info[13 + i * 3] - lx) * scale, my = cy + (info[14 + i * 3] - lz) * scale;
+                drawMarker(c, type, Math.max(dp(8), Math.min(w - dp(8), mx)), Math.max(dp(8), Math.min(h - dp(8), my)));
+            }
+
+            // Link: gold arrow pointing the way he faces
+            float yaw = info[10] * 360f / 65536f;
+            c.save();
+            c.rotate(-yaw + 180f, cx, cy);
+            float s = dp(7);
+            p.reset();
+            p.moveTo(cx, cy - s * 1.3f);
+            p.lineTo(cx + s, cy + s);
+            p.lineTo(cx, cy + s * 0.45f);
+            p.lineTo(cx - s, cy + s);
+            p.close();
+            mark.setColor(Ornate.GOLD_LIGHT);
+            c.drawPath(p, mark);
+            markEdge.setStrokeWidth(dp(1.2f));
+            c.drawPath(p, markEdge);
+            c.restore();
+            c.restore();
+        }
+
+        rim.setStrokeWidth(dp(2));
+        rim.setColor(Ornate.GOLD_MID);
+        rf.set(dp(2), dp(2), w - dp(2), h - dp(2));
+        c.drawRoundRect(rf, r, r, rim);
+    }
+
+    private void drawMarker(Canvas c, int type, float x, float y) {
+        float s = dp(5);
+        markEdge.setStrokeWidth(dp(1));
+        switch (type) {
+            case 1: // chest, not opened yet
+            case 2: // opened chest
+                mark.setColor(type == 1 ? Ornate.GOLD_LIGHT : Color.argb(170, 150, 150, 140));
+                rf.set(x - s, y - s * 0.75f, x + s, y + s * 0.75f);
+                c.drawRoundRect(rf, dp(1.5f), dp(1.5f), mark);
+                c.drawRoundRect(rf, dp(1.5f), dp(1.5f), markEdge);
+                break;
+            case 3: // stray fairy
+                mark.setColor(Color.rgb(255, 150, 210));
+                c.drawCircle(x, y, s * 0.8f, mark);
+                c.drawCircle(x, y, s * 0.8f, markEdge);
+                break;
+            case 4: // objective
+                mark.setColor(Ornate.GOLD_LIGHT);
+                p.reset();
+                p.moveTo(x, y - s * 1.3f);
+                p.lineTo(x + s, y);
+                p.lineTo(x, y + s * 1.3f);
+                p.lineTo(x - s, y);
+                p.close();
+                c.drawPath(p, mark);
+                c.drawPath(p, markEdge);
+                break;
+        }
+    }
+}
