+    // ---------------------------------------------------------------- mask special button
+    // One button for each form's two-button move:
+    //   Goron        press = curl (A), keep holding ~0.4s = ground pound (adds B)
+    //   Zora         hold = electric barrier (R)
+    //   Deku         hold = charge a bubble (B), let go to shoot it
+    //   Fierce Deity tap = sword beam (Z-target + B)
+    private int specialHeld = 0;
+    private final Runnable specialSecond = new Runnable() {
+        @Override
+        public void run() {
+            if (specialHeld == 0) return;
+            ModTouchOverlay.this.act.nativeMmSetN64Button(N64_B, true);
+            specialHeld |= N64_B;
+        }
+    };
+
+    private void startPound() {
+        releaseSpecial();
+        switch (form) {
+            case 1: // Goron: curl, then pound if still held
+                press(N64_A);
+                handler.postDelayed(specialSecond, 400);
+                break;
+            case 2: // Zora barrier
+                press(N64_R);
+                break;
+            case 3: // Deku bubble
+                press(N64_B);
+                break;
+            case 0: // Fierce Deity beam: target, then swing
+                press(N64_Z);
+                handler.postDelayed(specialSecond, 90);
+                break;
+        }
+    }
