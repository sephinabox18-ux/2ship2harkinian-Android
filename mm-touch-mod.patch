+static const u16 sNoteButtons[] = { BTN_A, BTN_CDOWN, BTN_CRIGHT, BTN_CLEFT, BTN_CUP };
+#define NOTE_HOLD 3
+#define NOTE_GAP 2
+static s32 sSeqSong = -1, sSeqNote = 0, sSeqTimer = 0;
+
+// Called by padmgr.c once per frame for controller 1: buttons to add to the pad.
+extern "C" u32 MMMod_TouchButtons(void) {
+    u32 buttons = gMmTouchN64Buttons;
+    int req = sSongRequest.exchange(-1);
+
+    if ((req >= 0) && (req < SONG_COUNT)) {
+        sSeqSong = sAllSongs[req].song;
+        sSeqNote = 0;
+        sSeqTimer = 0;
+    }
+    if (sSeqSong >= 0) {
+        OcarinaSongButtons* notes = &gOcarinaSongButtons[sSeqSong];
+        if ((gPlayState == nullptr) || (gPlayState->msgCtx.msgMode != MSGMODE_OCARINA_PLAYING) ||
+            (sSeqNote >= notes->numButtons)) {
+            sSeqSong = -1;
+        } else {
+            s32 t = sSeqTimer++;
+            if (t < NOTE_HOLD) {
+                u8 idx = notes->buttonIndex[sSeqNote];
+                if (idx < 5) buttons |= sNoteButtons[idx];
+            } else if (t >= NOTE_HOLD + NOTE_GAP - 1) {
+                sSeqNote++;
+                sSeqTimer = 0;
+            }
+        }
+    }
+    return buttons;
+}
