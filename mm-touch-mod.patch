+    // ---------------------------------------------------------------- A button shows what it will do
+    private static String actionLabel(int a) {
+        switch (a) {
+            case 0x01: return "Check"; case 0x02: return "Enter"; case 0x03: return "Return"; case 0x04: return "Open";
+            case 0x05: return "Jump"; case 0x06: return "Decide"; case 0x07: return "Dive"; case 0x08: return "Faster";
+            case 0x09: return "Throw"; case 0x0B: return "Climb"; case 0x0C: return "Drop"; case 0x0D: return "Down";
+            case 0x0E: return "Quit"; case 0x0F: return "Talk"; case 0x10: return "Next"; case 0x11: return "Grab";
+            case 0x12: return "Stop"; case 0x13: return "Put Away"; case 0x14: return "Reel"; case 0x15: return "Info";
+            case 0x16: return "Warp"; case 0x17: return "Snap"; case 0x18: return "Explode"; case 0x19: return "Dance";
+            case 0x1A: return "March"; case 0x23: return "Curl"; case 0x24: return "Surface"; case 0x25: return "Swim";
+            case 0x26: return "Punch"; case 0x27: return "Pound"; case 0x28: return "Hook"; case 0x29: return "Shoot";
+            default:
+                if (a >= 0x1B && a <= 0x22) return String.valueOf(a - 0x1A); // counting 1-8
+                return null; // nothing special: show the hand
+        }
+    }
