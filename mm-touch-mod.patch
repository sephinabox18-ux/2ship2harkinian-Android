@@ -0,0 +1,1396 @@
+// Majora's Mask touch mod - game side.
+//  Touch buttons -> pad injection, jump, sprint, quick save/load, fast travel map, tap-to-skip cutscenes,
+//  ocarina song auto-play, unlimited diving, and the glue for the quest tracker (MMQuest.c).
+//  Everything the Android overlay asks for is queued and done on the game thread.
+#include <libultraship/bridge/consolevariablebridge.h>
+#include "2s2h/GameInteractor/GameInteractor.h"
+#include "2s2h/ShipInit.hpp"
+#include "2s2h/Enhancements/Saving/SavingEnhancements.h"
