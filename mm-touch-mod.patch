+    private void layoutHudBar(Ctl c) {
+        int w = root.getWidth(), h = root.getHeight();
+        if (w == 0 || h == 0) return;
+        HudBarView v = hudViewFor(c);
+        v.setScale(c.size / 36f);
+        int bw = v.preferredWidth(), bh = v.preferredHeight();
+        FrameLayout.LayoutParams lp = (FrameLayout.LayoutParams) v.getLayoutParams();
+        if (lp == null) return;
+        int left = (int) (c.x * w - bw / 2f), top = (int) (c.y * h - bh / 2f);
+        if (lp.width != bw || lp.height != bh || lp.leftMargin != left || lp.topMargin != top) {
+            lp.width = bw;
+            lp.height = bh;
+            lp.leftMargin = left;
+            lp.topMargin = top;
+            v.setLayoutParams(lp);
+        }
+    }
