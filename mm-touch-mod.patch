+
+        FrameLayout.LayoutParams lp = new FrameLayout.LayoutParams(dp(250), ViewGroup.LayoutParams.WRAP_CONTENT);
+        lp.gravity = Gravity.END | Gravity.CENTER_VERTICAL;
+        lp.rightMargin = dp(24);
+        root.addView(songsPanel, lp);
+    }
+
+    private void rebuildSongs(String songs) {
+        songsList.removeAllViews();
+        for (String line : songs.split("\n")) {
+            int colon = line.indexOf(':');
+            if (colon <= 0) continue;
+            final int idx = Integer.parseInt(line.substring(0, colon));
+            TextView row = new TextView(act);
+            row.setText(line.substring(colon + 1));
+            row.setTextColor(Color.WHITE);
+            row.setTextSize(TypedValue.COMPLEX_UNIT_SP, 15);
+            row.setTypeface(Typeface.DEFAULT_BOLD);
+            row.setPadding(dp(8), dp(7), dp(8), dp(7));
+            row.setOnClickListener(v -> {
+                touched();
+                v.performHapticFeedback(HapticFeedbackConstants.KEYBOARD_TAP);
+                act.nativeMmPlaySong(idx);
+            });
+            songsList.addView(row);
+        }
+    }
+
+    private void buildTray() {
+        tray = new LinearLayout(act);
+        tray.setOrientation(LinearLayout.VERTICAL);
+        tray.setPadding(dp(8), dp(6), dp(8), dp(6));
+        tray.setBackground(panelDrawable());
+        tray.setVisibility(View.GONE);
+
+        LinearLayout row1 = new LinearLayout(act);
+        LinearLayout row2 = new LinearLayout(act);
+        row1.addView(trayItem("Map", v -> act.nativeMmAction(ACT_MAP), true));
+        row1.addView(trayItem("Quick save", v -> act.nativeMmAction(ACT_QUICKSAVE), true));
+        row1.addView(trayItem("Quick load", v -> act.nativeMmAction(ACT_QUICKLOAD), true));
+        trailItem = trayItem("Trail: on", v -> act.nativeMmAction(ACT_TRAIL), false);
+        row1.addView(trailItem);
+        questItem = trayItem(questPanelOn ? "Quest: on" : "Quest: off", v -> {
+            questPanelOn = !questPanelOn;
+            prefs.edit().putBoolean("questPanel", questPanelOn).apply();
+            ((TextView) v).setText(questPanelOn ? "Quest: on" : "Quest: off");
+        }, false);
+        row1.addView(questItem);
+        row1.addView(trayItem("Pause", v -> tapN64(N64_START), true));
+
+        row2.addView(trayItem("Tatl", v -> tapN64(N64_CUP), true));
+        row2.addView(trayItem("Minimap", v -> tapN64(N64_L), true));
+        row2.addView(trayItem("2 Ship menu", v -> act.nativeGamepadBackPressed(), true));
+        row2.addView(trayItem(swipeCamera ? "Camera: swipe" : "Camera: stick", v -> {
