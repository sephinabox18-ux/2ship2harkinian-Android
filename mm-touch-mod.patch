+// ---------------------------------------------------------------- defaults (applied once)
+static void ApplyTouchCameraPreset() {
+    // Tuned for the swipe camera on a phone: camera can't dip into the ground, and a comfortable turn speed.
+    CVarSetFloat("gEnhancements.Camera.FreeLook.MinPitch", -10.0f);
+    CVarSetFloat("gEnhancements.Camera.RightStick.CameraSensitivity.X", 2.0f);
+    CVarSetFloat("gEnhancements.Camera.RightStick.CameraSensitivity.Y", 1.2f);
+    CVarSetInteger("gEnhancements.Camera.RightStick.InvertYAxis", 0);
+}
+
+static void ApplyPresetOnce() {
+    s32 version = CVarGetInteger(CVAR_PRESET_VERSION, 0);
+    if (version >= 4) return;
+    if (version == 0) {
+        CVarSetInteger("gEnhancements.Camera.FreeLook.Enable", 1);
+        CVarSetInteger("gEnhancements.Masks.FastTransformation", 1);
+        CVarSetInteger("gEnhancements.Timesavers.FasterSceneTransitions", 1);
+        CVarSetInteger("gEnhancements.Songs.PauseOwlWarp", 1);
+        CVarSetInteger("gEnhancements.Cutscenes.SkipEntranceCutscenes", 1);
+        CVarSetInteger("gEnhancements.Cutscenes.SkipOnePointCutscenes", 1);
+        CVarSetInteger("gEnhancements.Songs.SkipSoaringCutscene", 1);
+        CVarSetInteger("gEnhancements.Songs.FasterSongPlayback", 1);
+        CVarSetFloat(CVAR_SPEED_VALUE, 1.6f);
+        CVarSetInteger(CVAR_SPEED_MODE, 0);
+    }
+    if (version < 2) {
+        // bigger 2 Ship menu for fingers (takes effect next time the app starts)
+        CVarSetFloat("gSettings.Menu.AndroidScale", 1.8f);
+    }
+    if (version < 3) {
+        ApplyTouchCameraPreset();
+    }
+    if (version < 4) {
+        CVarSetInteger("gEnhancements.Camera.FirstPerson.RightStickEnabled", 1);
+    }
+    CVarSetInteger(CVAR_PRESET_VERSION, 4);
+    CVarSave();
+    ShipInit::Init("*");
+}
