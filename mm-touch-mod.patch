+    private void rebuildQuestPage(int[] info) {
+        StringBuilder key = new StringBuilder();
+        for (int v : info) key.append(v).append(',');
+        if (key.toString().equals(lastQuestKey)) return;
+        lastQuestKey = key.toString();
+        iconPending = false;
+        questContent.removeAllViews();
+        int q = info[1];
+
+        questContent.addView(infoLine("Boss remains", 14, GOLD, true));
+        questContent.addView(iconRow(new int[] { 0x5D, 0x5E, 0x5F, 0x60 },
+                new boolean[] { (q & 1) != 0, (q & 2) != 0, (q & 4) != 0, (q & 8) != 0 },
+                new String[] { "Odolwa", "Goht", "Gyorg", "Twinmold" }));
+
+        int sword = info[3], shield = info[4], quiver = info[5], bombs = info[6];
+        questContent.addView(infoLine("Equipment", 14, GOLD, true));
+        questContent.addView(iconRow(
+                new int[] { sword > 0 ? 0x4D + sword - 1 : 0x4D, shield > 0 ? 0x51 + shield - 1 : 0x51,
+                        quiver > 0 ? 0x53 + quiver - 1 : 0x53, bombs > 0 ? 0x56 + bombs - 1 : 0x56, 0x6D },
+                new boolean[] { sword > 0, shield > 0, quiver > 0, bombs > 0, (q & (1 << 18)) != 0 },
+                new String[] { "Sword", "Shield", "Quiver", "Bomb Bag", "Notebook" }));
+
+        StringBuilder songs = new StringBuilder();
+        for (int bit = 6; bit <= 16; bit++) {
+            String name = SONG_NAMES[bit - 6];
+            if (!name.isEmpty() && (q & (1 << bit)) != 0) {
+                if (songs.length() > 0) songs.append("  \u00B7  ");
+                songs.append(name);
+            }
+        }
+        questContent.addView(infoLine("Songs", 14, GOLD, true));
+        TextView songLine = infoLine(songs.length() > 0 ? songs.toString() : "None yet", 13, Color.rgb(243, 233, 210), false);
+        songLine.setMaxWidth(dp(420));
+        questContent.addView(songLine);
+        questContent.addView(infoLine("Pieces of Heart: " + info[2] + " / 4", 13, Color.rgb(243, 233, 210), false));
+        if (iconPending) lastQuestKey = "";
+    }
