+extern "C" void MMMod_AfterPlayUpdate(PlayState* play) {
+    int bits = 0;
+    static s32 sLastCrumbScene = -1;
+    if (play->sceneId != sLastCrumbScene) {
+        sLastCrumbScene = play->sceneId;
+        Crumb("entered scene " + std::to_string(play->sceneId));
+    }
+    ApplyHudStyle();
+    ApplyMinimap();
+    UpdateHudData(play);
+    ServiceIcons();
+    UpdateItemsAndPause(play);
+
+    if (sFastTravelOpen && !IS_PAUSED(&play->pauseCtx)) FinishFastTravel(play);
+
+    if (TakeRequest(ACT_SPRINT)) SetSprint(!sSprintOn);
+    if (TakeRequest(ACT_SPRINT_ON) && !sSprintOn) SetSprint(true);
+    if (TakeRequest(ACT_SPRINT_OFF) && sSprintOn) SetSprint(false);
+    ApplyEquip(play);
+    ApplyOptions();
+    if (TakeRequest(ACT_TRAIL)) {
+        sTrailOn = !sTrailOn;
+        PostMessage(sTrailOn ? "Tatl's trail on" : "Tatl's trail off");
+    }
+    if (TakeRequest(ACT_QUICKSAVE)) QuickSave(play);
+    if (TakeRequest(ACT_QUICKLOAD)) QuickLoad(play);
+    if (TakeRequest(ACT_MAP)) {
+        if (CanOpenFastTravel(play)) {
+            OpenOwlMap(play);
+        } else {
+            Audio_PlaySfx(NA_SE_SY_ERROR);
+            PostMessage(gSaveContext.save.saveInfo.playerData.owlActivationFlags == 0
+                            ? "Hit an owl statue with your sword to unlock fast travel"
+                            : "Can't fast travel from here");
+        }
+    }
+
+    // Cutscene skipping
+    if (sSkipping) {
+        RunSkip(play);
+    } else if (CanStartSkip(play)) {
+        if (sSkipVisibleFrames < 8) sSkipVisibleFrames++; // ignore one-frame camera moments
+        if (TakeRequest(ACT_SKIP) && (sSkipVisibleFrames >= 8)) {
+            sSkipping = true;
+            sSkipBudget = 4000;
+        }
+    } else {
+        sSkipVisibleFrames = 0;
+        TakeRequest(ACT_SKIP);
+    }
+
+    // Quest tracker + Tatl trail
+    if (gSaveContext.gameMode == GAMEMODE_NORMAL) {
+        SyncVisited();
+        MMQuest_Update(play, sTrailOn);
+        s32 step = MMQuest_GetStep();
+        if (step != sLastStep) {
+            sLastStep = step;
+            s32 idx, count;
+            MMQuest_Progress(step, &idx, &count);
+            std::string t = std::string("Main quest \u00B7 ") + MMQuest_Chapter(step) + " \u00B7 " + std::to_string(idx) +
+                            "/" + std::to_string(count) + "\n" + MMQuest_Title(step) + "\n" + MMQuest_Text(step);
+            std::lock_guard<std::mutex> lock(sTextMutex);
+            sQuestText = t;
+        }
+    }
+
+    if (sSkipVisibleFrames >= 8 && !sSkipping) bits |= ST_CAN_SKIP;
+    if (sSkipping) bits |= ST_SKIPPING;
+    if (play->msgCtx.msgMode == MSGMODE_OCARINA_PLAYING) bits |= ST_OCARINA; // ocarina out: song list / free play
+    if ((gSaveContext.gameMode == GAMEMODE_NORMAL) && !IS_PAUSED(&play->pauseCtx) &&
+        (play->msgCtx.msgMode == MSGMODE_NONE) && !InCutscene(play) && !Play_InCsMode(play)) {
+        bits |= ST_SHOW_QUEST;
+    }
+    if (IS_PAUSED(&play->pauseCtx)) bits |= ST_PAUSED;
+    if ((gSaveContext.gameMode == GAMEMODE_NORMAL) && !IS_PAUSED(&play->pauseCtx) && !InCutscene(play) &&
+        (play->gameOverCtx.state == GAMEOVER_INACTIVE)) {
+        bits |= ST_GAMEPLAY;
+    }
+    if (sPausePage >= 0) bits |= ST_PAUSE_GRID;
+    UpdateMarker(play);
+    UpdateMiniMap(play);
+    sAAction = play->interfaceCtx.aButtonDoAction;
+    {
+        Player* player = GET_PLAYER(play);
+        if (player != nullptr) sForm = player->transformation;
+        if ((player != nullptr) && (player->stateFlags1 & PLAYER_STATE1_100000)) bits |= ST_AIMING;
+        if (InConversation(play)) bits |= ST_TEXT;
+    }
+    if (sSprintOn) bits |= ST_SPRINT;
+    if (sTrailOn) bits |= ST_TRAIL;
+    sStateBits = bits;
+}
