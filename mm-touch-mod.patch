+static bool CanOpenFastTravel(PlayState* play) {
+    Player* player = GET_PLAYER(play);
+    if (player == nullptr) return false;
+    if (gSaveContext.gameMode != GAMEMODE_NORMAL) return false;
+    if (IS_PAUSED(&play->pauseCtx) || (play->gameOverCtx.state != GAMEOVER_INACTIVE)) return false;
+    if ((play->transitionTrigger != TRANS_TRIGGER_OFF) || (play->transitionMode != TRANS_MODE_OFF)) return false;
+    if (Play_InCsMode(play) || (play->msgCtx.msgMode != MSGMODE_NONE)) return false;
+    if (play->msgCtx.ocarinaMode != OCARINA_MODE_NONE) return false;
+    if (play->interfaceCtx.restrictions.songOfSoaring != 0) return false;
+    if (Map_CurRoomHasMapI(play) || (play->sceneId == SCENE_SECOM)) return false;
+    if (gSaveContext.save.saveInfo.playerData.owlActivationFlags == 0) return false;
+    if (!(player->actor.bgCheckFlags & BGCHECKFLAG_GROUND)) return false;
+    if (player->stateFlags1 & (PLAYER_STATE1_8000000 | PLAYER_STATE1_800000 | PLAYER_STATE1_CARRYING_ACTOR |
+                               PLAYER_STATE1_TALKING | PLAYER_STATE1_DEAD)) {
+        return false;
+    }
+    return true;
+}
