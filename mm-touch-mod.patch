+// ---------------------------------------------------------------- breadcrumbs (for crash reports)
+// A small text file with what the game and the mod were doing, refreshed every few seconds and on every
+// mod action. If the app crashes, the overlay attaches it to the crash report it saves to Downloads.
+static std::mutex sCrumbMutex;
+static std::vector<std::string> sCrumbEvents;
+
+static void Crumb(const std::string& event) {
+    std::lock_guard<std::mutex> lock(sCrumbMutex);
+    sCrumbEvents.push_back(std::to_string(gGameState != nullptr ? (int)gSaveContext.save.time : 0) + " " + event);
+    if (sCrumbEvents.size() > 40) sCrumbEvents.erase(sCrumbEvents.begin());
+}
+
+static void WriteCrumbs(const std::string& status) {
+    std::string path = Ship::Context::GetPathRelativeToAppDirectory("mm_breadcrumbs.txt");
+    std::ofstream f(path, std::ios::trunc);
+    if (!f) return;
+    f << "Majora's Mask touch mod - last known state\n" << status << "\nRecent events (game time, event):\n";
+    std::lock_guard<std::mutex> lock(sCrumbMutex);
+    for (auto& e : sCrumbEvents) f << "  " << e << "\n";
+}
+
+static void PostMessage(const char* msg) {
+    Crumb(std::string("message: ") + msg);
+    std::lock_guard<std::mutex> lock(sTextMutex);
+    sMessage = msg;
+}
+
+static bool TakeRequest(int act) {
+    int bit = 1 << act;
+    bool taken = (sRequestMask.fetch_and(~bit) & bit) != 0;
+    if (taken) Crumb("action " + std::to_string(act));
+    return taken;
+}
