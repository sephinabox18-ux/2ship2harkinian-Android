+    // ------------------------------------------------------------------ layout
+    private void layoutAll() {
+        int w = root.getWidth(), h = root.getHeight();
+        if (w == 0 || h == 0) return;
+        if (hudBar != null && hudCtl != null && infoBar != null) layoutHudBar();
+
+        FrameLayout.LayoutParams sz = (FrameLayout.LayoutParams) stickZone.getLayoutParams();
+        sz.width = (int) (w * 0.45f);
+        stickZone.setLayoutParams(sz);
+
+        for (Ctl c : ctls) {
+            if (c.kind == KIND_PANEL) {
+                int pw = dp(c.size);
+                FrameLayout.LayoutParams lp = new FrameLayout.LayoutParams(pw, ViewGroup.LayoutParams.WRAP_CONTENT);
+                lp.leftMargin = (int) (c.x * w - pw / 2f);
+                lp.topMargin = (int) (c.y * h);
+                c.view.setLayoutParams(lp);
+                float k = Math.max(0.45f, c.size / 360f);
+                questWhere.setTextSize(TypedValue.COMPLEX_UNIT_SP, 12 * k);
+                questTitle.setTextSize(TypedValue.COMPLEX_UNIT_SP, 17 * k);
+                questText.setTextSize(TypedValue.COMPLEX_UNIT_SP, 13 * k);
+                if (editing) c.view.setAlpha(c.hidden ? 0.35f : 1f);
+                continue;
+            }
+            if (c.kind == KIND_HUD) {
+                continue; // laid out by layoutHudBar() (it has no text label)
+            }
+            if (c.kind == KIND_MAPVIEW) {
+                int px = dp(c.size);
+                FrameLayout.LayoutParams mlp = new FrameLayout.LayoutParams(px, px);
+                mlp.leftMargin = (int) (c.x * w - px / 2f);
+                mlp.topMargin = (int) (c.y * h - px / 2f);
+                c.view.setLayoutParams(mlp);
+                if (editing) c.view.setAlpha(c.hidden ? 0.3f : 1f);
+                continue;
+            }
+            int px = dp(c.size);
+            int pw = c.kind == KIND_SKIP ? (int) (px * 2.2f) : px;
+            FrameLayout.LayoutParams lp = new FrameLayout.LayoutParams(pw, px);
+            lp.leftMargin = (int) (c.x * w - pw / 2f);
+            lp.topMargin = (int) (c.y * h - px / 2f);
+            c.view.setLayoutParams(lp);
+            float ratio = c.kind == KIND_SKIP ? 0.30f
+                    : (c.sub.isEmpty() ? (c.label.length() > 3 ? 0.22f : (c.style == STYLE_C ? 0.36f : 0.42f)) : 0.24f);
+            if (c.text != null) c.text.setTextSize(TypedValue.COMPLEX_UNIT_PX, px * ratio);
+            if (c.kind == KIND_MINIMAP) {
+                c.view.setVisibility(editing ? View.VISIBLE : View.GONE);
+                if (editing) c.view.setAlpha(c.hidden ? 0.3f : 1f);
+                continue;
+            }
+            if (c.kind == KIND_STICK) {
+                c.view.setVisibility(fixedStick && !menuMode ? View.VISIBLE : View.GONE);
+                if (editing) c.view.setAlpha(1f);
+                continue;
+            }
+            if (c.kind == KIND_POUND) {
+                boolean show = editing || (!c.hidden && form != 4); // any mask form (not plain Link)
+                c.view.setVisibility(show ? View.VISIBLE : View.GONE);
+                if (editing) c.view.setAlpha(c.hidden ? 0.25f : 1f);
+                continue;
+            }
+            if (c.kind != KIND_SKIP) {
+                boolean show = !c.hidden || editing;
+                c.view.setVisibility(show ? View.VISIBLE : View.GONE);
+            }
+            if (editing) c.view.setAlpha(c.hidden ? 0.25f : 1f);
+        }
+    }
+
+    private void loadCtl(Ctl c) {
+        String s = prefs.getString("ctl_" + c.id, null);
+        c.x = c.defX; c.y = c.defY; c.size = c.defSize; c.hidden = c.defHidden;
+        c.theme = prefs.getInt("theme_" + c.id, Ornate.THEME_DEFAULT);
+        if (s == null) return;
+        try {
+            String[] p = s.split(",");
+            c.x = Float.parseFloat(p[0]);
+            c.y = Float.parseFloat(p[1]);
+            c.size = Float.parseFloat(p[2]);
+            c.hidden = p[3].equals("1");
+        } catch (Exception ignored) {
+        }
+    }
+
+    private void saveAll() {
+        SharedPreferences.Editor e = prefs.edit();
+        for (Ctl c : ctls) {
+            e.putString("ctl_" + c.id, c.x + "," + c.y + "," + c.size + "," + (c.hidden ? "1" : "0"));
+            e.putInt("theme_" + c.id, c.theme);
+        }
+        e.putFloat("opacity", opacity);
+        e.apply();
+    }
