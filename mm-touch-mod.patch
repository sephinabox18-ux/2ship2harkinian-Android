+
+    // ------------------------------------------------------------------ icons
+    static final int ICON_NONE = 0, ICON_SWORD = 1, ICON_SHIELD = 2, ICON_RUN = 3, ICON_JUMP = 4, ICON_TARGET = 5,
+            ICON_MAP = 6, ICON_DOTS = 7, ICON_FAIRY = 8, ICON_HAND = 9, ICON_SAVE = 10, ICON_LOAD = 11, ICON_PLUS = 12,
+            ICON_POUND = 13, ICON_BOLT = 14, ICON_BUBBLE = 15, ICON_BEAM = 16;
+
+    /** Cream-coloured vector icon with a soft dark shadow, drawn to fit the view. */
+    static final class IconView extends View {
+        private int icon;
+        private final Paint fill = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final Paint stroke = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final Paint accent = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final Path p = new Path();
+
+        IconView(Context ctx, int icon) {
+            super(ctx);
+            this.icon = icon;
+            fill.setColor(CREAM);
+            stroke.setColor(CREAM);
+            stroke.setStyle(Paint.Style.STROKE);
+            stroke.setStrokeCap(Paint.Cap.ROUND);
+            stroke.setStrokeJoin(Paint.Join.ROUND);
+            accent.setStyle(Paint.Style.STROKE);
+            accent.setColor(Color.rgb(40, 90, 80));
+        }
+
+        void setIcon(int icon) {
+            if (this.icon != icon) {
