+    // ---------------------------------------------------------------- item icons
+    private Bitmap iconFor(int item) {
+        if (item < 0 || item >= 255) return null;
+        if (iconCache.containsKey(item)) return iconCache.get(item);
+        int[] data = act.nativeMmGetItemIcon(item);
+        if (data == null) return null; // still loading, ask again next poll
+        Bitmap bmp = null;
+        if (data.length > 2) {
+            int w = data[0], h = data[1];
+            Bitmap raw = Bitmap.createBitmap(data, 2, w, w, h, Bitmap.Config.ARGB_8888);
+            bmp = Bitmap.createScaledBitmap(raw, w * 4, h * 4, false); // keep the crisp N64 pixel look
+        }
+        iconCache.put(item, bmp);
+        return bmp;
+    }
+
+    private void updateCIcons() {
+        int[] items = act.nativeMmGetCItems();
+        if (items == null) return;
+        int[] masks = { N64_CLEFT, N64_CDOWN, N64_CRIGHT };
+        for (Ctl c : ctls) {
+            if (c.icon == null) continue;
+            int slot = c.value == N64_CLEFT ? 0 : (c.value == N64_CDOWN ? 1 : 2);
+            int item = items[slot];
+            if (items.length >= 9 && c.ammo != null) {
+                int count = items[3 + slot];
+                if (count >= 0 && item != 255) {
+                    c.ammo.setText(String.valueOf(count));
+                    c.ammo.setTextColor(items[6 + slot] != 0 ? Color.rgb(120, 230, 120) : Color.WHITE);
+                    c.ammo.setTextSize(TypedValue.COMPLEX_UNIT_PX, dp(c.size) * 0.2f);
+                    c.ammo.setVisibility(View.VISIBLE);
+                } else {
+                    c.ammo.setVisibility(View.GONE);
+                }
+            }
+            if (item == c.shownItem && !(item != 255 && !iconCache.containsKey(item))) continue;
+            Bitmap bmp = iconFor(item);
+            if (bmp == null && item != 255 && !iconCache.containsKey(item)) continue; // not loaded yet
+            c.shownItem = item;
+            if (bmp != null) {
+                c.icon.setImageBitmap(bmp);
+                c.icon.setVisibility(View.VISIBLE);
+                c.text.setVisibility(View.GONE);
+            } else {
+                c.icon.setVisibility(View.GONE);
+                c.text.setVisibility(View.VISIBLE);
+            }
+        }
+    }
