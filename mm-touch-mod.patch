+    // ------------------------------------------------------------------ building views
+    private void buildCtl(Ctl c) {
+        FrameLayout v = new FrameLayout(act);
+        if (c.kind == KIND_SKIP) {
+            GradientDrawable bg = panelDrawable();
+            bg.setCornerRadius(dp(40));
+            v.setBackground(bg);
+        } else {
+            v.setBackground(styleFor(c, false));
+        }
+        if (c.kind == KIND_STICK) v.setBackground(new Ornate.StickBaseDrawable());
+        if (c.kind == KIND_MINIMAP) {
+            GradientDrawable box = new GradientDrawable();
+            box.setColor(Color.argb(60, 63, 182, 168));
+            box.setCornerRadius(dp(8));
+            box.setStroke(dp(2), Color.rgb(63, 182, 168), dp(6), dp(4));
+            v.setBackground(box);
+        }
+        TextView t = hudText(14);
+        t.setGravity(Gravity.CENTER);
+        t.setText(c.sub.isEmpty() ? c.label : c.label + "\n" + c.sub);
+        if (c.value == N64_A && c.kind == KIND_N64) {
+            t.setTextColor(Ornate.GOLD_LIGHT);
+            t.setText("A");
+        }
+        v.addView(t, new FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
+        if (c.id.equals("a")) aCtl = c;
+        int iconType = iconFor(c);
+        if (iconType != Ornate.ICON_NONE) {
+            Ornate.IconView iconView = new Ornate.IconView(act, iconType);
+            FrameLayout.LayoutParams iconLp = new FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT);
+            int pad = dp(c.size * 0.22f);
+            iconLp.setMargins(pad, pad, pad, pad);
+            v.addView(iconView, iconLp);
+            t.setVisibility(View.GONE);
+            c.iconView = iconView;
+        }
+        if (c.style == STYLE_C && c.value != N64_CUP && c.kind == KIND_N64) {
+            ImageView iv = new ImageView(act);
+            iv.setScaleType(ImageView.ScaleType.FIT_CENTER);
+            iv.setVisibility(View.GONE);
+            FrameLayout.LayoutParams ilp = new FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT);
+            int pad = dp(c.size * 0.14f);
+            ilp.setMargins(pad, pad, pad, pad);
+            v.addView(iv, ilp);
+            c.icon = iv;
+            // ammo count, bottom-right like the game's own C buttons
