+            float sh = s * 0.02f;
+            fill.setShadowLayer(s * 0.04f, 0, sh, Color.argb(160, 0, 0, 0));
+            stroke.setShadowLayer(s * 0.04f, 0, sh, Color.argb(160, 0, 0, 0));
+            stroke.setStrokeWidth(s * 0.075f);
+            c.save();
+            c.translate(ox, oy);
+            switch (icon) {
+                case ICON_SWORD: sword(c, s); break;
+                case ICON_SHIELD: shield(c, s); break;
+                case ICON_RUN: run(c, s); break;
+                case ICON_JUMP: jump(c, s); break;
+                case ICON_TARGET: target(c, s); break;
+                case ICON_MAP: map(c, s); break;
+                case ICON_DOTS: dots(c, s); break;
+                case ICON_FAIRY: fairy(c, s); break;
+                case ICON_HAND: hand(c, s); break;
+                case ICON_SAVE: save(c, s); break;
+                case ICON_LOAD: load(c, s); break;
+                case ICON_PLUS: plus(c, s); break;
+                case ICON_POUND: pound(c, s); break;
+                case ICON_BOLT: bolt(c, s); break;
+                case ICON_BUBBLE: bubble(c, s); break;
