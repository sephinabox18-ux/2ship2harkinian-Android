+    private void rebuildMapPage(int[] info) {
+        // info: [0]=page [1]=quest [2]=heart pieces [3]=sword [4]=shield [5]=quiver [6]=bombbag [7]=wallet
+        //       [8]=owls [9]=dungeon [10]=map [11]=compass [12]=boss key [13]=keys [14]=fairies
+        StringBuilder key = new StringBuilder();
+        for (int v : info) key.append(v).append(',');
+        if (key.toString().equals(lastMapKey)) return;
+        lastMapKey = key.toString();
+        iconPending = false;
+        mapContent.removeAllViews();
+        int dungeon = info[9];
