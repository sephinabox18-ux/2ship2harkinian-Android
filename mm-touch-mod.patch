index 0000000..6e5147d
--- /dev/null
+++ b/mm/2s2h/Enhancements/Touch/MMTouch.cpp
@@ -0,0 +1,588 @@
+// Majora's Mask touch mod - game side.
+//  Touch buttons -> pad injection, jump, sprint, quick save/load, fast travel map, tap-to-skip cutscenes,
+//  ocarina song auto-play, unlimited diving, and the glue for the quest tracker (MMQuest.c).
+//  Everything the Android overlay asks for is queued and done on the game thread.
+#include <libultraship/bridge/consolevariablebridge.h>
+#include "2s2h/GameInteractor/GameInteractor.h"
+#include "2s2h/ShipInit.hpp"
+#include "2s2h/Enhancements/Saving/SavingEnhancements.h"
+#include <atomic>
+#include <mutex>
+#include <string>
+
+extern "C" {
+#include "variables.h"
+#include "functions.h"
+#include "z64shrink_window.h"
+#include "assets/objects/gameplay_keep/gameplay_keep.h"
+void func_80834DB8(Player* player, PlayerAnimationHeader* anim, f32 speed, PlayState* play);
+s32 Player_TryCsAction(PlayState* play, Player* thisx, PlayerCsAction csAction);
+s32 Player_GetMovementSpeedAndYaw(Player* thisx, f32* outSpeedTarget, s16* outYawTarget, f32 speedMode, PlayState* play);
+void Play_UpdateMain(PlayState* thisx);
+s32 MMQuest_GetStep(void);
+const char* MMQuest_Title(s32 step);
+const char* MMQuest_Text(s32 step);
+const char* MMQuest_Chapter(s32 step);
+void MMQuest_Progress(s32 step, s32* index, s32* count);
+void MMQuest_Update(PlayState* play, s32 trailOn);
+}
+
+#ifdef __ANDROID__
+#include <jni.h>
+#endif
+
+#define CVAR_SPEED_MODE "gCheats.SpeedModifier.Mode"
+#define CVAR_SPEED_VALUE "gCheats.SpeedModifier.Value"
+#define CVAR_JUMP_HEIGHT "gMMTouch.JumpHeight"
+#define CVAR_LONG_DIVES "gMMTouch.LongDives"
+#define CVAR_PRESET_VERSION "gMMTouch.PresetVersion"
+
+enum {
+    ACT_JUMP = 1, ACT_SPRINT = 2, ACT_QUICKSAVE = 3, ACT_QUICKLOAD = 4, ACT_MAP = 5, ACT_SKIP = 6, ACT_TRAIL = 7,
+};
+
+// State bits reported to the overlay
+enum {
+    ST_CAN_SKIP = 1 << 0, ST_OCARINA = 1 << 1, ST_SHOW_QUEST = 1 << 2, ST_SPRINT = 1 << 3, ST_TRAIL = 1 << 4,
+    ST_SKIPPING = 1 << 5,
+};
+
+// ---------------------------------------------------------------- shared state
+extern "C" {
+volatile u32 gMmTouchN64Buttons = 0;
+volatile s32 gMmTouchOverlayActive = 0;
+}
+
+static std::atomic<int> sRequestMask{ 0 };
+static std::atomic<int> sSongRequest{ -1 };
+static std::atomic<int> sStateBits{ 0 };
+static std::atomic<int> sFrameCounter{ 0 };
+static std::mutex sTextMutex;
+static std::string sQuestText;
+static std::string sMessage;
+
+static bool sSprintOn = false;
+static s32 sStoppedFrames = 0;
+static bool sTrailOn = true;
+
+static void PostMessage(const char* msg) {
+    std::lock_guard<std::mutex> lock(sTextMutex);
+    sMessage = msg;
+}
+
+static bool TakeRequest(int act) {
+    int bit = 1 << act;
+    return (sRequestMask.fetch_and(~bit) & bit) != 0;
+}
+
+// ---------------------------------------------------------------- ocarina auto-play
+typedef struct {
+    const char* name;
+    u8 song;
+    u8 quest;
+} SongEntry;
+
+static const SongEntry sAllSongs[] = {
+    { "Song of Time", OCARINA_SONG_TIME, QUEST_SONG_TIME },
+    { "Inverted Song of Time", OCARINA_SONG_INVERTED_TIME, QUEST_SONG_TIME },
+    { "Song of Double Time", OCARINA_SONG_DOUBLE_TIME, QUEST_SONG_TIME },
+    { "Song of Healing", OCARINA_SONG_HEALING, QUEST_SONG_HEALING },
+    { "Epona's Song", OCARINA_SONG_EPONAS, QUEST_SONG_EPONA },
+    { "Song of Soaring", OCARINA_SONG_SOARING, QUEST_SONG_SOARING },
+    { "Song of Storms", OCARINA_SONG_STORMS, QUEST_SONG_STORMS },
+    { "Sonata of Awakening", OCARINA_SONG_SONATA, QUEST_SONG_SONATA },
+    { "Goron Lullaby", OCARINA_SONG_GORON_LULLABY, QUEST_SONG_LULLABY },
+    { "Lullaby Intro", OCARINA_SONG_GORON_LULLABY_INTRO, QUEST_SONG_LULLABY_INTRO },
+    { "New Wave Bossa Nova", OCARINA_SONG_NEW_WAVE, QUEST_SONG_BOSSA_NOVA },
+    { "Elegy of Emptiness", OCARINA_SONG_ELEGY, QUEST_SONG_ELEGY },
+    { "Oath to Order", OCARINA_SONG_OATH, QUEST_SONG_OATH },
+};
+#define SONG_COUNT ((s32)(sizeof(sAllSongs) / sizeof(sAllSongs[0])))
+
+static bool SongLearned(s32 i) {
+    if (!CHECK_QUEST_ITEM(sAllSongs[i].quest)) return false;
+    if ((sAllSongs[i].song == OCARINA_SONG_GORON_LULLABY_INTRO) && CHECK_QUEST_ITEM(QUEST_SONG_LULLABY)) return false;
+    return true;
+}
+
+static const u16 sNoteButtons[] = { BTN_A, BTN_CDOWN, BTN_CRIGHT, BTN_CLEFT, BTN_CUP };
+#define NOTE_HOLD 3
+#define NOTE_GAP 2
+static s32 sSeqSong = -1, sSeqNote = 0, sSeqTimer = 0;
+
+// Called by padmgr.c once per frame for controller 1: buttons to add to the pad.
+extern "C" u32 MMMod_TouchButtons(void) {
+    u32 buttons = gMmTouchN64Buttons;
+    int req = sSongRequest.exchange(-1);
+
+    if ((req >= 0) && (req < SONG_COUNT)) {
+        sSeqSong = sAllSongs[req].song;
+        sSeqNote = 0;
+        sSeqTimer = 0;
+    }
+    if (sSeqSong >= 0) {
+        OcarinaSongButtons* notes = &gOcarinaSongButtons[sSeqSong];
+        if ((gPlayState == nullptr) || (gPlayState->msgCtx.msgMode != MSGMODE_OCARINA_PLAYING) ||
+            (sSeqNote >= notes->numButtons)) {
+            sSeqSong = -1;
+        } else {
+            s32 t = sSeqTimer++;
+            if (t < NOTE_HOLD) {
+                u8 idx = notes->buttonIndex[sSeqNote];
+                if (idx < 5) buttons |= sNoteButtons[idx];
+            } else if (t >= NOTE_HOLD + NOTE_GAP - 1) {
+                sSeqNote++;
+                sSeqTimer = 0;
+            }
+        }
+    }
+    return buttons;
+}
+
+// ---------------------------------------------------------------- jump / sprint
+static void SetSprint(bool on) {
+    sSprintOn = on;
+    sStoppedFrames = 0;
+    CVarSetInteger(CVAR_SPEED_MODE, on ? 1 : 0);
+    ShipInit::Init(CVAR_SPEED_MODE);
+}
+
+static bool CanJump(Player* player) {
+    if (player == nullptr || gPlayState == nullptr) return false;
+    if ((player->transformation != PLAYER_FORM_HUMAN) && (player->transformation != PLAYER_FORM_FIERCE_DEITY)) return false;
+    if (!(player->actor.bgCheckFlags & BGCHECKFLAG_GROUND)) return false;
+    if (player->stateFlags1 & (PLAYER_STATE1_TALKING | PLAYER_STATE1_DEAD | PLAYER_STATE1_CARRYING_ACTOR |
+                               PLAYER_STATE1_2000 | PLAYER_STATE1_4000 | PLAYER_STATE1_100000 |
+                               PLAYER_STATE1_800000 | PLAYER_STATE1_8000000 | PLAYER_STATE1_20000000 |
+                               PLAYER_STATE1_80000000)) {
+        return false;
+    }
+    if (gPlayState->msgCtx.msgMode != MSGMODE_NONE) return false;
+    if (Player_InCsMode(gPlayState)) return false;
+    return true;
+}
+
+static void OnPlayerInputs(Input* input) {
+    Player* player = GET_PLAYER(gPlayState);
+
+    if (TakeRequest(ACT_JUMP) && CanJump(player)) {
+        func_80834DB8(player, (PlayerAnimationHeader*)&gPlayerAnim_link_normal_run_jump,
+                      CVarGetFloat(CVAR_JUMP_HEIGHT, 8.0f), gPlayState);
+    }
+    if (sSprintOn && player != nullptr) {
+        if (player->speedXZ < 0.5f) {
+            if (++sStoppedFrames > 8) SetSprint(false);
+        } else {
+            sStoppedFrames = 0;
+        }
+    }
+}
+
+// ---------------------------------------------------------------- unlimited diving (called from z_player.c)
+extern "C" s32 MMMod_LongDive(void) {
+    return CVarGetInteger(CVAR_LONG_DIVES, 1);
+}
+
+extern "C" void MMMod_DiveSteer(Player* player, PlayState* play) {
+    f32 speedTarget;
+    s16 yawTarget;
+    if (!MMMod_LongDive()) return;
+    player->underwaterTimer = 0;
+    if ((player->actor.bgCheckFlags & BGCHECKFLAG_GROUND) && (player->actor.velocity.y < 0.0f)) {
+        player->actor.velocity.y = 0.0f;
+    }
+    Player_GetMovementSpeedAndYaw(player, &speedTarget, &yawTarget, 0.0f, play);
+    Math_StepToF(&player->speedXZ, speedTarget * 0.45f, 0.5f);
+    if (speedTarget > 0.0f) {
+        Math_ScaledStepToS(&player->yaw, yawTarget, 0x300);
+        player->actor.shape.rot.y = player->yaw;
+    }
+}
+
+// ---------------------------------------------------------------- quick save / quick load
+typedef struct {
+    Save save;
+    u8 eventInf[8];
+    CycleSceneFlags cycleSceneFlags[120];
+} QuickSnapshot;
+
+static QuickSnapshot* sSnap = nullptr;
+static bool sHaveSnap = false;
+static bool sPendingLoad = false;
+
+static bool CanQuickSave(PlayState* play) {
+    if (gSaveContext.gameMode != GAMEMODE_NORMAL) return false;
+    if (gSaveContext.fileNum == 0xFF) return false;
+    if (IS_PAUSED(&play->pauseCtx) || (play->msgCtx.msgMode != MSGMODE_NONE)) return false;
+    if ((play->transitionTrigger != TRANS_TRIGGER_OFF) || (play->transitionMode != TRANS_MODE_OFF)) return false;
+    if (Play_InCsMode(play) || (gSaveContext.save.cutsceneIndex >= 0xFFF0)) return false;
+    if (gSaveContext.minigameStatus != MINIGAME_STATUS_END) return false;
+    if ((gSaveContext.timerStates[TIMER_ID_MINIGAME_1] != TIMER_STATE_OFF) ||
+        (gSaveContext.timerStates[TIMER_ID_MINIGAME_2] != TIMER_STATE_OFF)) {
+        return false;
+    }
+    if (play->gameOverCtx.state != GAMEOVER_INACTIVE) return false;
+    return true;
+}
+
+static void SaveToDisk(PlayState* play) {
+    if (!SavingEnhancements_CanSave()) return;
+    // Same steps 2 Ship's autosave uses: an owl-style save of the current area.
+    bool currentOwlSaveState = gSaveContext.save.isOwlSave;
+    gSaveContext.save.isOwlSave = true;
+    SavingEnhancements_PersistSaveEntranceInfo();
+    SavingEnhancements_AdvancePlaytime();
+    Play_SaveCycleSceneFlags(play);
+    gSaveContext.save.saveInfo.playerData.savedSceneId = play->sceneId;
+    func_8014546C(&play->sramCtx);
+    Sram_SetFlashPagesOwlSave(&play->sramCtx, gFlashOwlSaveStartPages[gSaveContext.fileNum * FLASH_SAVE_MAIN_MULTIPLIER],
+                              gFlashOwlSaveNumPages[gSaveContext.fileNum * FLASH_SAVE_MAIN_MULTIPLIER]);
+    Sram_StartWriteToFlashOwlSave(&play->sramCtx);
+    gSaveContext.save.isOwlSave = currentOwlSaveState;
+    SavingEnhancements_ClearSaveEntranceInfo();
+}
+
+static void QuickSave(PlayState* play) {
+    if (!CanQuickSave(play)) {
+        Audio_PlaySfx(NA_SE_SY_ERROR);
+        PostMessage("Can't quick save right now");
+        return;
+    }
+    if (sSnap == nullptr) sSnap = new QuickSnapshot();
+    Play_SaveCycleSceneFlags(play);
+    memcpy(&sSnap->save, &gSaveContext.save, sizeof(Save));
+    memcpy(sSnap->eventInf, gSaveContext.eventInf, sizeof(sSnap->eventInf));
+    memcpy(sSnap->cycleSceneFlags, gSaveContext.cycleSceneFlags, sizeof(sSnap->cycleSceneFlags));
+    sHaveSnap = true;
+    SaveToDisk(play);
+    Audio_PlaySfx(NA_SE_SY_DECIDE);
+    PostMessage("Quick saved");
+}
+
+static void QuickLoad(PlayState* play) {
+    if (!sHaveSnap) {
+        Audio_PlaySfx(NA_SE_SY_ERROR);
+        PostMessage("No quick save yet");
+        return;
+    }
+    if ((gSaveContext.gameMode != GAMEMODE_NORMAL) || IS_PAUSED(&play->pauseCtx) ||
+        (play->transitionTrigger != TRANS_TRIGGER_OFF) || (play->transitionMode != TRANS_MODE_OFF) ||
+        (play->gameOverCtx.state != GAMEOVER_INACTIVE)) {
+        Audio_PlaySfx(NA_SE_SY_ERROR);
+        PostMessage("Can't quick load right now");
+        return;
+    }
+    sPendingLoad = true;
+    gSaveContext.respawnFlag = 0;
+    gSaveContext.nextCutsceneIndex = 0;
+    play->nextEntrance = sSnap->save.entrance;
+    play->transitionTrigger = TRANS_TRIGGER_START;
+    play->transitionType = TRANS_TYPE_FADE_BLACK;
+    PostMessage("Quick loading...");
+}
+
+// Called at the start of Play_Init (z_play.c): apply a pending quick load before the area is built.
+extern "C" void MMMod_OnPlayInit(void) {
+    if (!sPendingLoad || !sHaveSnap) return;
+    sPendingLoad = false;
+    memcpy(&gSaveContext.save, &sSnap->save, sizeof(Save));
+    memcpy(gSaveContext.eventInf, sSnap->eventInf, sizeof(sSnap->eventInf));
+    memcpy(gSaveContext.cycleSceneFlags, sSnap->cycleSceneFlags, sizeof(sSnap->cycleSceneFlags));
+}
+
+// ---------------------------------------------------------------- fast travel map (owl statues)
+static bool sFastTravelOpen = false;
+
+static bool CanOpenFastTravel(PlayState* play) {
+    Player* player = GET_PLAYER(play);
+    if (player == nullptr) return false;
+    if (gSaveContext.gameMode != GAMEMODE_NORMAL) return false;
+    if (IS_PAUSED(&play->pauseCtx) || (play->gameOverCtx.state != GAMEOVER_INACTIVE)) return false;
+    if ((play->transitionTrigger != TRANS_TRIGGER_OFF) || (play->transitionMode != TRANS_MODE_OFF)) return false;
+    if (Play_InCsMode(play) || (play->msgCtx.msgMode != MSGMODE_NONE)) return false;
+    if (play->msgCtx.ocarinaMode != OCARINA_MODE_NONE) return false;
+    if (play->interfaceCtx.restrictions.songOfSoaring != 0) return false;
+    if (Map_CurRoomHasMapI(play) || (play->sceneId == SCENE_SECOM)) return false;
+    if (gSaveContext.save.saveInfo.playerData.owlActivationFlags == 0) return false;
+    if (!(player->actor.bgCheckFlags & BGCHECKFLAG_GROUND)) return false;
+    if (player->stateFlags1 & (PLAYER_STATE1_8000000 | PLAYER_STATE1_800000 | PLAYER_STATE1_CARRYING_ACTOR |
+                               PLAYER_STATE1_TALKING | PLAYER_STATE1_DEAD)) {
+        return false;
+    }
+    return true;
+}
+
+static void OpenOwlMap(PlayState* play) {
+    PauseContext* pauseCtx = &play->pauseCtx;
+    pauseCtx->unk_2C8 = pauseCtx->pageIndex;
+    pauseCtx->unk_2CA = pauseCtx->cursorPoint[4];
+    pauseCtx->pageIndex = PAUSE_ITEM;
+    pauseCtx->state = PAUSE_STATE_OWL_WARP_0;
+    func_800F4A10(play);
+    pauseCtx->pageIndex = PAUSE_MAP;
+    play->msgCtx.ocarinaMode = OCARINA_MODE_END;
+    gSaveContext.prevHudVisibility = HUD_VISIBILITY_A_B;
+    Interface_SetBButtonInterfaceDoAction(play, DO_ACTION_STOP);
+    GameState_SetFramerateDivisor(&play->state, 2);
+    if (ShrinkWindow_Letterbox_GetSizeTarget() != 0) {
+        ShrinkWindow_Letterbox_SetSizeTarget(0);
+    }
+    Audio_PlaySfx_PauseMenuOpenOrClose(1);
+    sFastTravelOpen = true;
+}
+
+static void FinishFastTravel(PlayState* play) {
+    Player* player = GET_PLAYER(play);
+    u16 mode = play->msgCtx.ocarinaMode;
+    sFastTravelOpen = false;
+    if ((mode >= OCARINA_MODE_WARP_TO_GREAT_BAY_COAST) && (mode <= OCARINA_MODE_WARP_TO_ENTRANCE) && (player != nullptr)) {
+        Actor* actor = Actor_Spawn(&play->actorCtx, play, ACTOR_EN_TEST7, player->actor.world.pos.x,
+                                   player->actor.world.pos.y, player->actor.world.pos.z, 0, 0, 0, mode);
+        if (actor != nullptr) {
+            player->stateFlags1 &= ~PLAYER_STATE1_20000000;
+            player->csAction = PLAYER_CSACTION_NONE;
+            Player_TryCsAction(play, NULL, PLAYER_CSACTION_19);
+            player->stateFlags1 |= PLAYER_STATE1_10000000 | PLAYER_STATE1_20000000;
+            return;
+        }
+    }
+    play->msgCtx.ocarinaMode = OCARINA_MODE_NONE;
+}
+
+// ---------------------------------------------------------------- tap to skip cutscenes
+static bool IsChoiceOrInputBox(MessageContext* msgCtx) {
+    switch (msgCtx->textboxEndType) {
+        case TEXTBOX_ENDTYPE_TWO_CHOICE:
+        case TEXTBOX_ENDTYPE_THREE_CHOICE:
+        case TEXTBOX_ENDTYPE_12:
+        case TEXTBOX_ENDTYPE_INPUT_BANK:
+        case TEXTBOX_ENDTYPE_INPUT_DOGGY_RACETRACK_BET:
+        case TEXTBOX_ENDTYPE_INPUT_BOMBER_CODE:
+        case TEXTBOX_ENDTYPE_INPUT_LOTTERY_CODE:
+        case TEXTBOX_ENDTYPE_64:
+            return true;
+        default:
+            return false;
+    }
+}
+
+static bool InCutscene(PlayState* play) {
+    return (play->csCtx.state != CS_STATE_IDLE) || (CutsceneManager_GetCurrentCsId() != CS_ID_NONE);
+}
+
+static bool BaseSkippable(PlayState* play) {
+    if (gSaveContext.gameMode != GAMEMODE_NORMAL) return false;
+    if (IS_PAUSED(&play->pauseCtx)) return false;
+    if ((play->transitionTrigger != TRANS_TRIGGER_OFF) || (play->transitionMode != TRANS_MODE_OFF)) return false;
+    if (play->msgCtx.ocarinaMode != OCARINA_MODE_NONE) return false;
+    if ((play->msgCtx.msgMode != MSGMODE_NONE) && IsChoiceOrInputBox(&play->msgCtx)) return false;
+    return true;
+}
+
+static bool CanStartSkip(PlayState* play) {
+    Player* player = GET_PLAYER(play);
+    if (!BaseSkippable(play)) return false;
+    if ((player != nullptr) && (player->stateFlags1 & PLAYER_STATE1_TALKING)) return false;
+    if (play->csCtx.state != CS_STATE_IDLE) return true;
+    return (CutsceneManager_GetCurrentCsId() != CS_ID_NONE) && (play->msgCtx.msgMode == MSGMODE_NONE);
+}
+
+static bool sSkipping = false;
+static s32 sSkipBudget = 0;
+static u32 sSkipTick = 0;
+static s32 sSkipVisibleFrames = 0;
+
+static void RunSkip(PlayState* play) {
+    for (s32 i = 0; i < 90; i++) {
+        if (!play->state.running || !BaseSkippable(play) || !InCutscene(play) || (sSkipBudget-- <= 0)) {
+            sSkipping = false;
+            return;
+        }
+        Input* input = CONTROLLER1(&play->state);
+        u16 saved = input->press.button;
+        bool inject = (play->msgCtx.msgMode != MSGMODE_NONE) && ((sSkipTick++ & 1) == 0);
+        if (inject) input->press.button |= BTN_B; // advance cutscene text
+        Play_UpdateMain(play);
+        if (inject) input->press.button = saved;
+    }
+}
+
+// ---------------------------------------------------------------- per-frame (end of Play_Update, z_play.c)
+static s32 sLastStep = -1;
+
+extern "C" void MMMod_AfterPlayUpdate(PlayState* play) {
+    int bits = 0;
+    sFrameCounter++;
+
+    if (sFastTravelOpen && !IS_PAUSED(&play->pauseCtx)) FinishFastTravel(play);
+
+    if (TakeRequest(ACT_SPRINT)) SetSprint(!sSprintOn);
+    if (TakeRequest(ACT_TRAIL)) {
+        sTrailOn = !sTrailOn;
+        PostMessage(sTrailOn ? "Tatl's trail on" : "Tatl's trail off");
+    }
+    if (TakeRequest(ACT_QUICKSAVE)) QuickSave(play);
+    if (TakeRequest(ACT_QUICKLOAD)) QuickLoad(play);
+    if (TakeRequest(ACT_MAP)) {
+        if (CanOpenFastTravel(play)) {
+            OpenOwlMap(play);
+        } else {
+            Audio_PlaySfx(NA_SE_SY_ERROR);
+            PostMessage(gSaveContext.save.saveInfo.playerData.owlActivationFlags == 0
+                            ? "Hit an owl statue with your sword to unlock fast travel"
+                            : "Can't fast travel from here");
+        }
+    }
+
+    // Cutscene skipping
+    if (sSkipping) {
+        RunSkip(play);
+    } else if (CanStartSkip(play)) {
+        if (sSkipVisibleFrames < 8) sSkipVisibleFrames++; // ignore one-frame camera moments
+        if (TakeRequest(ACT_SKIP) && (sSkipVisibleFrames >= 8)) {
+            sSkipping = true;
+            sSkipBudget = 4000;
+        }
+    } else {
+        sSkipVisibleFrames = 0;
+        TakeRequest(ACT_SKIP);
+    }
+
+    // Quest tracker + Tatl trail
+    if (gSaveContext.gameMode == GAMEMODE_NORMAL) {
+        MMQuest_Update(play, sTrailOn);
+        s32 step = MMQuest_GetStep();
+        if (step != sLastStep) {
+            sLastStep = step;
+            s32 idx, count;
+            MMQuest_Progress(step, &idx, &count);
+            std::string t = std::string("Main quest \u00B7 ") + MMQuest_Chapter(step) + " \u00B7 " + std::to_string(idx) +
+                            "/" + std::to_string(count) + "\n" + MMQuest_Title(step) + "\n" + MMQuest_Text(step);
+            std::lock_guard<std::mutex> lock(sTextMutex);
+            sQuestText = t;
+        }
+    }
+
+    if (sSkipVisibleFrames >= 8 && !sSkipping) bits |= ST_CAN_SKIP;
+    if (sSkipping) bits |= ST_SKIPPING;
+    if (play->msgCtx.msgMode == MSGMODE_OCARINA_PLAYING) {
+        for (s32 i = 0; i < SONG_COUNT; i++) {
+            if (SongLearned(i)) {
+                bits |= ST_OCARINA;
+                break;
+            }
+        }
+    }
+    if ((gSaveContext.gameMode == GAMEMODE_NORMAL) && !IS_PAUSED(&play->pauseCtx) &&
+        (play->msgCtx.msgMode == MSGMODE_NONE) && !InCutscene(play) && !Play_InCsMode(play)) {
+        bits |= ST_SHOW_QUEST;
+    }
+    if (sSprintOn) bits |= ST_SPRINT;
+    if (sTrailOn) bits |= ST_TRAIL;
+    sStateBits = bits;
+}
+
+// ---------------------------------------------------------------- defaults (applied once)
+static void ApplyTouchCameraPreset() {
+    // Tuned for the swipe camera on a phone: camera can't dip into the ground, and a comfortable turn speed.
+    CVarSetFloat("gEnhancements.Camera.FreeLook.MinPitch", -10.0f);
+    CVarSetFloat("gEnhancements.Camera.RightStick.CameraSensitivity.X", 2.0f);
+    CVarSetFloat("gEnhancements.Camera.RightStick.CameraSensitivity.Y", 1.2f);
+    CVarSetInteger("gEnhancements.Camera.RightStick.InvertYAxis", 0);
+}
+
+static void ApplyPresetOnce() {
+    s32 version = CVarGetInteger(CVAR_PRESET_VERSION, 0);
+    if (version >= 3) return;
+    if (version == 0) {
+        CVarSetInteger("gEnhancements.Camera.FreeLook.Enable", 1);
+        CVarSetInteger("gEnhancements.Masks.FastTransformation", 1);
+        CVarSetInteger("gEnhancements.Timesavers.FasterSceneTransitions", 1);
+        CVarSetInteger("gEnhancements.Songs.PauseOwlWarp", 1);
+        CVarSetInteger("gEnhancements.Cutscenes.SkipEntranceCutscenes", 1);
+        CVarSetInteger("gEnhancements.Cutscenes.SkipOnePointCutscenes", 1);
+        CVarSetInteger("gEnhancements.Songs.SkipSoaringCutscene", 1);
+        CVarSetInteger("gEnhancements.Songs.FasterSongPlayback", 1);
+        CVarSetFloat(CVAR_SPEED_VALUE, 1.6f);
+        CVarSetInteger(CVAR_SPEED_MODE, 0);
+    }
+    if (version < 2) {
+        // bigger 2 Ship menu for fingers (takes effect next time the app starts)
+        CVarSetFloat("gSettings.Menu.AndroidScale", 1.8f);
+    }
+    if (version < 3) {
+        ApplyTouchCameraPreset();
+    }
+    CVarSetInteger(CVAR_PRESET_VERSION, 3);
+    CVarSave();
+    ShipInit::Init("*");
+}
+
+void RegisterMMTouch() {
+    static bool hookRegistered = false;
+    if (!hookRegistered) {
+        hookRegistered = true;
+        GameInteractor::Instance->RegisterGameHook<GameInteractor::OnPassPlayerInputs>(OnPlayerInputs);
+    }
+    ApplyPresetOnce();
+}
+
+static RegisterShipInitFunc initFunc(RegisterMMTouch, {});
+
+// ---------------------------------------------------------------- JNI (MainActivity / ModTouchOverlay)
+#ifdef __ANDROID__
+static jstring MakeJString(JNIEnv* env, const std::string& s) {
+    return env->NewStringUTF(s.c_str());
+}
+
+extern "C" JNIEXPORT void JNICALL Java_com_twoshipfork_mm_MainActivity_nativeMmSetN64Button(JNIEnv*, jobject, jint mask,
+                                                                                           jboolean down) {
+    if (down) {
+        gMmTouchN64Buttons |= (u32)mask;
+    } else {
+        gMmTouchN64Buttons &= ~(u32)mask;
+    }
+}
+
+extern "C" JNIEXPORT void JNICALL Java_com_twoshipfork_mm_MainActivity_nativeMmSetOverlayActive(JNIEnv*, jobject,
+                                                                                               jboolean active) {
+    gMmTouchOverlayActive = active ? 1 : 0;
+    if (!active) gMmTouchN64Buttons = 0;
+}
+
+extern "C" JNIEXPORT void JNICALL Java_com_twoshipfork_mm_MainActivity_nativeMmAction(JNIEnv*, jobject, jint action) {
+    if ((action > 0) && (action < 31)) sRequestMask.fetch_or(1 << action);
+}
+
+// Low byte..: state bits; upper 32 bits: frame counter (lets the overlay notice when gameplay isn't running)
+extern "C" JNIEXPORT jlong JNICALL Java_com_twoshipfork_mm_MainActivity_nativeMmGetState(JNIEnv*, jobject) {
+    return ((jlong)(unsigned)sFrameCounter.load() << 32) | (jlong)(unsigned)sStateBits.load();
+}
+
+extern "C" JNIEXPORT jstring JNICALL Java_com_twoshipfork_mm_MainActivity_nativeMmGetQuest(JNIEnv* env, jobject) {
+    std::lock_guard<std::mutex> lock(sTextMutex);
+    return MakeJString(env, sQuestText);
+}
+
+extern "C" JNIEXPORT jstring JNICALL Java_com_twoshipfork_mm_MainActivity_nativeMmPollMessage(JNIEnv* env, jobject) {
+    std::lock_guard<std::mutex> lock(sTextMutex);
+    std::string m = sMessage;
+    sMessage.clear();
+    return MakeJString(env, m);
+}
+
+// "index:name" entries separated by '\n' for songs the player has learned
+extern "C" JNIEXPORT jstring JNICALL Java_com_twoshipfork_mm_MainActivity_nativeMmGetSongs(JNIEnv* env, jobject) {
+    std::string out;
+    for (s32 i = 0; i < SONG_COUNT; i++) {
+        if (SongLearned(i)) {
+            out += std::to_string(i) + ":" + sAllSongs[i].name + "\n";
+        }
+    }
+    return MakeJString(env, out);
+}
+
+extern "C" JNIEXPORT void JNICALL Java_com_twoshipfork_mm_MainActivity_nativeMmPlaySong(JNIEnv*, jobject, jint index) {
+    sSongRequest = index;
+}
+#endif
