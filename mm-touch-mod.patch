diff --git a/Android/app/src/main/java/com/twoshipfork/mm/CrashExport.java b/Android/app/src/main/java/com/twoshipfork/mm/CrashExport.java
new file mode 100644
index 0000000..b6c94da
--- /dev/null
+++ b/Android/app/src/main/java/com/twoshipfork/mm/CrashExport.java
@@ -0,0 +1,133 @@
+package com.twoshipfork.mm;
+
+import android.content.ContentValues;
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.net.Uri;
+import android.os.Build;
+import android.os.Environment;
+import android.provider.MediaStore;
+import android.util.Log;
+import android.widget.Toast;
+
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.OutputStream;
+import java.nio.charset.StandardCharsets;
+import java.text.SimpleDateFormat;
+import java.util.Date;
+import java.util.Locale;
+
+/**
+ * After a crash, 2 Ship writes its reports into the app's own folder, which the Files app often can't see.
+ * On the next launch this copies any new report (plus the mod's breadcrumbs) into Downloads as one text file.
+ */
+final class CrashExport {
+    private static final String PREFS = "com.twoshipfork.mm.crashexport";
+    private static final String[] REPORTS = { "2ship-last-exit.txt", "2ship-java-crash.txt", "2ship-native-crash.txt" };
+
+    private CrashExport() {
+    }
+
+    static void runInBackground(MainActivity act) {
+        new Thread(() -> {
+            try {
+                run(act);
+            } catch (Throwable t) {
+                Log.e("MMTouch", "crash export", t);
+            }
+        }, "mm-crash-export").start();
+    }
+
+    private static void run(MainActivity act) throws Exception {
+        File dir = AndroidCrashReporter.getNativeReportFile().getParentFile();
+        if (dir == null) return;
+        SharedPreferences prefs = act.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+        long lastExported = prefs.getLong("lastExported", 0L);
+
+        StringBuilder out = new StringBuilder();
+        long newest = lastExported;
+        for (String name : REPORTS) {
+            File f = new File(dir, name);
+            if (f.exists() && f.lastModified() > lastExported) {
+                out.append("===== ").append(name).append(" =====\n").append(readText(f, 200_000)).append("\n\n");
+                newest = Math.max(newest, f.lastModified());
+            }
+        }
+        File trace = new File(dir, "2ship-last-exit-trace.bin");
+        if (out.length() > 0 && trace.exists() && trace.lastModified() > lastExported) {
+            out.append("===== native trace (readable parts) =====\n").append(printableStrings(trace, 300_000)).append("\n\n");
+        }
+        if (out.length() == 0) return; // nothing new
+
+        String crumbsPath = act.nativeMmGetBreadcrumbPath();
+        if (crumbsPath != null) {
+            File crumbs = new File(crumbsPath);
+            if (crumbs.exists()) out.append("===== mod breadcrumbs =====\n").append(readText(crumbs, 50_000)).append('\n');
+        }
+
+        String fileName = "MajoraMod-crash-" + new SimpleDateFormat("yyyyMMdd-HHmmss", Locale.US).format(new Date()) + ".txt";
+        boolean saved = writeToDownloads(act, fileName, out.toString());
+        prefs.edit().putLong("lastExported", newest).apply();
+        String msg = saved ? "Crash report saved to Downloads: " + fileName : "Crash report saved in the game folder";
+        act.runOnUiThread(() -> Toast.makeText(act, msg, Toast.LENGTH_LONG).show());
+    }
+
+    private static boolean writeToDownloads(Context ctx, String name, String text) {
+        try {
+            byte[] bytes = text.getBytes(StandardCharsets.UTF_8);
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
+                ContentValues values = new ContentValues();
+                values.put(MediaStore.MediaColumns.DISPLAY_NAME, name);
+                values.put(MediaStore.MediaColumns.MIME_TYPE, "text/plain");
+                values.put(MediaStore.MediaColumns.RELATIVE_PATH, Environment.DIRECTORY_DOWNLOADS);
+                Uri uri = ctx.getContentResolver().insert(MediaStore.Downloads.EXTERNAL_CONTENT_URI, values);
+                if (uri == null) return false;
+                try (OutputStream os = ctx.getContentResolver().openOutputStream(uri)) {
+                    if (os == null) return false;
+                    os.write(bytes);
+                }
+                return true;
+            }
+            File dl = ctx.getExternalFilesDir(Environment.DIRECTORY_DOWNLOADS);
+            if (dl == null) return false;
+            try (OutputStream os = new java.io.FileOutputStream(new File(dl, name))) {
+                os.write(bytes);
+            }
+            return false;
+        } catch (Exception e) {
+            Log.e("MMTouch", "write crash report", e);
+            return false;
+        }
+    }
+
+    private static String readText(File f, int max) {
+        try (FileInputStream in = new FileInputStream(f)) {
+            byte[] buf = new byte[(int) Math.min(max, f.length())];
+            int n = in.read(buf);
+            return n > 0 ? new String(buf, 0, n, StandardCharsets.UTF_8) : "";
+        } catch (Exception e) {
+            return "(could not read " + f.getName() + ")";
+        }
+    }
+
+    // The trace file is binary; keep the readable text in it (function names, addresses, messages).
+    private static String printableStrings(File f, int max) {
+        StringBuilder sb = new StringBuilder();
+        StringBuilder run = new StringBuilder();
+        try (FileInputStream in = new FileInputStream(f)) {
+            int b;
+            while ((b = in.read()) != -1 && sb.length() < max) {
+                if (b >= 32 && b < 127) {
+                    run.append((char) b);
+                } else {
+                    if (run.length() >= 6) sb.append(run).append('\n');
+                    run.setLength(0);
+                }
+            }
+        } catch (Exception e) {
+            sb.append("(could not read trace)");
+        }
+        return sb.toString();
+    }
+}
diff --git a/Android/app/src/main/java/com/twoshipfork/mm/HudBarView.java b/Android/app/src/main/java/com/twoshipfork/mm/HudBarView.java
new file mode 100644
index 0000000..e2b18e6
--- /dev/null
+++ b/Android/app/src/main/java/com/twoshipfork/mm/HudBarView.java
@@ -0,0 +1,247 @@
+package com.twoshipfork.mm;
+
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.LinearGradient;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.graphics.RadialGradient;
+import android.graphics.RectF;
+import android.graphics.Shader;
+import android.graphics.Typeface;
+import android.util.TypedValue;
+import android.view.View;
+
+/**
+ * Classic Zelda-style HUD in the top-left: a row of glossy hearts, a gold-framed magic bar under it,
+ * and a small rupee count + clock line below. Replaces the vanilla hearts/magic/rupees and the big clock.
+ * "unit" (from Edit controls) is the height of one row; the whole HUD is about 2.6 units tall.
+ */
+public class HudBarView extends View {
+    private final Paint heartFill = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint heartEmpty = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint heartEdge = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint heartShine = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint frame = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint frameFill = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint magicFill = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint gem = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint gemEdge = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint text = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint rupee = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Path heart = new Path();
+    private final Path wedge = new Path();
+    private final RectF arc = new RectF();
+    private final RectF r = new RectF();
+
+    // health (1/16 hearts), max health, magic, max magic, rupees, wallet, day, time, flags
+    private int[] hud = new int[9];
+    private float scale = 1f;
+
+    /** MODE_HEARTS = hearts + magic; MODE_INFO = rupees + clock (two separate movable pieces). */
+    public static final int MODE_HEARTS = 0, MODE_INFO = 1;
+    private final int mode;
+
+    public HudBarView(Context c) {
+        this(c, MODE_HEARTS);
+    }
+
+    public HudBarView(Context c, int mode) {
+        super(c);
+        this.mode = mode;
+        heartEmpty.setColor(Color.argb(150, 40, 12, 14));
+        heartEdge.setStyle(Paint.Style.STROKE);
+        heartEdge.setColor(Color.argb(230, 30, 8, 8));
+        heartShine.setColor(Color.argb(110, 255, 255, 255));
+        frame.setStyle(Paint.Style.STROKE);
+        frameFill.setColor(Color.argb(170, 10, 14, 10));
+        gemEdge.setStyle(Paint.Style.STROKE);
+        gemEdge.setColor(Ornate.GOLD_LIGHT);
+        text.setColor(Ornate.CREAM);
+        text.setTypeface(Typeface.create(Typeface.SERIF, Typeface.BOLD));
+        applySizes();
+    }
+
+    /** 1.0 = default size; Edit controls changes this. */
+    public void setScale(float k) {
+        if (Math.abs(k - scale) < 0.01f) return;
+        scale = k;
+        applySizes();
+        invalidate();
+    }
+
+    private void applySizes() {
+        heartEdge.setStrokeWidth(dp(1.4f));
+        frame.setStrokeWidth(dp(2.2f));
+        gemEdge.setStrokeWidth(dp(1f));
+        text.setTextSize(dp(12.5f));
+        text.setShadowLayer(dp(2.5f), 0, dp(1), Color.BLACK);
+    }
+
+    public void setHud(int[] values) {
+        if (values == null || values.length < 9) return;
+        boolean changed = false;
+        for (int i = 0; i < 9; i++) {
+            int v = (i == 7) ? (values[i] * 24 * 60 / 65536) : values[i];
+            int old = (i == 7) ? (hud[i] * 24 * 60 / 65536) : hud[i];
+            if (v != old) changed = true;
+        }
+        hud = values.clone();
+        if (changed) {
+            invalidate();
+            requestLayout();
+        }
+    }
+
+    private float dp(float v) {
+        return scale * TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, v, getResources().getDisplayMetrics());
+    }
+
+    private void heartPath(float cx, float cy, float s) {
+        heart.reset();
+        heart.moveTo(cx, cy + s * 0.5f);
+        heart.cubicTo(cx - s * 1.0f, cy - s * 0.1f, cx - s * 0.5f, cy - s * 0.9f, cx, cy - s * 0.32f);
+        heart.cubicTo(cx + s * 0.5f, cy - s * 0.9f, cx + s * 1.0f, cy - s * 0.1f, cx, cy + s * 0.5f);
+        heart.close();
+    }
+
+    private float heartSize() {
+        return dp(12f);
+    }
+
+    private int maxHearts() {
+        return Math.max(1, hud[1] / 16);
+    }
+
+    // Layout numbers shared by drawing and sizing
+    private float pad() { return dp(4); }
+    private float heartStep() { return heartSize() * 1.7f; }
+    private float heartsTop() { return pad() + heartSize() * 0.62f; }          // centre y of the first row
+    private float heartRowGap() { return heartSize() * 1.85f; }
+    private int heartRows() { return (maxHearts() + 9) / 10; }
+    private float heartsBottom() { return heartsTop() + (heartRows() - 1) * heartRowGap() + heartSize() * 0.5f; }
+    private float magicBarH() { return dp(8); }
+    private float magicLen() { return dp(hud[3] * 1.6f); }
+
+    @Override
+    protected void onDraw(Canvas c) {
+        if (mode == MODE_INFO) {
+            drawInfo(c, getHeight() / 2f + text.getTextSize() * 0.35f);
+            return;
+        }
+        float hs = heartSize();
+        float step = heartStep();
+        float x0 = pad() + hs * 0.78f;
+        int maxHearts = maxHearts();
+
+        // Hearts
+        int health = hud[0];
+        heartEdge.setColor((hud[8] & 1) != 0 ? Color.WHITE : Color.argb(230, 30, 8, 8));
+        for (int i = 0; i < maxHearts; i++) {
+            float cx = x0 + (i % 10) * step;
+            float cy = heartsTop() + (i / 10) * heartRowGap();
+            heartPath(cx, cy, hs);
+            c.drawPath(heart, heartEmpty);
+            heartFill.setShader(new RadialGradient(cx - hs * 0.3f, cy - hs * 0.45f, hs * 1.4f, Color.rgb(255, 110, 100),
+                    Color.rgb(170, 18, 24), Shader.TileMode.CLAMP));
+            int fill = Math.max(0, Math.min(16, health - i * 16));
+            if (fill >= 16) {
+                c.drawPath(heart, heartFill);
+            } else if (fill > 0) {
+                // the game's own rounding: 1-5 = quarter, 6-10 = half, 11-15 = three quarters
+                int quarters = fill <= 5 ? 1 : (fill <= 10 ? 2 : 3);
+                wedge.reset();
+                wedge.moveTo(cx, cy);
+                arc.set(cx - hs * 2, cy - hs * 2, cx + hs * 2, cy + hs * 2);
+                wedge.arcTo(arc, -90f, 90f * quarters);
+                wedge.close();
+                c.save();
+                c.clipPath(wedge);
+                c.drawPath(heart, heartFill);
+                c.restore();
+            }
+            c.drawPath(heart, heartEdge);
+            if (fill > 0) c.drawCircle(cx - hs * 0.42f, cy - hs * 0.38f, hs * 0.16f, heartShine);
+        }
+
+        // Magic: a clear gap under the hearts, gold frame, small gem cap at the left end
+        if (hud[3] > 0) {
+            float barH = magicBarH();
+            float y = heartsBottom() + dp(6);
+            float gs = barH * 0.95f;
+            float gx = pad() + gs * 0.75f;
+            float bl = gx + gs * 0.55f, len = magicLen();
+            r.set(bl, y, bl + len, y + barH);
+            c.drawRoundRect(r, barH / 2, barH / 2, frameFill);
+            float frac = Math.max(0f, Math.min(1f, hud[2] / (float) hud[3]));
+            if (frac > 0) {
+                RectF f = new RectF(bl + dp(1.5f), y + dp(1.5f), bl + dp(1.5f) + (len - dp(3)) * frac, y + barH - dp(1.5f));
+                magicFill.setShader(new LinearGradient(0, f.top, 0, f.bottom, Color.rgb(140, 240, 120), Color.rgb(30, 150, 50),
+                        Shader.TileMode.CLAMP));
+                c.drawRoundRect(f, barH / 2, barH / 2, magicFill);
+            }
+            frame.setShader(new LinearGradient(bl, y, bl, y + barH,
+                    new int[] { Ornate.GOLD_LIGHT, Ornate.GOLD_MID, Ornate.GOLD_DARK }, null, Shader.TileMode.CLAMP));
+            c.drawRoundRect(r, barH / 2, barH / 2, frame);
+            Ornate.drawGem(c, gx, y + barH / 2, gs, gem, gemEdge);
+        }
+    }
+
+    // Rupees + clock on one line
+    private void drawInfo(Canvas c, float ty) {
+        float rx = pad();
+        float g = dp(5.5f);
+        Path p = new Path();
+        p.moveTo(rx + g, ty - g * 2.1f);
+        p.lineTo(rx + 2 * g, ty - g * 1.1f);
+        p.lineTo(rx + g, ty + g * 0.1f);
+        p.lineTo(rx, ty - g * 1.1f);
+        p.close();
+        rupee.setShader(new LinearGradient(rx, ty - g * 2, rx + 2 * g, ty, Color.rgb(140, 245, 150), Color.rgb(20, 140, 60),
+                Shader.TileMode.CLAMP));
+        c.drawPath(p, rupee);
+        float tx = rx + 2 * g + dp(4);
+        boolean full = hud[4] >= hud[5] && hud[5] > 0;
+        text.setColor(full ? Color.rgb(140, 240, 140) : Ornate.CREAM);
+        String rupees = String.valueOf(hud[4]);
+        c.drawText(rupees, tx, ty, text);
+        tx += text.measureText(rupees) + dp(10);
+
+        int minutes = hud[7] * 24 * 60 / 65536;
+        int hr = minutes / 60, mn = minutes % 60;
+        boolean night = (hud[8] & 2) != 0;
+        int hr12 = hr % 12 == 0 ? 12 : hr % 12;
+        int day = Math.max(1, Math.min(3, hud[6]));
+        String clock = (night ? "\u263E " : "\u2600 ") + "Day " + day + " \u00B7 " + hr12 + ":" + (mn < 10 ? "0" : "") + mn
+                + (hr < 12 ? " AM" : " PM");
+        text.setColor(day == 3 && night ? Color.rgb(250, 130, 110) : Ornate.CREAM); // final night: gentle warning
+        c.drawText(clock, tx, ty, text);
+    }
+
+    /** Width this piece needs for the current values. */
+    public int preferredWidth() {
+        if (mode == MODE_INFO) {
+            return (int) (pad() + dp(11) + dp(4) + text.measureText(String.valueOf(Math.max(hud[4], 999))) + dp(10)
+                    + text.measureText("\u263E Day 3 \u00B7 12:00 PM") + pad());
+        }
+        float hs = heartSize();
+        float hearts = pad() + hs * 0.78f + (Math.min(maxHearts(), 10) - 1) * heartStep() + hs * 0.8f + pad();
+        float magic = hud[3] > 0 ? (pad() + magicBarH() * 1.5f + magicLen() + pad()) : 0;
+        return (int) Math.max(hearts, magic);
+    }
+
+    /** Height this piece needs for the current values. */
+    public int preferredHeight() {
+        if (mode == MODE_INFO) return (int) (text.getTextSize() * 1.6f + pad());
+        float h = heartsBottom() + pad();
+        if (hud[3] > 0) h += dp(6) + magicBarH();
+        return (int) h;
+    }
+
+    @Override
+    protected void onSizeChanged(int w, int h, int ow, int oh) {
+        super.onSizeChanged(w, h, ow, oh);
+        invalidate();
+    }
+}
