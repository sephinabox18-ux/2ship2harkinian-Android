+
+static void FinishFastTravel(PlayState* play) {
+    Player* player = GET_PLAYER(play);
+    u16 mode = play->msgCtx.ocarinaMode;
+    sFastTravelOpen = false;
+    if ((mode >= OCARINA_MODE_WARP_TO_GREAT_BAY_COAST) && (mode <= OCARINA_MODE_WARP_TO_ENTRANCE) && (player != nullptr)) {
+        Actor* actor = Actor_Spawn(&play->actorCtx, play, ACTOR_EN_TEST7, player->actor.world.pos.x,
+                                   player->actor.world.pos.y, player->actor.world.pos.z, 0, 0, 0, mode);
+        if (actor != nullptr) {
+            player->stateFlags1 &= ~PLAYER_STATE1_20000000;
+            player->csAction = PLAYER_CSACTION_NONE;
+            Player_TryCsAction(play, NULL, PLAYER_CSACTION_19);
+            player->stateFlags1 |= PLAYER_STATE1_10000000 | PLAYER_STATE1_20000000;
+            return;
+        }
+    }
+    play->msgCtx.ocarinaMode = OCARINA_MODE_NONE;
+}
