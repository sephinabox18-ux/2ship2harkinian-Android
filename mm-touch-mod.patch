+// ---------------------------------------------------------------- tap to skip cutscenes
+static bool IsChoiceOrInputBox(MessageContext* msgCtx) {
+    switch (msgCtx->textboxEndType) {
+        case TEXTBOX_ENDTYPE_TWO_CHOICE:
+        case TEXTBOX_ENDTYPE_THREE_CHOICE:
+        case TEXTBOX_ENDTYPE_12:
+        case TEXTBOX_ENDTYPE_INPUT_BANK:
+        case TEXTBOX_ENDTYPE_INPUT_DOGGY_RACETRACK_BET:
+        case TEXTBOX_ENDTYPE_INPUT_BOMBER_CODE:
+        case TEXTBOX_ENDTYPE_INPUT_LOTTERY_CODE:
+        case TEXTBOX_ENDTYPE_64:
+            return true;
+        default:
+            return false;
+    }
+}
+
+static bool InCutscene(PlayState* play) {
+    return (play->csCtx.state != CS_STATE_IDLE) || (CutsceneManager_GetCurrentCsId() != CS_ID_NONE);
+}
+
+static bool BaseSkippable(PlayState* play) {
+    if (gSaveContext.gameMode != GAMEMODE_NORMAL) return false;
+    if (IS_PAUSED(&play->pauseCtx)) return false;
+    if ((play->transitionTrigger != TRANS_TRIGGER_OFF) || (play->transitionMode != TRANS_MODE_OFF)) return false;
+    if (play->msgCtx.ocarinaMode != OCARINA_MODE_NONE) return false;
+    if ((play->msgCtx.msgMode != MSGMODE_NONE) && IsChoiceOrInputBox(&play->msgCtx)) return false;
+    return true;
+}
+
+static bool InConversation(PlayState* play) {
+    MessageContext* msgCtx = &play->msgCtx;
+    return (msgCtx->msgMode != MSGMODE_NONE) && (msgCtx->ocarinaMode == OCARINA_MODE_NONE) &&
+           !play->pauseCtx.itemDescriptionOn && !play->pauseCtx.bombersNotebookOpen;
+}
+
+// Skippable: story cutscenes and any conversation (it stops by itself at questions/answers).
+static bool CanStartSkip(PlayState* play) {
+    if (!BaseSkippable(play)) return false;
+    if (InConversation(play)) return true;
+    if (play->csCtx.state != CS_STATE_IDLE) return true;
+    return (CutsceneManager_GetCurrentCsId() != CS_ID_NONE) && (play->msgCtx.msgMode == MSGMODE_NONE);
+}
+
+static s32 sSkipBudget = 0;
+static u32 sSkipTick = 0;
+static s32 sSkipVisibleFrames = 0;
+
+// The game types text out while *drawing* the textbox (that's also where it notices the end of a box,
+// a question, etc.). Updating alone never finishes a box, which is why earlier skips only sped things up.
+// So while skipping, the textbox is also "drawn" into a scratch buffer that is thrown away.
+static Gfx sScratchGfx[0x6000];
+
+static void ProcessMessageText(PlayState* play) {
+    if (play->msgCtx.msgMode == MSGMODE_NONE) return;
+    Gfx* gfx = sScratchGfx;
+    Message_DrawMain(play, &gfx);
+    if (gfx >= sScratchGfx + 0x6000) {
+        Crumb("scratch gfx overflow"); // never expected; buffer is far bigger than one textbox
+    }
+}
+
+// Skips the whole cutscene/conversation within a frame or two: text boxes are finished and closed
+// without being shown. It stops at any question, shop menu or number entry so you can answer.
+static void RunSkip(PlayState* play) {
+    for (s32 i = 0; i < 300; i++) {
+        if (!play->state.running || !BaseSkippable(play) || !(InCutscene(play) || InConversation(play)) ||
+            (sSkipBudget-- <= 0)) {
+            sSkipping = false;
+            Crumb("skip finished");
+            return;
+        }
+        MessageContext* msgCtx = &play->msgCtx;
+        Input* input = CONTROLLER1(&play->state);
+        u16 savedPress = input->press.button;
+        u16 savedCur = input->cur.button;
+        bool inject = (msgCtx->msgMode != MSGMODE_NONE) && ((sSkipTick++ & 1) == 0);
+        if (inject) {
+            // B finishes the box being typed; A moves on to the next box / closes the last one.
+            u16 btn = (msgCtx->msgMode == MSGMODE_TEXT_DISPLAYING) ? BTN_B : (BTN_A | BTN_B);
+            input->press.button |= btn;
+            input->cur.button |= btn;
+        }
+        Play_UpdateMain(play);
+        if (inject) {
+            input->press.button = savedPress;
+            input->cur.button = savedCur;
+        }
+        ProcessMessageText(play);
+    }
+}
