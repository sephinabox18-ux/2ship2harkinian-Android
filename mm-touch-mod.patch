+
+    // Fill colours: { centre, edge }
+    static int[] fillFor(int style, boolean active, int theme) {
+        if (active) return new int[] { Color.rgb(176, 132, 52), Color.rgb(96, 64, 20) };
+        if (theme == THEME_DEFAULT) {
+            if (style == ModTouchOverlay.STYLE_A) theme = THEME_BLUE;
+            else if (style == ModTouchOverlay.STYLE_START) theme = THEME_RED;
+            else theme = THEME_GREEN;
+        }
+        switch (theme) {
+            case THEME_BLUE: return new int[] { Color.rgb(64, 118, 150), Color.rgb(18, 46, 70) };
+            case THEME_YELLOW: return new int[] { Color.rgb(196, 156, 56), Color.rgb(92, 64, 14) };
+            case THEME_RED: return new int[] { Color.rgb(150, 58, 50), Color.rgb(64, 18, 16) };
+            default: return new int[] { Color.rgb(62, 128, 98), Color.rgb(14, 52, 40) };
+        }
+    }
+
+    static int swatchColor(int theme) {
+        int[] f = fillFor(ModTouchOverlay.STYLE_PLAIN, false, theme);
+        return f[0];
+    }
+
+    static void drawGem(Canvas c, float cx, float cy, float s, Paint fill, Paint edge) {
+        Path p = new Path();
+        p.moveTo(cx, cy - s);
+        p.lineTo(cx + s * 0.75f, cy);
+        p.lineTo(cx, cy + s);
+        p.lineTo(cx - s * 0.75f, cy);
+        p.close();
+        fill.setShader(new LinearGradient(cx, cy - s, cx, cy + s, GEM_LIGHT, GEM_DARK, Shader.TileMode.CLAMP));
+        c.drawPath(p, fill);
+        c.drawPath(p, edge);
+    }
+
+    /** Round button: radial green glass, gold ring and a faint inner ring. */
+    static final class ButtonDrawable extends Drawable {
+        private final int style;
+        private final boolean active;
+        private final int theme;
+        private final Paint fill = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final Paint ring = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final Paint inner = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final Paint gloss = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final Paint gem = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final Paint gemEdge = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private int alpha = 255;
+        private final RectF oval = new RectF();
+
+        ButtonDrawable(int style, boolean active) {
+            this(style, active, THEME_DEFAULT);
+        }
+
+        ButtonDrawable(int style, boolean active, int theme) {
+            this.style = style;
+            this.active = active;
+            this.theme = theme;
+            ring.setStyle(Paint.Style.STROKE);
+            inner.setStyle(Paint.Style.STROKE);
+            gemEdge.setStyle(Paint.Style.STROKE);
+            gemEdge.setColor(GOLD_LIGHT);
+        }
+
+        @Override
+        public void draw(Canvas c) {
+            Rect b = getBounds();
+            float cx = b.exactCenterX(), cy = b.exactCenterY();
+            float r = Math.min(b.width(), b.height()) / 2f;
