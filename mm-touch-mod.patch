+/**
+ * Majora's Mask touch controls, styled after the N64 Zelda HUD.
+ * Every button (and the quest panel) can be moved, resized and hidden in Edit controls.
+ * Less-used actions live in the tray behind the "..." button. Game actions are sent to MMTouch.cpp.
+ */
+public class ModTouchOverlay {
+    // N64 button bits
+    static final int N64_A = 0x8000, N64_B = 0x4000, N64_Z = 0x2000, N64_START = 0x1000;
+    static final int N64_R = 0x0010, N64_L = 0x0020;
+    static final int N64_CUP = 0x0008, N64_CDOWN = 0x0004, N64_CLEFT = 0x0002, N64_CRIGHT = 0x0001;
+
+    // Native actions (MMTouch.cpp)
+    static final int ACT_JUMP = 1, ACT_SPRINT = 2, ACT_QUICKSAVE = 3, ACT_QUICKLOAD = 4, ACT_MAP = 5, ACT_SKIP = 6,
+            ACT_TRAIL = 7;
+    // Native state bits
+    static final int ST_CAN_SKIP = 1, ST_OCARINA = 2, ST_SHOW_QUEST = 4, ST_SPRINT = 8, ST_TRAIL = 16, ST_SKIPPING = 32;
+
+    static final int KIND_N64 = 0, KIND_ACTION = 1, KIND_TRAY = 2, KIND_SKIP = 3, KIND_PANEL = 4;
+    static final int STYLE_A = 0, STYLE_B = 1, STYLE_C = 2, STYLE_START = 3, STYLE_PLAIN = 4;
+
+    // Zelda HUD palette
+    static final int GOLD = Color.rgb(232, 196, 92);
+    static final int GOLD_SOFT = Color.argb(150, 232, 196, 92);
+    static final int PANEL_BG = Color.argb(205, 12, 10, 22);
+
+    private static final String PREFS = "com.twoshipfork.mm.touchlayout";
+    private static final long IDLE_FADE_MS = 4000;
+
+    private final MainActivity act;
+    private final SharedPreferences prefs;
+    private final Handler handler = new Handler(Looper.getMainLooper());
+
+    private FrameLayout root;
+    private View stickZone, camZone, stickBase, stickKnob;
+    private LinearLayout tray, editBar, songsPanel, songsList;
+    private TextView opacityLabel, toast, trailItem, questItem;
+    private final List<Ctl> ctls = new ArrayList<>();
+    private Ctl questCtl, skipCtl, sprintCtl;
+    private TextView questWhere, questTitle, questText;
+
+    private boolean editing = false;
+    private boolean menuMode = false; // 2 Ship settings menu open: overlay steps aside so the menu gets touches
+    private TextView closeMenuBtn;
+    private boolean controlsHidden = false;
+    private boolean questPanelOn;
+    private float opacity;
+    private long lastTouch = 0;
+
+    private int lastFrame = -1;
+    private long lastFrameChange = 0;
+    private int stateBits = 0;
+    private String lastQuest = "";
+    private String lastSongs = "";
+
+    private int stickPointer = -1, camPointer = -1;
+    // Swipe camera: camera turns with finger speed (stops when the finger stops), smoothed for high touch rates
+    private boolean swipeCamera;
+    private float camLastX, camLastY, camVx, camVy;
+    private long camLastT;
+    // Adaptive camera: learns how fast you usually swipe and scales the camera to match
+    private float typicalSwipe;   // dp per second of a normal swipe, learned over time
+    private float gesturePeak;    // fastest speed seen in the current swipe
+    private long lastCamMoveWall;
+    private float stickX0, stickY0, camX0, camY0;
+    private long lastStickDown = 0;
+
+    private class Ctl {
+        final String id, label, sub;
+        final int kind, value, style;
+        final float defX, defY, defSize;
+        float x, y, size;
+        boolean hidden, defHidden;
+        View view;
+        TextView text;
+        float dragDx, dragDy, pinchStartDist, pinchStartSize;
+
+        Ctl(String id, String label, String sub, int kind, int value, int style, float x, float y, float size) {
+            this.id = id; this.label = label; this.sub = sub; this.kind = kind; this.value = value; this.style = style;
+            this.defX = x; this.defY = y; this.defSize = size;
+        }
+    }
+
+    public ModTouchOverlay(MainActivity activity) {
+        act = activity;
+        prefs = activity.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+        opacity = prefs.getFloat("opacity", 0.85f);
+        questPanelOn = prefs.getBoolean("questPanel", true);
+        swipeCamera = prefs.getBoolean("swipeCamera", true);
+        typicalSwipe = prefs.getFloat("typicalSwipe", 900f);
+
+        ctls.add(new Ctl("a", "A", "", KIND_N64, N64_A, STYLE_A, 0.900f, 0.700f, 84));
+        ctls.add(new Ctl("attack", "B", "", KIND_N64, N64_B, STYLE_B, 0.790f, 0.840f, 78));
+        ctls.add(new Ctl("jump", "\u2191", "Jump", KIND_ACTION, ACT_JUMP, STYLE_PLAIN, 0.945f, 0.470f, 60));
+        ctls.add(new Ctl("shield", "R", "Shield", KIND_N64, N64_R, STYLE_PLAIN, 0.770f, 0.600f, 60));
+        ctls.add(new Ctl("cleft", "\u25C0", "", KIND_N64, N64_CLEFT, STYLE_C, 0.750f, 0.330f, 58));
+        ctls.add(new Ctl("cdown", "\u25BC", "", KIND_N64, N64_CDOWN, STYLE_C, 0.835f, 0.250f, 58));
+        ctls.add(new Ctl("cright", "\u25B6", "", KIND_N64, N64_CRIGHT, STYLE_C, 0.920f, 0.330f, 58));
+        ctls.add(new Ctl("target", "Z", "Target", KIND_N64, N64_Z, STYLE_PLAIN, 0.070f, 0.360f, 64));
+        sprintCtl = new Ctl("sprint", "\u00BB", "Sprint", KIND_ACTION, ACT_SPRINT, STYLE_PLAIN, 0.160f, 0.300f, 50);
+        ctls.add(sprintCtl);
+        ctls.add(new Ctl("more", "\u2022\u2022\u2022", "", KIND_TRAY, 0, STYLE_START, 0.700f, 0.075f, 44));
+        // Optional buttons: hidden until you show them in Edit controls (double-tap)
+        Ctl start = new Ctl("start", "START", "", KIND_N64, N64_START, STYLE_START, 0.640f, 0.075f, 50);
+        start.defHidden = true;
+        ctls.add(start);
+        Ctl map = new Ctl("map", "Map", "", KIND_ACTION, ACT_MAP, STYLE_PLAIN, 0.580f, 0.075f, 50);
+        map.defHidden = true;
+        ctls.add(map);
+        skipCtl = new Ctl("skip", "Skip \u25B6\u25B6", "", KIND_SKIP, ACT_SKIP, STYLE_PLAIN, 0.500f, 0.860f, 64);
+        ctls.add(skipCtl);
+        questCtl = new Ctl("quest", "", "", KIND_PANEL, 0, STYLE_PLAIN, 0.420f, 0.035f, 360);
+        ctls.add(questCtl);
+    }
+
+    // ------------------------------------------------------------------ setup
+    public void attach() {
+        View content = MainActivity.getContentView();
+        if (!(content instanceof ViewGroup)) return;
+
+        root = new FrameLayout(act);
+        root.setLayoutParams(new FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
+        root.setMotionEventSplittingEnabled(true);
+        ((ViewGroup) content).addView(root);
+
+        stickZone = new View(act);
+        camZone = new View(act);
+        root.addView(camZone, new FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
+        root.addView(stickZone, new FrameLayout.LayoutParams(0, ViewGroup.LayoutParams.MATCH_PARENT));
+        stickZone.setOnTouchListener(this::onStickTouch);
+        camZone.setOnTouchListener(this::onCamTouch);
+
+        stickBase = disc(Color.argb(40, 255, 255, 255), GOLD_SOFT, 2);
+        stickKnob = disc(Color.argb(120, 255, 255, 255), GOLD, 2);
+        root.addView(stickBase, new FrameLayout.LayoutParams(dp(STICK_RADIUS_DP * 2 + 20), dp(STICK_RADIUS_DP * 2 + 20)));
+        root.addView(stickKnob, new FrameLayout.LayoutParams(dp(56), dp(56)));
+        stickBase.setVisibility(View.GONE);
+        stickKnob.setVisibility(View.GONE);
+
+        for (Ctl c : ctls) {
+            loadCtl(c);
+            if (c.kind == KIND_PANEL) buildQuestPanel(c);
+            else buildCtl(c);
+        }
+        buildSongsPanel();
+        buildTray();
+        buildEditBar();
+        buildToast();
+        buildCloseMenuButton();
+
+        root.addOnLayoutChangeListener((v, l, t, r, b, ol, ot, orr, ob) -> layoutAll());
+        act.nativeMmSetOverlayActive(true);
+        lastTouch = System.currentTimeMillis();
+        handler.post(housekeeping);
+        handler.post(poll);
+    }
+
+    private final Runnable housekeeping = new Runnable() {
+        @Override
+        public void run() {
+            if (act.overlayView != null && act.overlayView.getVisibility() != View.GONE) {
+                act.overlayView.setVisibility(View.GONE);
+            }
+            boolean idle = !editing && System.currentTimeMillis() - lastTouch > IDLE_FADE_MS;
+            float target = controlsHidden ? 0f : (idle ? opacity * 0.3f : opacity);
+            for (Ctl c : ctls) {
+                if (c.view == null || c.kind == KIND_PANEL || c.kind == KIND_SKIP || (editing && c.hidden)) continue;
+                float t = (c.kind == KIND_TRAY) ? Math.max(target, 0.35f) : target; // keep "..." findable
+                if (Math.abs(c.view.getAlpha() - t) > 0.01f) c.view.animate().alpha(t).setDuration(250).start();
+            }
+            handler.postDelayed(this, 300);
+        }
+    };
+
+    // Reads game state from MMTouch.cpp and updates the panels.
+    private final Runnable poll = new Runnable() {
+        @Override
+        public void run() {
+            boolean menu = !act.TouchAreaEnabled;
+            if (menu != menuMode) setMenuMode(menu);
+            if (menuMode) {
+                handler.postDelayed(this, 100);
+                return;
+            }
+            long s = act.nativeMmGetState();
+            int frame = (int) (s >>> 32);
+            long now = System.currentTimeMillis();
+            if (frame != lastFrame) {
+                lastFrame = frame;
+                lastFrameChange = now;
+            }
+            // No game updates for a while (title screen, file select, loading): treat as no gameplay.
+            stateBits = (now - lastFrameChange > 600) ? 0 : (int) (s & 0xFFFF);
+
+            setSprintUi((stateBits & ST_SPRINT) != 0);
+            if (trailItem != null) trailItem.setText((stateBits & ST_TRAIL) != 0 ? "Trail: on" : "Trail: off");
+
+            boolean showSkip = editing || (((stateBits & ST_CAN_SKIP) != 0) && !controlsHidden);
+            skipCtl.view.setVisibility((showSkip && (!skipCtl.hidden || editing)) ? View.VISIBLE : View.GONE);
+
+            String q = act.nativeMmGetQuest();
+            if (q != null && !q.equals(lastQuest)) {
+                lastQuest = q;
+                String[] parts = q.split("\n", 3);
+                questWhere.setText(parts.length > 0 ? parts[0] : "");
+                questTitle.setText(parts.length > 1 ? parts[1] : "");
+                questText.setText(parts.length > 2 ? parts[2] : "");
+            }
+            boolean showQuest = editing || (questPanelOn && !questCtl.hidden && ((stateBits & ST_SHOW_QUEST) != 0)
+                    && !lastQuest.isEmpty());
+            questCtl.view.setVisibility(showQuest ? View.VISIBLE : View.GONE);
+
+            boolean showSongs = !editing && ((stateBits & ST_OCARINA) != 0);
+            if (showSongs) {
+                String songs = act.nativeMmGetSongs();
+                if (songs != null && !songs.equals(lastSongs)) {
+                    lastSongs = songs;
+                    rebuildSongs(songs);
+                }
+            }
+            songsPanel.setVisibility(showSongs ? View.VISIBLE : View.GONE);
+
+            String msg = act.nativeMmPollMessage();
+            if (msg != null && !msg.isEmpty()) showToast(msg);
+
+            handler.postDelayed(this, 100);
+        }
+    };
+
+    private void buildCloseMenuButton() {
+        closeMenuBtn = hudText(15);
+        closeMenuBtn.setTypeface(Typeface.DEFAULT_BOLD);
+        closeMenuBtn.setText("\u2715  Close menu");
+        closeMenuBtn.setPadding(dp(16), dp(10), dp(16), dp(10));
+        GradientDrawable bg = panelDrawable();
+        bg.setCornerRadius(dp(22));
+        closeMenuBtn.setBackground(bg);
+        closeMenuBtn.setVisibility(View.GONE);
+        closeMenuBtn.setOnClickListener(v -> act.nativeGamepadBackPressed());
+        FrameLayout.LayoutParams lp = new FrameLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT);
+        lp.gravity = Gravity.BOTTOM | Gravity.END;
+        lp.rightMargin = dp(20);
+        lp.bottomMargin = dp(20);
+        root.addView(closeMenuBtn, lp);
+    }
+
+    // While the 2 Ship menu is open every touch must reach the menu, so hide the controls
+    // and leave just a button to close it again.
+    private void setMenuMode(boolean on) {
+        menuMode = on;
+        if (on) {
+            if (editing) setEditing(false);
+            releaseAll();
+            stickPointer = -1;
+            camPointer = -1;
+            stickZone.setVisibility(View.GONE);
+            camZone.setVisibility(View.GONE);
+            stickBase.setVisibility(View.GONE);
+            stickKnob.setVisibility(View.GONE);
+            for (Ctl c : ctls) c.view.setVisibility(View.GONE);
+            tray.setVisibility(View.GONE);
+            songsPanel.setVisibility(View.GONE);
+            toast.setVisibility(View.GONE);
+            closeMenuBtn.setVisibility(View.VISIBLE);
+        } else {
+            closeMenuBtn.setVisibility(View.GONE);
+            stickZone.setVisibility(View.VISIBLE);
+            camZone.setVisibility(View.VISIBLE);
+            layoutAll();
+        }
+    }
+
+    private void touched() {
+        lastTouch = System.currentTimeMillis();
+    }
+
+    // ------------------------------------------------------------------ styling
+    private GradientDrawable discDrawable(int fill, int stroke, int strokeDp) {
+        GradientDrawable d = new GradientDrawable();
+        d.setShape(GradientDrawable.OVAL);
+        d.setColor(fill);
+        d.setStroke(dp(strokeDp), stroke);
+        return d;
+    }
+
+    private View disc(int fill, int stroke, int strokeDp) {
+        View v = new View(act);
+        v.setBackground(discDrawable(fill, stroke, strokeDp));
+        return v;
+    }
+
+    private GradientDrawable styleFor(int style, boolean active) {
+        switch (style) {
+            case STYLE_A: return discDrawable(Color.argb(175, 38, 92, 205), Color.rgb(150, 195, 255), 3);
+            case STYLE_B: return discDrawable(Color.argb(175, 36, 140, 64), Color.rgb(160, 230, 165), 3);
+            case STYLE_C: return discDrawable(Color.argb(175, 214, 168, 24), Color.rgb(255, 232, 130), 3);
+            case STYLE_START: return discDrawable(Color.argb(175, 178, 40, 40), Color.rgb(255, 160, 150), 2);
+            default:
+                return discDrawable(active ? Color.argb(185, 200, 140, 40) : Color.argb(150, 18, 16, 28),
+                        active ? Color.rgb(255, 220, 140) : GOLD_SOFT, 2);
+        }
+    }
+
+    private TextView hudText(float sp) {
+        TextView t = new TextView(act);
+        t.setTextColor(Color.WHITE);
+        t.setTypeface(Typeface.create("sans-serif-black", Typeface.BOLD));
+        t.setShadowLayer(5f, 0f, 2f, Color.BLACK);
+        t.setTextSize(TypedValue.COMPLEX_UNIT_SP, sp);
+        return t;
+    }
+
+    private GradientDrawable panelDrawable() {
+        GradientDrawable bg = new GradientDrawable();
+        bg.setColor(PANEL_BG);
+        bg.setCornerRadius(dp(12));
+        bg.setStroke(dp(2), GOLD_SOFT);
+        return bg;
+    }
+
+    // ------------------------------------------------------------------ building views
+    private void buildCtl(Ctl c) {
+        FrameLayout v = new FrameLayout(act);
+        if (c.kind == KIND_SKIP) {
+            GradientDrawable bg = panelDrawable();
+            bg.setCornerRadius(dp(40));
+            v.setBackground(bg);
+        } else {
+            v.setBackground(styleFor(c.style, false));
+        }
+        TextView t = hudText(14);
+        t.setGravity(Gravity.CENTER);
+        t.setText(c.sub.isEmpty() ? c.label : c.label + "\n" + c.sub);
+        v.addView(t, new FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
+        c.view = v;
+        c.text = t;
+        v.setOnTouchListener((view, e) -> onCtlTouch(c, e));
+        root.addView(v);
+    }
+
+    private void buildQuestPanel(Ctl c) {
+        LinearLayout p = new LinearLayout(act);
+        p.setOrientation(LinearLayout.VERTICAL);
+        p.setPadding(dp(14), dp(9), dp(14), dp(10));
+        p.setBackground(panelDrawable());
+        questWhere = new TextView(act);
+        questWhere.setTextColor(GOLD);
+        questWhere.setTypeface(Typeface.create(Typeface.SERIF, Typeface.BOLD));
+        questTitle = new TextView(act);
+        questTitle.setTextColor(Color.WHITE);
+        questTitle.setTypeface(Typeface.create(Typeface.SERIF, Typeface.BOLD));
+        questTitle.setShadowLayer(4f, 0f, 1.5f, Color.BLACK);
+        questText = new TextView(act);
+        questText.setTextColor(Color.argb(225, 245, 240, 225));
+        p.addView(questWhere);
+        p.addView(questTitle);
+        p.addView(questText);
+        c.view = p;
+        p.setOnTouchListener((view, e) -> editing ? onCtlEdit(c, e) : false);
+        root.addView(p);
+    }
+
+    private void buildSongsPanel() {
+        songsPanel = new LinearLayout(act);
+        songsPanel.setOrientation(LinearLayout.VERTICAL);
+        songsPanel.setPadding(dp(10), dp(8), dp(10), dp(10));
+        songsPanel.setBackground(panelDrawable());
+        TextView title = new TextView(act);
+        title.setText("Songs");
+        title.setTextColor(GOLD);
+        title.setTypeface(Typeface.create(Typeface.SERIF, Typeface.BOLD));
+        title.setTextSize(TypedValue.COMPLEX_UNIT_SP, 15);
+        title.setPadding(dp(6), 0, 0, dp(4));
+        songsPanel.addView(title);
+        songsList = new LinearLayout(act);
+        songsList.setOrientation(LinearLayout.VERTICAL);
+        songsPanel.addView(songsList);
+        TextView hint = new TextView(act);
+        hint.setText("Tap a song to play it");
+        hint.setTextColor(Color.argb(170, 255, 255, 255));
+        hint.setTextSize(TypedValue.COMPLEX_UNIT_SP, 11);
+        hint.setPadding(dp(6), dp(4), 0, 0);
+        songsPanel.addView(hint);
