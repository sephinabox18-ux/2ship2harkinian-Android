+    // Drag the editor bar out of the way by its "Move" handle
+    private float barDragDx, barDragDy;
+
+    private boolean onEditBarDrag(MotionEvent e) {
+        switch (e.getActionMasked()) {
+            case MotionEvent.ACTION_DOWN:
+                barDragDx = e.getRawX() - editBar.getX();
+                barDragDy = e.getRawY() - editBar.getY();
+                return true;
+            case MotionEvent.ACTION_MOVE: {
+                float nx = e.getRawX() - barDragDx, ny = e.getRawY() - barDragDy;
+                nx = Math.max(-editBar.getWidth() * 0.6f, Math.min(root.getWidth() - editBar.getWidth() * 0.4f, nx));
+                ny = Math.max(0, Math.min(root.getHeight() - editBar.getHeight() * 0.5f, ny));
+                editBar.setX(nx);
+                editBar.setY(ny);
+                return true;
+            }
+        }
+        return true;
+    }
