+    if (option == 1) sTouchOnlyPause = value;
+    if (option == 2) sModernHud = value;
+    if (option == 3) sInstantDoors = value;
+    if (option == 4) sFpInvertReq = value; // first-person aiming: 1 = inverted up/down
+    if (option == 5) {                    // 1 = our mini-map (the game's is hidden), 0 = the game's
+        sOurMap = value;
+        sMinimapReq = 1;
+    }
+}
