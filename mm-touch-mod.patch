+            tag.setStroke(dp(1), Color.argb(150, 198, 160, 82));
+            ammo.setBackground(tag);
+            ammo.setPadding(dp(4), 0, dp(4), 0);
+            ammo.setVisibility(View.GONE);
+            FrameLayout.LayoutParams alp = new FrameLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT);
+            alp.gravity = Gravity.BOTTOM | Gravity.CENTER_HORIZONTAL;
