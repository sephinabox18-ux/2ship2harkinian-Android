+static bool CanJump(Player* player) {
+    if (player == nullptr || gPlayState == nullptr) return false;
+    if (player->stateFlags3 & JUMP_BLOCKING_FLAGS3) return false;
+    if (!(player->actor.bgCheckFlags & BGCHECKFLAG_GROUND)) return false;
+    if (player->stateFlags1 & (PLAYER_STATE1_TALKING | PLAYER_STATE1_DEAD | PLAYER_STATE1_CARRYING_ACTOR |
+                               PLAYER_STATE1_2000 | PLAYER_STATE1_4000 | PLAYER_STATE1_100000 |
+                               PLAYER_STATE1_800000 | PLAYER_STATE1_8000000 | PLAYER_STATE1_20000000 |
+                               PLAYER_STATE1_80000000)) {
+        return false;
+    }
+    if (gPlayState->msgCtx.msgMode != MSGMODE_NONE) return false;
+    if (Player_InCsMode(gPlayState)) return false;
+    return true;
+}
