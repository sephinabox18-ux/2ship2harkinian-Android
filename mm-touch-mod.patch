+    if (want < 0) return;
+    // Hide the vanilla clock, hearts, magic and rupees (the touch overlay draws its own bar),
+    // plus the C/Start button icons that the touch buttons now show.
+    static const char* elems[] = { "Clock", "Hearts", "Magic", "Rupees", "CLeft", "CDown", "CRight", "CUp", "Start" };
+    for (const char* e : elems) {
