+    return (scene >= 0) && (scene < SCENE_COUNT_MQ) && sVisited[scene];
+}
+
+static bool HasItem(u8 item) {
+    return INV_CONTENT(item) == item;
+}
+
+static bool HasBottleWith(u8 item) {
+    s32 slot;
+    for (slot = SLOT_BOTTLE_1; slot <= SLOT_BOTTLE_6; slot++) {
+        if (gSaveContext.save.saveInfo.inventory.items[slot] == item) return true;
+    }
+    return false;
+}
+
+static s32 GetMainQuestStep(void) {
+    // ---- First cycle ----
+    if (!HasItem(ITEM_OCARINA_OF_TIME)) {
+        u8 trade = INV_CONTENT(ITEM_MOONS_TEAR);
+        if (!gSaveContext.save.saveInfo.playerData.isMagicAcquired) {
+            return Visited(0x70) ? Q_FAIRY_RETURN : Q_FAIRY_FIND;
+        }
+        if (trade == ITEM_MOONS_TEAR) return Q_TRADE_TEAR;
+        if (trade != ITEM_NONE) return Q_CLOCK_TOWER;
+        if (Visited(0x29)) return Q_MOONS_TEAR;
+        if (!CHECK_WEEKEVENTREG(WEEKEVENTREG_BOMBERS_NOTEBOOK_EVENT_LEARNED_SECRET_CODE)) return Q_BOMBERS;
+        return Q_OBSERVATORY;
+    }
+
+    // ---- Woodfall ----
+    if (!CHECK_QUEST_ITEM(QUEST_REMAINS_ODOLWA)) {
+        if (!CHECK_QUEST_ITEM(QUEST_SONG_SONATA)) {
+            if (!CHECK_WEEKEVENTREG(WEEKEVENTREG_ENTERED_SOUTHERN_SWAMP_POISONED)) return Q_SWAMP;
+            if (!CHECK_WEEKEVENTREG(WEEKEVENTREG_SAVED_KOUME)) {
+                bool foundKoume = CHECK_WEEKEVENTREG(WEEKEVENTREG_TALKED_KOUME_INJURED);
+                if (!foundKoume) {
+                    if (!CHECK_WEEKEVENTREG(WEEKEVENTREG_TALKED_KOUME_KIOSK_EMPTY) && !Visited(0x0A)) return Q_TOURIST;
+                    if (!Visited(0x0A)) return Q_POTION_SHOP;
+                    return Q_FOLLOW_MONKEY;
+                }
+                if (!CHECK_WEEKEVENTREG(WEEKEVENTREG_RECEIVED_RED_POTION_FOR_KOUME) && !HasBottleWith(ITEM_POTION_RED)) {
+                    return Q_GET_POTION;
+                }
+                return Q_HEAL_KOUME;
+            }
+            if (!CHECK_WEEKEVENTREG(WEEKEVENTREG_ENTERED_DEKU_PALACE)) return Q_BOAT;
+            return Q_SONATA;
+        }
+        if (!CHECK_WEEKEVENTREG(WEEKEVENTREG_ENTERED_WOODFALL)) return Q_WOODFALL;
+        if (!CHECK_WEEKEVENTREG(WEEKEVENTREG_ENTERED_WOODFALL_TEMPLE)) return Q_RAISE_TEMPLE;
+        return Q_WOODFALL_TEMPLE;
+    }
+    if (HasBottleWith(ITEM_DEKU_PRINCESS)) return Q_RETURN_PRINCESS;
+
+    // ---- Snowhead ----
+    if (!CHECK_QUEST_ITEM(QUEST_REMAINS_GOHT)) {
+        if (!HasItem(ITEM_MASK_GORON)) {
+            if (!Visited(0x50) && !Visited(0x5A)) return Q_MOUNTAIN_VILLAGE;
+            if (!HasItem(ITEM_LENS_OF_TRUTH)) return Q_LENS;
+            return Q_DARMANI;
+        }
+        if (!CHECK_QUEST_ITEM(QUEST_SONG_LULLABY)) {
+            if (!CHECK_QUEST_ITEM(QUEST_SONG_LULLABY_INTRO)) return Q_ELDER;
+            return Q_ELDERS_SON;
+        }
+        if (!CHECK_WEEKEVENTREG(WEEKEVENTREG_ENTERED_SNOWHEAD_TEMPLE)) return Q_GIANT_GORON;
+        return Q_SNOWHEAD_TEMPLE;
+    }
+
+    // ---- Great Bay ----
+    if (!CHECK_QUEST_ITEM(QUEST_REMAINS_GYORG)) {
+        if (!HasItem(ITEM_MASK_ZORA)) {
+            if (!CHECK_QUEST_ITEM(QUEST_SONG_EPONA)) {
+                if (!Visited(0x35)) {
+                    if (!HasItem(ITEM_POWDER_KEG) && !CHECK_WEEKEVENTREG(WEEKEVENTREG_HAS_POWDERKEG_PRIVILEGES)) {
+                        return Q_POWDER_KEG;
+                    }
+                    return Q_BOULDER;
+                }
+                return Q_EPONA;
+            }
+            if (!Visited(0x37)) return Q_GREAT_BAY;
+            return Q_MIKAU;
+        }
+        if (!CHECK_QUEST_ITEM(QUEST_SONG_BOSSA_NOVA)) {
+            if (HasBottleWith(ITEM_ZORA_EGG)) return Q_LAB_TANK;
+            if (!CHECK_WEEKEVENTREG(WEEKEVENTREG_ENTERED_ZORA_HALL)) return Q_ZORA_HALL;
+            if (!CHECK_WEEKEVENTREG(WEEKEVENTREG_ENTERED_PIRATES_FORTRESS)) return Q_FORTRESS;
+            return Q_EGGS;
+        }
+        if (!Visited(0x49)) return Q_TURTLE;
+        return Q_GREAT_BAY_TEMPLE;
+    }
+
+    // ---- Ikana ----
+    if (!CHECK_QUEST_ITEM(QUEST_REMAINS_TWINMOLD)) {
+        if (!CHECK_QUEST_ITEM(QUEST_SONG_ELEGY)) {
+            if (!HasItem(ITEM_MASK_GARO) && !CHECK_WEEKEVENTREG(WEEKEVENTREG_ENTERED_IKANA_CANYON)) return Q_GARO;
+            if (!CHECK_WEEKEVENTREG(WEEKEVENTREG_ENTERED_IKANA_CANYON)) return Q_IKANA_CANYON;
+            if (!HasItem(ITEM_MASK_GIBDO)) {
+                return CHECK_QUEST_ITEM(QUEST_SONG_STORMS) ? Q_GIBDO : Q_STORMS;
+            }
+            if (GET_CUR_EQUIP_VALUE(EQUIP_TYPE_SHIELD) != EQUIP_VALUE_SHIELD_MIRROR) return Q_MIRROR_SHIELD;
+            if (!CHECK_WEEKEVENTREG(WEEKEVENTREG_ENTERED_IKANA_CASTLE)) return Q_CASTLE;
+            return Q_IGOS;
+        }
+        if (!CHECK_WEEKEVENTREG(WEEKEVENTREG_ENTERED_STONE_TOWER)) return Q_STONE_TOWER;
+        if (!CHECK_WEEKEVENTREG(WEEKEVENTREG_ENTERED_STONE_TOWER_TEMPLE)) return Q_CLIMB_TOWER;
+        if (!HasItem(ITEM_ARROW_LIGHT)) return Q_LIGHT_ARROWS;
+        if (!CHECK_WEEKEVENTREG(WEEKEVENTREG_ENTERED_STONE_TOWER_TEMPLE_INVERTED)) return Q_INVERT_TOWER;
+        return Q_INVERTED_TEMPLE;
+    }
+
+    // ---- Finale ----
+    if (!CHECK_WEEKEVENTREG(WEEKEVENTREG_ENTERED_THE_MOON)) return Q_ROOFTOP;
+    return Q_MOON;
+}
+
+// ======================================================================
+// Routing (breadth-first search over the scene exit graph)
+// ======================================================================
+// Returns the next scene to walk into to reach `target`, `target` itself if already there, or -1 if unreachable.
+static s32 NextSceneTowards(s32 from, s32 target) {
+    static s16 prev[SCENE_COUNT_MQ];
+    static u8 queue[SCENE_COUNT_MQ];
+    s32 head = 0, tail = 0, i;
+
+    if (from == target) return target;
+    if ((from < 0) || (from >= SCENE_COUNT_MQ) || (target < 0) || (target >= SCENE_COUNT_MQ)) return -1;
+
+    for (i = 0; i < SCENE_COUNT_MQ; i++) prev[i] = -2;
+    prev[from] = -1;
+    queue[tail++] = from;
+
+    while (head < tail) {
+        s32 u = queue[head++];
+        const ExitRange* r = &gSceneExits[u];
+        for (i = 0; i < r->count; i++) {
+            s32 v = gExitPoints[r->start + i].dst;
+            if ((v < SCENE_COUNT_MQ) && (prev[v] == -2)) {
+                prev[v] = u;
+                if (v == target) {
+                    // Walk back to the first hop.
+                    while (prev[v] != from) v = prev[v];
+                    return v;
+                }
+                queue[tail++] = v;
+            }
+        }
+    }
+    return -1;
+}
+
+
+// ======================================================================
+// State
+// ======================================================================
+static s32 sCachedStep = -1;
+static s32 sCachedScene = -1;
+static bool sHaveTarget = false;
+static Vec3f sTarget;
+
+// ======================================================================
+// Target selection
+// ======================================================================
+static void UpdateTarget(PlayState* play, Player* player, s32 step) {
+    const QuestStep* q = &sSteps[step];
+    s32 cur = play->sceneId;
+    s32 i;
+
+    sHaveTarget = false;
+
+    if ((q->posScene != NONE) && (cur == q->posScene)) {
+        sTarget.x = q->posX;
+        sTarget.y = q->posY;
+        sTarget.z = q->posZ;
+        sHaveTarget = true;
+        return;
+    }
+    for (i = 0; i < 2; i++) {
+        if (q->noTrailScenes[i] == cur) return;
+    }
+    for (i = 0; i < MAX_TARGETS; i++) {
+        s32 next;
+        if (q->targets[i] == NONE) break;
+        if (q->targets[i] == cur) return; // arrived: the panel text explains what to do here
+        next = NextSceneTowards(cur, q->targets[i]);
+        if (next >= 0) {
+            // Pick the closest exit from this scene that leads to `next`.
+            const ExitRange* r = &gSceneExits[cur];
+            f32 bestDist = 1e30f;
+            s32 j;
+            for (j = 0; j < r->count; j++) {
+                const ExitPoint* e = &gExitPoints[r->start + j];
+                if (e->dst == next) {
+                    f32 dx = e->x - player->actor.world.pos.x;
+                    f32 dz = e->z - player->actor.world.pos.z;
+                    f32 d = dx * dx + dz * dz;
+                    if (d < bestDist) {
+                        bestDist = d;
+                        sTarget.x = e->x;
+                        sTarget.y = e->y;
+                        sTarget.z = e->z;
+                        sHaveTarget = true;
+                    }
+                }
+            }
+            return;
+        }
+    }
+}
+
+// ======================================================================
+// Tatl trail (sparkles along the ground)
+// ======================================================================
+#define TRAIL_SPACING 45.0f
+#define TRAIL_POINTS 14
+
+static void DrawTrail(PlayState* play, Player* player) {
+    static Color_RGBA8 prim = { 255, 255, 210, 255 };
+    static Color_RGBA8 env = { 255, 210, 70, 0 };
+    Vec3f vel = { 0.0f, 0.4f, 0.0f };
+    Vec3f accel = { 0.0f, 0.0f, 0.0f };
+    Vec3f* from = &player->actor.world.pos;
+    f32 dx = sTarget.x - from->x;
+    f32 dy = sTarget.y - from->y;
+    f32 dz = sTarget.z - from->z;
+    f32 distXZ = sqrtf(dx * dx + dz * dz);
+    s32 n, k, pass;
+
+    if (distXZ < 90.0f) return;
+
+    n = (s32)(distXZ / TRAIL_SPACING);
+    if (n > TRAIL_POINTS) n = TRAIL_POINTS;
+    if (n < 1) return;
+
+    // Two sparkles a frame, marching away from Link, so the line "flows" toward the goal.
+    for (pass = 0; pass < 2; pass++) {
+        f32 t, frac;
+        Vec3f pos;
+        CollisionPoly* poly;
+        f32 floorY;
+
+        k = ((s32)(play->gameplayFrames) + pass * (n / 2 + 1)) % n;
+        t = (k + 1) * TRAIL_SPACING;
+        frac = t / distXZ;
+
+        pos.x = from->x + dx * frac;
+        pos.z = from->z + dz * frac;
+        pos.y = from->y + dy * frac + 120.0f;
+
+        floorY = BgCheck_EntityRaycastFloor1(&play->colCtx, &poly, &pos);
+        if (floorY <= BGCHECK_Y_MIN + 1.0f) continue;
+        if (fabsf(floorY - (from->y + dy * frac)) > 300.0f) continue;
+
+        pos.y = floorY + 6.0f;
+        pos.x += Rand_CenteredFloat(8.0f);
+        pos.z += Rand_CenteredFloat(8.0f);
+        EffectSsKirakira_SpawnSmall(play, &pos, &vel, &accel, &prim, &env);
+    }
+}
+
+
+// ======================================================================
+// Public API (used by MMMod.cpp)
+// ======================================================================
+s32 MMQuest_GetStep(void) {
+    return GetMainQuestStep();
+}
+
+const char* MMQuest_Title(s32 step) {
+    return sSteps[step].title;
+}
+
+const char* MMQuest_Text(s32 step) {
+    return sSteps[step].text;
+}
+
+const char* MMQuest_Chapter(s32 step) {
+    return sChapterNames[sSteps[step].chapter];
+}
+
+void MMQuest_Progress(s32 step, s32* index, s32* count) {
+    s32 i, first = -1, n = 0;
+    for (i = 0; i < Q_COUNT; i++) {
+        if (sSteps[i].chapter == sSteps[step].chapter) {
+            if (first < 0) first = i;
+            n++;
+        }
+    }
+    *index = step - first + 1;
+    *count = n;
+}
+
+// Called once per game frame during gameplay.
+void MMQuest_Update(PlayState* play, s32 trailOn) {
+    Player* player = GET_PLAYER(play);
+    s32 step;
+
+    if (player == NULL) return;
+    if ((play->sceneId >= 0) && (play->sceneId < SCENE_COUNT_MQ)) sVisited[play->sceneId] = true;
+
+    step = GetMainQuestStep();
+    if ((step != sCachedStep) || (play->sceneId != sCachedScene) || ((play->gameplayFrames % 10) == 0)) {
+        sCachedStep = step;
+        sCachedScene = play->sceneId;
+        UpdateTarget(play, player, step);
+    }
+
+    if (trailOn && sHaveTarget && (play->msgCtx.msgMode == MSGMODE_NONE) && (play->csCtx.state == CS_STATE_IDLE) &&
+        !Player_InCsMode(play) && (play->transitionTrigger == TRANS_TRIGGER_OFF)) {
+        DrawTrail(play, player);
+    }
+}
