+#define JUMP_BLOCKING_FLAGS3 (PLAYER_STATE3_FLYING_WITH_HOOKSHOT | PLAYER_STATE3_100 /* deku flower dive */ | \
+                              PLAYER_STATE3_1000 /* goron curled */ | PLAYER_STATE3_8000 /* zora swimming */ |   \
+                              PLAYER_STATE3_200000 /* deku hopping */)
