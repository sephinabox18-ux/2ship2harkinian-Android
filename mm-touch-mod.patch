+    private void updatePausePanel() {
+        boolean paused = (stateBits & ST_PAUSED) != 0;
+        if (!paused || editing) {
+            pauseWrap.setVisibility(View.GONE);
+            currentPage = -1;
+            return;
+        }
+        int[] info = act.nativeMmGetPauseInfo();
+        if (info == null || info.length < 16 || info[0] < 0) {
+            pauseWrap.setVisibility(View.GONE); // opening/closing animation, owl map, prompts
+            return;
+        }
+        int page = info[0];
+        currentPage = page;
+        pauseWrap.setVisibility(View.VISIBLE);
+        for (int i = 0; i < 4; i++) tabs[i].setTextColor(i == page ? GOLD : Color.argb(150, 243, 233, 210));
+
+        gridContent.setVisibility((page == 0 || page == 3) ? View.VISIBLE : View.GONE);
+        mapContent.setVisibility(page == 1 ? View.VISIBLE : View.GONE);
+        questContent.setVisibility(page == 2 ? View.VISIBLE : View.GONE);
+        if (page == 1) {
+            rebuildMapPage(info);
+            return;
+        }
+        if (page == 2) {
+            rebuildQuestPage(info);
+            return;
+        }
+
+        boolean grid = (stateBits & ST_PAUSE_GRID) != 0;
+        int[] g = grid ? act.nativeMmGetPauseGrid() : null;
+        if (g == null || g.length < 26 || g[0] < 0) return; // keep showing the last grid while it settles
+        for (int i = 0; i < 24; i++) {
+            int item = g[2 + i];
+            if (item != gridShown[i] || (item != 255 && !iconCache.containsKey(item))) {
+                Bitmap bmp = iconFor(item);
+                if (item == 255) {
+                    gridIcons[i].setImageBitmap(null);
+                    gridShown[i] = item;
+                } else if (bmp != null || iconCache.containsKey(item)) {
+                    gridIcons[i].setImageBitmap(bmp);
+                    gridShown[i] = item;
+                }
+            }
+        }
+        int cursorItem = (g[1] >= 0 && g[1] < 24) ? g[2 + g[1]] : 255;
+        pauseItemName.setText(cursorItem == 255 ? "" : itemName(cursorItem));
+        if (g[1] != gridCursorShown) {
+            for (int i = 0; i < 24; i++) gridTiles[i].setBackground(tileDrawable(i == g[1]));
+            gridCursorShown = g[1];
+        }
+    }
