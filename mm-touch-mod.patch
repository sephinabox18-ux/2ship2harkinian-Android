+void func_80834DB8(Player* player, PlayerAnimationHeader* anim, f32 speed, PlayState* play);
+s32 Player_TryCsAction(PlayState* play, Player* thisx, PlayerCsAction csAction);
+s32 Player_GetMovementSpeedAndYaw(Player* thisx, f32* outSpeedTarget, s16* outYawTarget, f32 speedMode, PlayState* play);
+void Play_UpdateMain(PlayState* thisx);
+void Message_DrawMain(PlayState* play, Gfx** gfxP);
+s32 MMQuest_GetStep(void);
