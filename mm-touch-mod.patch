+    private void openWheel() {
+        if ((stateBits & ST_GAMEPLAY) == 0) return;
+        releaseAll();
+        wheel.refresh();
+        wheel.setVisibility(View.VISIBLE);
+        wheel.bringToFront();
+        // icons may still be loading the first time: refresh a few times
+        for (int i = 1; i <= 5; i++) handler.postDelayed(() -> { if (wheel.getVisibility() == View.VISIBLE) wheel.refresh(); }, 150L * i);
+    }
