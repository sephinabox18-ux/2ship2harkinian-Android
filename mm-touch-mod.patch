+    private void press(int mask) {
+        act.nativeMmSetN64Button(mask, true);
+        specialHeld |= mask;
+    }
+
+    private void stopPound() {
+        releaseSpecial();
+    }
+
+    private void releaseSpecial() {
+        handler.removeCallbacks(specialSecond);
+        for (int m : new int[] { N64_A, N64_B, N64_R, N64_Z }) {
+            if ((specialHeld & m) != 0) act.nativeMmSetN64Button(m, false);
+        }
+        specialHeld = 0;
+    }
