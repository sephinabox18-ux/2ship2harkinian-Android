+// ---------------------------------------------------------------- our own mini-map
+// A clean top-down map built from the area's floor collision: floors near Link's height are drawn into a
+// small grid (so each floor of a dungeon shows separately). Chests and stray fairies are marked.
+// In dungeons the layout only shows once you have the Map, and chests/fairies once you have the Compass.
+static std::mutex sMapMutex;
+static std::vector<uint8_t> sMapGrid;
+static std::vector<int> sMapInfo; // version, minX, minZ, cell, w, h, hasMap, hasCompass, linkX, linkZ, yaw, n, (type,x,z)...
+static int sMapVersion = 0;
+static s32 sMapScene = -1;
+static f32 sMapBandY = -100000.0f;
+static std::atomic<int> sOurMap{ 1 };
+
+static void BuildMapGrid(PlayState* play, f32 bandY, bool useBand) {
+    CollisionHeader* ch = play->colCtx.colHeader;
+    if (ch == nullptr || ch->polyList == nullptr || ch->vtxList == nullptr) return;
+    s32 minX = ch->minBounds.x, minZ = ch->minBounds.z;
+    s32 rangeX = MAX(1, ch->maxBounds.x - minX), rangeZ = MAX(1, ch->maxBounds.z - minZ);
+    s32 cell = MAX(12, MAX(rangeX, rangeZ) / 200);
+    s32 w = rangeX / cell + 1, h = rangeZ / cell + 1;
+    std::vector<uint8_t> grid((size_t)w * h, 0);
+
+    for (s32 i = 0; i < ch->numPolygons; i++) {
+        CollisionPoly* poly = &ch->polyList[i];
+        if (COLPOLY_GET_NORMAL(poly->normal.y) < 0.5f) continue; // floors only
+        Vec3s* a = &ch->vtxList[COLPOLY_VTX_INDEX(poly->vtxData[0])];
+        Vec3s* b = &ch->vtxList[COLPOLY_VTX_INDEX(poly->vtxData[1])];
+        Vec3s* c = &ch->vtxList[COLPOLY_VTX_INDEX(poly->vtxData[2])];
+        f32 y = (a->y + b->y + c->y) / 3.0f;
+        if (useBand && fabsf(y - bandY) > 140.0f) continue; // other floors of the dungeon
+        f32 ax = (a->x - minX) / (f32)cell, az = (a->z - minZ) / (f32)cell;
+        f32 bx = (b->x - minX) / (f32)cell, bz = (b->z - minZ) / (f32)cell;
+        f32 cx = (c->x - minX) / (f32)cell, cz = (c->z - minZ) / (f32)cell;
+        s32 x0 = MAX(0, (s32)floorf(fminf(ax, fminf(bx, cx)))), x1 = MIN(w - 1, (s32)ceilf(fmaxf(ax, fmaxf(bx, cx))));
+        s32 z0 = MAX(0, (s32)floorf(fminf(az, fminf(bz, cz)))), z1 = MIN(h - 1, (s32)ceilf(fmaxf(az, fmaxf(bz, cz))));
+        f32 area = (bx - ax) * (cz - az) - (bz - az) * (cx - ax);
+        if (fabsf(area) < 1e-4f) continue;
+        for (s32 gz = z0; gz <= z1; gz++) {
+            for (s32 gx = x0; gx <= x1; gx++) {
+                f32 px = gx + 0.5f, pz = gz + 0.5f;
+                f32 w0 = ((bx - px) * (cz - pz) - (bz - pz) * (cx - px)) / area;
+                f32 w1 = ((cx - px) * (az - pz) - (cz - pz) * (ax - px)) / area;
+                f32 w2 = 1.0f - w0 - w1;
+                if (w0 >= -0.15f && w1 >= -0.15f && w2 >= -0.15f) grid[(size_t)gz * w + gx] = 1;
+            }
+        }
+    }
+    std::lock_guard<std::mutex> lock(sMapMutex);
+    sMapGrid.swap(grid);
+    sMapVersion++;
+    sMapInfo.assign(12, 0);
+    sMapInfo[0] = sMapVersion;
+    sMapInfo[1] = minX;
+    sMapInfo[2] = minZ;
+    sMapInfo[3] = cell;
+    sMapInfo[4] = w;
+    sMapInfo[5] = h;
+}
+
+static void UpdateMiniMap(PlayState* play) {
+    Player* player = GET_PLAYER(play);
+    if (!sOurMap.load() || player == nullptr) return;
+    f32 y = player->actor.world.pos.y;
+    // Dungeons are split into floors by height; outdoors the whole area is drawn (hills would break bands)
+    bool banded = Map_CurRoomHasMapI(play) && (gSaveContext.dungeonSceneSharedIndex < 4);
+    if ((play->sceneId != sMapScene) || (banded && fabsf(y - sMapBandY) > 90.0f)) {
+        sMapScene = play->sceneId;
+        sMapBandY = y;
+        BuildMapGrid(play, y, banded);
+    }
+    if ((play->gameplayFrames % 3) != 0) return;
+
+    bool inDungeon = Map_CurRoomHasMapI(play) && (gSaveContext.dungeonSceneSharedIndex < 4);
+    s32 d = gSaveContext.dungeonSceneSharedIndex;
+    bool hasMap = !inDungeon || CHECK_DUNGEON_ITEM(DUNGEON_MAP, d);
+    bool hasCompass = !inDungeon || CHECK_DUNGEON_ITEM(DUNGEON_COMPASS, d);
+
+    std::vector<int> marks;
+    if (hasCompass) {
+        for (Actor* a = play->actorCtx.actorLists[ACTORCAT_CHEST].first; a != nullptr; a = a->next) {
+            if (fabsf(a->world.pos.y - y) > 200.0f) continue;
+            bool opened = Flags_GetTreasure(play, a->params & 0x1F);
+            marks.push_back(opened ? 2 : 1);
+            marks.push_back((int)a->world.pos.x);
+            marks.push_back((int)a->world.pos.z);
+        }
+        for (s32 cat = 0; cat < ACTORCAT_MAX; cat++) {
+            for (Actor* a = play->actorCtx.actorLists[cat].first; a != nullptr; a = a->next) {
+                if (a->id != ACTOR_EN_ELFORG || fabsf(a->world.pos.y - y) > 200.0f) continue;
+                marks.push_back(3);
+                marks.push_back((int)a->world.pos.x);
+                marks.push_back((int)a->world.pos.z);
+            }
+        }
+    }
+    Vec3f target;
+    if (sTrailOn && MMQuest_GetTarget(&target)) {
+        marks.push_back(4);
+        marks.push_back((int)target.x);
+        marks.push_back((int)target.z);
+    }
+    std::lock_guard<std::mutex> lock(sMapMutex);
+    if (sMapInfo.size() < 12) return;
+    sMapInfo.resize(12);
+    sMapInfo[6] = hasMap;
+    sMapInfo[7] = hasCompass;
+    sMapInfo[8] = (int)player->actor.world.pos.x;
+    sMapInfo[9] = (int)player->actor.world.pos.z;
+    sMapInfo[10] = player->actor.shape.rot.y;
+    sMapInfo[11] = (int)(marks.size() / 3);
+    sMapInfo.insert(sMapInfo.end(), marks.begin(), marks.end());
+}
+
+// ---------------------------------------------------------------- item/mask wheel: equip to a C button
+static std::atomic<int> sEquipReq{ -1 }; // (cSlot << 8) | inventory slot
+
+static void ApplyEquip(PlayState* play) {
+    int req = sEquipReq.exchange(-1);
+    if (req < 0) return;
+    int cSlot = (req >> 8) & 3, inv = req & 0xFF;
+    if (cSlot > 2 || inv >= 48) return;
+    if (IS_PAUSED(&play->pauseCtx) || Play_InCsMode(play) || (play->msgCtx.msgMode != MSGMODE_NONE)) {
+        PostMessage("Can't change items right now");
+        return;
+    }
+    u8 item = gSaveContext.save.saveInfo.inventory.items[inv];
+    if (item == ITEM_NONE) return;
+    // Magic arrows go on the C button as "bow with that arrow", like the pause menu does
+    if (item == ITEM_ARROW_FIRE) item = ITEM_BOW_FIRE;
+    else if (item == ITEM_ARROW_ICE) item = ITEM_BOW_ICE;
+    else if (item == ITEM_ARROW_LIGHT) item = ITEM_BOW_LIGHT;
+    if ((item >= ITEM_BOW_FIRE) && (item <= ITEM_BOW_LIGHT) && (INV_CONTENT(ITEM_BOW) != ITEM_BOW)) return;
+
+    s32 target = EQUIP_SLOT_C_LEFT + cSlot;
+    u8 oldItem = BUTTON_ITEM_EQUIP(0, target);
+    u8 oldSlot = C_SLOT_EQUIP(0, target);
+    // If it's already on another C button, the two swap places
+    for (s32 b = EQUIP_SLOT_C_LEFT; b <= EQUIP_SLOT_C_RIGHT; b++) {
+        if ((b != target) && (C_SLOT_EQUIP(0, b) == inv)) {
+            BUTTON_ITEM_EQUIP(0, b) = oldItem;
+            C_SLOT_EQUIP(0, b) = oldSlot;
+            if (oldItem != ITEM_NONE) Interface_LoadItemIconImpl(play, b);
+        }
+    }
+    BUTTON_ITEM_EQUIP(0, target) = item;
+    C_SLOT_EQUIP(0, target) = inv;
+    Interface_LoadItemIconImpl(play, target);
+    Audio_PlaySfx(NA_SE_SY_DECIDE);
+    Crumb("equip " + std::to_string(item) + " to C" + std::to_string(cSlot));
+}
