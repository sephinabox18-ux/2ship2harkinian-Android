+// ---------------------------------------------------------------- instant area transitions
+// Called from Play_UpdateTransition: plain fades become instant cuts (cutscene transitions are left alone).
+static std::atomic<int> sInstantDoors{ 1 };
+
+extern "C" void MMMod_AdjustTransition(PlayState* play) {
+    if (!sInstantDoors.load()) return;
+    if (play->transitionMode != TRANS_MODE_SETUP) return;
+    switch (play->transitionType) {
+        case TRANS_TYPE_FADE_BLACK:
+        case TRANS_TYPE_FADE_WHITE:
+        case TRANS_TYPE_FADE_BLACK_FAST:
+        case TRANS_TYPE_FADE_WHITE_FAST:
+        case TRANS_TYPE_FADE_BLACK_SLOW:
+        case TRANS_TYPE_FADE_WHITE_SLOW:
+        case TRANS_TYPE_FADE_DYNAMIC:
+            break;
+        default:
+            return;
+    }
+    if (gSaveContext.gameMode != GAMEMODE_NORMAL) return;
+    if (play->csCtx.state != CS_STATE_IDLE) return;
+    if (gSaveContext.nextCutsceneIndex >= 0xFFF0) return;
+    play->transitionType = TRANS_TYPE_INSTANT;
+}
