+    private void updateActionAndForm() {
+        int[] a = act.nativeMmGetAction();
+        if (a == null || a.length < 2) return;
+        if (a[1] != form) {
+            form = a[1];
+            releaseSpecial();
+            if (poundCtl.iconView instanceof Ornate.IconView) ((Ornate.IconView) poundCtl.iconView).setIcon(specialIcon(form));
+            layoutAll(); // mask special button appears/disappears
+        }
+        if (aCtl == null || aCtl.iconView == null || (a[0] == lastAction && lastAsize == aCtl.size)) return;
+        lastAsize = aCtl.size;
+        lastAction = a[0];
+        String label = actionLabel(a[0]);
+        if (label == null) {
+            aCtl.text.setVisibility(View.GONE);
+            aCtl.iconView.setVisibility(View.VISIBLE);
+        } else {
+            aCtl.text.setText(label);
+            float k = label.length() <= 4 ? 0.15f : (label.length() <= 6 ? 0.125f : 0.105f);
+            aCtl.text.setTextSize(TypedValue.COMPLEX_UNIT_PX, dp(aCtl.size) * k);
+            aCtl.text.setVisibility(View.VISIBLE);
