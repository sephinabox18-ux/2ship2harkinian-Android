+void RegisterMMTouch() {
+    static bool hookRegistered = false;
+    if (!hookRegistered) {
+        hookRegistered = true;
+        GameInteractor::Instance->RegisterGameHook<GameInteractor::OnPassPlayerInputs>(OnPlayerInputs);
+        GameInteractor::Instance->RegisterGameHook<GameInteractor::OnGameStateUpdate>(OnGameStateUpdate);
+        ReadSnapshotFile();
+    }
+    ApplyPresetOnce();
+}
